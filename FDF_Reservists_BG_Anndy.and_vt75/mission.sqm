							side="Empty";
							flags=4;
							class Attributes
							{
								init="private _PGS_Runtime = { " \n "private _pgsCompositionHost = if (isNil ""this"") then {objNull} else {this};" \n "private _pgsStoredHost = missionNamespace getVariable [""PGS_CompositionHostObject"", objNull];" \n "if (!isNull _pgsCompositionHost) then {" \n "    missionNamespace setVariable [""PGS_CompositionHostObject"", _pgsCompositionHost];" \n "    if (local _pgsCompositionHost) then {" \n "        _pgsCompositionHost allowDamage false;" \n "    };" \n "    _pgsCompositionHost setVariable [""PGS_CompositionSeed"", true, true];" \n "} else {" \n "    if (isNull _pgsStoredHost) then {" \n "        missionNamespace setVariable [""PGS_CompositionHostObject"", objNull];" \n "    };" \n "};" \n "" \n "PGS_Version = ""1.5.0"";" \n "" \n "private _pgsRuntimeKey = missionNamespace getVariable [""PGS_RuntimeKeyLocal"", []];" \n "private _pgsRuntimeVersion = _pgsRuntimeKey param [0, """"];" \n "private _pgsRuntimeHost = _pgsRuntimeKey param [1, objNull];" \n "private _pgsDuplicateRuntime = (_pgsRuntimeVersion == PGS_Version) && {" \n "    isNull _pgsCompositionHost || {_pgsRuntimeHost == _pgsCompositionHost}" \n "};" \n "if (_pgsDuplicateRuntime) exitWith {};" \n "missionNamespace setVariable [""PGS_RuntimeKeyLocal"", [PGS_Version, _pgsCompositionHost]]; " \n " " \n "PGS_Games = [" \n "    [" \n "        ""battleship""," \n "        ""Battleship""," \n "        [" \n "            ""Deploy a hidden fleet, call coordinates and trade shots.""," \n "            ""Find and sink all five opposing ships before yours disappear.""" \n "        ]," \n "        2," \n "        2," \n "        [" \n "            ""Playable: private 10x10 fleets, placement previews and rotation.""," \n "            ""Alternating shots, misses, hits, sunk ships and safe spectators.""" \n "        ]" \n "    ]," \n "    [" \n "        ""whoswho""," \n "        ""Who's Who: Vehicles""," \n "        [" \n "            ""Ask questions aloud and eliminate vehicle suspects.""," \n "            