reServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_checkersFinishForfeitServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_rpsFinishForfeitServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_blackjackHandleDepartureServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_chessFinishForfeitServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_pokerHandleDepartureServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_unoHandleDepartureServer;" \n "        private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "        if (_seatIndex < 0 || {_seatIndex >= PGS_CFG_SEAT_COUNT} || {(_seats param [_seatIndex, objNull]) != _unit}) then {" \n "            _seatIndex = _seats find _unit;" \n "        };" \n "        if (_seatIndex >= 0 && {_seatIndex < PGS_CFG_SEAT_COUNT}) then {" \n "            private _votes = [(_table getVariable [""PGS_TableVotes"", []])] call PGS_fnc_normalizeVotes;" \n "            _seats set [_seatIndex, objNull];" \n "            _votes set [_seatIndex, """"];" \n "            _table setVariable [""PGS_TableSeats"", _seats, true];" \n "            _table setVariable [""PGS_TableVotes"", _votes, true];" \n "            _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "            [_table] call PGS_fnc_refreshTableConsensusServer;" \n "        };" \n "    };" \n "    [_unit] call PGS_fnc_clearUnitSeatVariablesServer;" \n "};" \n "" \n "PGS_fnc_initializePlayerServer = {" \n "    params [[""_unit"", objNull]];" \n "    if (!isServer || {isNull _unit}) exitWith {};" \n "    if (_unit getVariable [""PGS_ServerInitialized"", false]) exitWith {};" \n "    if (isNil {_unit getVariable ""PGS_SeatedTable""}) then {" \n "        _unit setVariable [""PGS_SeatedTable"", objNull, true];" \n "    };" \n "    if (isNil {_unit getVariable ""PGS_SeatIndex""}) then {" \n "        _unit setVariable [""PGS_SeatIndex"", -1, true];" \n "    };" \