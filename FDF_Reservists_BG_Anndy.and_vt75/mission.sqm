    _table setVariable [""PGS_UNOSeatIndices"", [], true];" \n "    _table setVariable [""PGS_UNOHandsServer"", []];" \n "    _table setVariable [""PGS_UNODeckServer"", []];" \n "    _table setVariable [""PGS_UNODiscardServer"", []];" \n "    _table setVariable [""PGS_UNOHandVersionsServer"", []];" \n "    _table setVariable [""PGS_UNOJustDrawnIdsServer"", []];" \n "    private _snapshot = call PGS_fnc_unoCreateEmptySnapshot;" \n "    _table setVariable [""PGS_UNOSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_UNOSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_unoPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_unoStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""uno"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _seatIndices = [];" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_index, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _seatIndices pushBack _index;" \n "        };" \n "    };" \n "    private _playerCount = count _players;" \n "    if (_playerCount < 2 || {_playerCount > 4}) exitWith {false};" \n "" \n "    [_table] call PGS_fnc_unoClearPrivateHandsServer;" \n "    private _deck = call PGS_fnc_unoCreateShuffledDeckServer;" \n "    private _hands = [];" \n "    private _names = [];" \n "    private _statuses = [];" \n "    private _actions = [];" \n "    private _activeFlags = [];" \n "    private _versions = [];" \n "    private _justDrawn = [];" \n "    private _armed = [];" \n "    for ""_role"" from 0 to (_playerCount - 1) do {" \n "        _hands pushBack [];" \n "        _names pushBack (name (_players param [_role, objNull]));" \n "        _statuses pushBack ""ACTIVE"";" \n "        _actions pushBack ""Ready"";" \n "        _activeFlags pushBack true;" \n "        _versions pushBack 1;" \n "        _justDrawn pushBack -1;" \n "        _armed pushBack false;" \n "    };" \n "    for ""_round"" from 1 to PGS_CFG_UNO_STARTING_CARDS do {" \n "        for ""_role"" from 0 to (_playerCount - 1) do {" \n "            private _hand = +(_hands param [_role, []]);" \n "            _hand pushBack (_deck deleteAt ((count _deck) - 1));" \n "            _hands set [_role, _hand];" \n "        };" \n "    };" \n "" \n "    private _deferredWilds = [];" \n "    private _topCard = [];" \n "    while {(count _deck) > 0 && {(count _topCard) <= 0}} do {" \n "        private _candidate = _deck deleteAt ((count _deck) - 1);" \n "        if ((_candidate param [2, -1]) in [14, 15]) then {" \n "            _deferredWilds pushBack _candidate;" \n "        } else {" \n "            _topCard = _candidate;" \n "        };" \n "    };" \n "    _deck append _deferredWilds;" \n "    _deck = [_deck] call PGS_fnc_unoShuffleCardsServer;" \n "    if ((count _topCard) <= 0) exitWith {false};" \n "" \n "    private _dealer = floor (random _playerCount);" \n "    private _direction = 1;" \n "    private _turn = [_dealer, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "    private _pendingKind = -1;" \n "    private _pendingAmount = 0;" \n "    private _topKind = _topCard param [2, -1];" \n "    private _status = format [" \n "        ""%1 begins in ascending player order. %2 is on the discard pile.""," \n "        _names param [_turn, ""Player""]," \n "        [_topCard] call PGS_fnc_unoCardName" \n "    ];" \n "    if (_topKind == 11) then {" \n "        private _skipped = _turn;" \n "        _turn = [_turn, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "        _status = format [""Opening Block skips %1. %2 begins."", _names param [_skipped, ""Player""], _names param [_turn, ""Player""]];" \n "    };" \n "    if (_topKind == 12) then {" \n "        _direction = -1;" \n "        _turn = _dealer;" \n "        _status = format [""Opening Reverse starts descending player order. %1 begins."", _names param [_turn, ""Player""]];" \n "    };" \n "    if (_topKind == 13) then {" \n "        _pendingKind = 13;" \n "        _pendingAmount = 2;" \n "        _status = format [""Opening +2 targets %1. Stack another +2 or draw two."", _names param [_turn, ""Player""]];" \n "    };" \n "" \n "    _table setVariable [""PGS_UNOActive"", true, true];" \n "    _table setVariable [""PGS_UNOFinished"", false, true];" \n "    _table setVariable [" \n "        ""PGS_UNOGameId""," \n "        format [""PGS_UNO_%1_%2"", floor (serverTime * 10), floor (random 1000000)]," \n "        true" \n "    ];" \n "    _table setVariable [""PGS_UNOPlayers"", _players, true];" \n "    _table setVariable [""PGS_UNOPlayerNames"", _names, true];" \n "    _table setVariable [""PGS_UNOSeatIndices"", _seatIndices, true];" \n "    _table setVariable [""PGS_UNOHandsServer"", _hands];" \n "    _table setVariable [""PGS_UNODeckServer"", _deck];" \n "    _table setVariable [""PGS_UNODiscardServer"", [_topCard]];" \n "    _table setVariable [""PGS_UNOHandVersionsServer"", _versions];" \n "    _table setVariable [""PGS_UNOJustDrawnIdsServer"", _justDrawn];" \n "    private _snapshot = [" \n "        ""PLAYING"", _dealer, _turn, _direction, _topCard, _topCard param [1, 0]," \n "        count _deck, [], _statuses, _pendingKind, _pendingAmount, -1," \n "        _actions, -1, -1, _status, _versions, _armed, 0, 0" \n "    ];" \n "    _snapshot = [_table, _snapshot] call PGS_fnc_unoRefreshSnapshotCountsServer;" \n "    _table setVariable [""PGS_UNOSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_UNOSnapshot"", _snapshot, true];" \n "    _table setVariable [""PGS_TableSelectedGame"", ""uno"", true];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table] call PGS_fnc_unoPublishRevisionServer;" \n "    [_table, [0, 1, 2, 3]] call PGS_fnc_unoSendPrivateHandsServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_unoFinishServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]," \n "        [""_winnerRole"", -1]," \n "        [""_status"", ""UNO finished.""]," \n "        [""_changedRoles"", []]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _state = +_snapshot;" \n "    private _statuses = +(_state param [8, []]);" \n "    if (_winnerRole >= 0 && {_winnerRole < (count _statuses)}) then {" \n "        _statuses set [_winnerRole, ""WINNER""];" \n "    };" \n "    _state set [0, ""FINISHED""];" \n "    _state set [2, -1];" \n "    _state set [8, _statuses];" \n "    _state set [9, -1];" \n "    _state set [10, 0];" \n "    _state set [11, -1];" \n "    _state set [13, -1];" \n "    _state set [14, _winnerRole];" \n "    _state set [15, _status];" \n "    _table setVariable [""PGS_UNOFinished"", true, true];" \n "    _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "    [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "    [_table, _changedRoles] call PGS_fnc_unoSendPrivateHandsServer;" \n "};" \n "" \n "PGS_fnc_unoHandleDepartureServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_departing"", objNull]," \n "        [""_seatIndex"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_UNOActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_UNOPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_UNOSeatIndices"", []];" \n "    private _role = if (isNull _departing) then {" \n "        _seatIndices find _seatIndex" \n "    } else {" \n "        _players find _departing" \n "    };" \n "    if (_role < 0) then {_role = _seatIndices find _seatIndex;};" \n "    if (_role < 0) exitWith {};" \n "    private _state = +(_table getVariable [""PGS_UNOSnapshotServer"", []]);" \n "    private _matchWasFinished = (_state param [0, ""IDLE""]) == ""FINISHED"";" \n "    private _activeFlags = +(_state param [8, []]);" \n "    private _statuses = +_activeFlags;" \n "    for ""_index"" from 0 to ((count _activeFlags) - 1) do {" \n "        _activeFlags set [_index, (_statuses param [_index, ""LEFT""]) != ""LEFT""];" \n "    };" \n "    if (!(_activeFlags param [_role, false])) exitWith {};" \n "" \n "    private _hands = +(_table getVariable [""PGS_UNOHandsServer"", []]);" \n "    private _deck = +(_table getVariable [""PGS_UNODeckServer"", []]);" \n "    _deck append +(_hands param [_role, []]);" \n "    _deck = [_deck] call PGS_fnc_unoShuffleCardsServer;" \n "    _hands set [_role, []];" \n "    _table setVariable [""PGS_UNOHandsServer"", _hands];" \n "    _table setVariable [""PGS_UNODeckServer"", _deck];" \n "    [_table, _role] call PGS_fnc_unoBumpHandVersionServer;" \n "    if (!isNull _departing) then {" \n "        _departing setVariable [""PGS_UNOPrivateHand"", [], owner _departing];" \n "    };" \n "" \n "    _statuses set [_role, ""LEFT""];" \n "    _activeFlags set [_role, false];" \n "    private _actions = +(_state param [12, []]);" \n "    _actions set [_role, ""Left table""];" \n "    private _armed = +(_state param [17, []]);" \n "    _armed set [_role, false];" \n "    private _turn = _state param [2, -1];" \n "    private _direction = _state param [3, 1];" \n "    if ((_state param [13, -1]) == _role) then {_state set [13, -1];};" \n "    if ((_state param [11, -1]) == _role) then {_state set [11, -1];};" \n "    if (_turn == _role) then {" \n "        _state set [9, -1];" \n "        _state set [10, 0];" \n "        _turn = [_role, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "        _state set [2, _turn];" \n "    };" \n "    _state set [8, _statuses];" \n "    _state set [12, _actions];" \n "    _state set [17, _armed];" \n "    if (!_matchWasFinished) then {" \n "        _state set [15, format [""%1 left the UNO table."", if (isNull _departing) then {""A player""} else {name _departing}]];" \n "    };" \n "    private _remaining = [_activeFlags] call PGS_fnc_unoCountActiveRoles;" \n "    if (_remaining <= 0) exitWith {" \n "        [_table] call PGS_fnc_unoClearServer;" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "    };" \n "    if (_remaining == 1 && {!_matchWasFinished}) exitWith {" \n "        private _winner = _activeFlags find true;" \n "        private _names = _table getVariable [""PGS_UNOPlayerNames"", []];" \n "        [_table, _state, _winner, format [""%1 wins UNO by forfeit."", _names param [_winner, ""Player""]], []] call PGS_fnc_unoFinishServer;" \n "    };" \n "    [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "};" \n "" \n "PGS_fnc_unoReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_UNOActive"", false])}) exitWith {};" \n "    private _players = +(_table getVariable [""PGS_UNOPlayers"", []]);" \n "    private _seatIndices = _table getVariable [""PGS_UNOSeatIndices"", []];" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    for ""_role"" from 0 to ((count _players) - 1) do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seat = _seatIndices param [_role, -1];" \n "        private _valid = !isNull _unit" \n "            && {_seat >= 0}" \n "            && {_seat < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seat, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""}" \n "            && {(vehicle _unit) == _unit};" \n "        if (!_valid) then {" \n "            [_table, _unit, _seat] call PGS_fnc_unoHandleDepartureServer;" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_unoResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_unoClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "};" \n "" \n "PGS_fnc_refreshTableConsensusServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _votes = [(_table getVariable [""PGS_TableVotes"", []])] call PGS_fnc_normalizeVotes;" \n "    private _ready = [(_table getVariable [""PGS_TableReady"", []])] call PGS_fnc_normalizeReady;" \n "    private _occupancy = [false, false, false, false];" \n "    private _occupied = 0;" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        if (!isNull (_seats param [_index, objNull])) then {" \n "            _occupancy set [_index, true];" \n "            _occupied = _occupied + 1;" \n "        };" \n "    };" \n "" \n "    private _bestGameId = """";" \n "    private _bestVotes = 0;" \n "    {" \n "        private _gameId = _x param [0, """"];" \n "        private _minimum = _x param [3, 2];" \n "        private _maximum = _x param [4, 4];" \n "        if (_occupied >= _minimum && {_occupied <= _maximum}) then {" \n "            private _voteCount = 0;" \n "            for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "                if ((_occupancy param [_index, false]) && {(_votes param [_index, """"]) == _gameId}) then {" \n "                    _voteCount = _voteCount + 1;" \n "                };" \n "            };" \n "            if (_voteCount > _bestVotes) then {" \n "                _bestVotes = _voteCount;" \n "                _bestGameId = _gameId;" \n "            };" \n "        };" \n "    } forEach PGS_Games;" \n "" \n "    private _requiredVotes = if (_occupied > 0) then {" \n "        floor (_occupied / 2) + 1" \n "    } else {" \n "        1" \n "    };" \n "    private _selectedGame = """";" \n "    if (_bestVotes >= _requiredVotes) then {" \n "        _selectedGame = _bestGameId;" \n "    };" \n "" \n "    private _selectedCatalogEntry = [_selectedGame] call PGS_fnc_getGame;" \n "    private _selectedMinimum = _selectedCatalogEntry param [3, 2];" \n "    private _allReady = _selectedGame != """" && {_occupied >= _selectedMinimum};" \n "    if (_allReady) then {" \n "        for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "            if (!isNull (_seats param [_index, objNull])) then {" \n "                if (!(_ready param [_index, false])) then {" \n "                    _allReady = false;" \n "                };" \n "            };" \n "        };" \n "    };" \n "" \n "    private _phase = if (_allReady) then {""READY""} else {""LOBBY""};" \n "    if (_table getVariable [""PGS_WhosWhoActive"", false]) then {" \n "        _selectedGame = ""whoswho"";" \n "        _phase = _table getVariable [""PGS_TablePhase"", ""PLAYING""];" \n "        if (!(_phase in [""PLAYING"", ""FINISHED""])) then {" \n "            _phase = ""PLAYING"";" \n "        };" \n "    };" \n "    if (_table getVariable [""PGS_ShotgunActive"", false]) then {" \n "        _selectedGame = ""shotgun"";" \n "        _phase = _table getVariable [""PGS_TablePhase"", ""PLAYING""];" \n "        if (!(_phase in [""PLAYING"", ""FINISHED""])) then {" \n "            _phase = ""PLAYING"";" \n "        };" \n "    };" \n "    if (_table getVariable [""PGS_CheckersActive"", false]) then {" \n "        _selectedGame = ""checkers"";" \n "        _phase = _ta