" \n "                        _state set [19, _pending];" \n "                    } else {" \n "                        private _names = _table getVariable [""PGS_PokerPlayerNames"", []];" \n "                        _state set [5, _only];" \n "                        _state set [16, format [""%1 must answer the all-in wager."", _names param [_only, ""Player""]]];" \n "                        [_table, _state] call PGS_fnc_pokerSetSnapshotServer;" \n "                        _settled = true;" \n "                    };" \n "                } else {" \n "                    private _turn = _state param [5, -1];" \n "                    if (!(_turn in _pendingRoles)) then {" \n "                        private _flags = [];" \n "                        for ""_role"" from 0 to ((count _statuses) - 1) do {" \n "                            _flags pushBack (_role in _pendingRoles);" \n "                        };" \n "                        _turn = [_turn, _flags] call PGS_fnc_pokerGetNextIndex;" \n "                    };" \n "                    private _names = _table getVariable [""PGS_PokerPlayerNames"", []];" \n "                    _state set [5, _turn];" \n "                    _state set [16, format [""%1 to act on the %2."", _names param [_turn, ""Player""], _state param [0, ""street""]]];" \n "                    [_table, _state] call PGS_fnc_pokerSetSnapshotServer;" \n "                    _settled = true;" \n "                };" \n "            } else {" \n "                if ((_state param [0, ""RIVER""]) == ""RIVER"") then {" \n "                    [_table, _state] call PGS_fnc_pokerResolveShowdownServer;" \n "                    _settled = true;" \n "                } else {" \n "                    _state = [_table, _state] call PGS_fnc_pokerAdvanceStreetServer;" \n "                };" \n "            };" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_pokerStartHandServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    private _previous = _table getVariable [""PGS_PokerSnapshotServer"", []];" \n "    private _chips = +(_previous param [6, []]);" \n "    private _players = _table getVariable [""PGS_PokerPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_PokerSeatIndices"", []];" \n "    private _tableSeats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _count = count _players;" \n "    private _eligible = [];" \n "    private _statuses = [];" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seatIndex = _seatIndices param [_role, -1];" \n "        private _present = !isNull _unit" \n "            && {_seatIndex >= 0}" \n "            && {(_tableSeats param [_seatIndex, objNull]) == _unit};" \n "        private _canPlay = _present && {(_chips param [_role, 0]) > 0};" \n "        _eligible pushBack _canPlay;" \n "        _statuses pushBack (if (!_present) then {""LEFT""} else {if (_canPlay) then {""ACTIVE""} else {""BUSTED""}});" \n "    };" \n "    private _survivors = {_x} count _eligible;" \n "    if (_survivors < 2) exitWith {false};" \n "" \n "    private _previousDealer = _previous param [2, -1];" \n "    private _previousBigBlind = _previous param [4, -1];" \n "    private _dealer = [_previousDealer, _eligible] call PGS_fnc_pokerGetNextIndex;" \n "    private _smallBlind = if (_survivors == 2) then {_dealer} else {[_dealer, _eligible] call PGS_fnc_pokerGetNextIndex};" \n "    private _bigBlind = [_smallBlind, _eligible] call PGS_fnc_pokerGetNextIndex; " \n " " \n "    if (" \n "        _survivors == 2" \n "        && {_bigBlind == _previousBigBlind}" \n "        && {_eligible param [_previousBigBlind, false]}" \n "    ) then {" \n "        _dealer = _previousBigBlind;" \n "        _smallBlind = _dealer;" \n "        _bigBlind = [_smallBlind, _eligible] call PGS_fnc_pokerGetNextIndex;" \n "    };" \n "    private _handNumber = (_previous param [1, 0]) + 1;" \n "    private _deck = call PGS_fnc_pokerCreateShuffledDeckServer;" \n "    private _hands = [];" \n "    private _bets = [];" \n "    private _contributions = [];" \n "    private _actions = [];" \n "    private _revealed = [];" \n "    private _ready = [];" \n "    private _pending = [];" \n "    private _lastActed = [];" \n "    private _choices = [];" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        _hands pushBack [];" \n "        _bets pushBack 0;" \n "        _contributions pushBack 0;" \n "        _actions pushBack (if (_eligible param [_role, false]) then {""Dealt in""} else {_statuses param [_role, ""BUSTED""]});" \n "        _revealed pushBack [];" \n "        _ready pushBack false;" \n "        _pending pushBack (_eligible param [_role, false]);" \n "        _lastActed pushBack -1;" \n "        _choices pushBack -1;" \n "    };" \n "    private _dealCursor = _dealer;" \n "    for ""_pass"" from 1 to 2 do {" \n "        for ""_dealt"" from 1 to _survivors do {" \n "            _dealCursor = [_dealCursor, _eligible] call PGS_fnc_pokerGetNextIndex;" \n "            private _hand = +(_hands param [_dealCursor, []]);" \n "            _hand pushBack (_deck deleteAt 0);" \n "            _hands set [_dealCursor, _hand];" \n "        };" \n "    };" \n "    private _postBlind = {" \n "        params [""_role"", ""_blind"", ""_label""];" \n "        private _posted = (_chips param [_role, 0]) min _blind;" \n "        _chips set [_role, (_chips param [_role, 0]) - _posted];" \n "        _bets set [_role, _posted];" \n "        _contributions set [_role, _posted];" \n "        _actions set [_role, format [""%1 %2"", _label, _posted]];" \n "        if ((_chips param [_role, 0]) <= 0) then {" \n "            _statuses set [_role, ""ALL_IN""];" \n "            _pending set [_role, false];" \n "            _actions set [_role, format [""%1 %2 - ALL IN"", _label, _posted]];" \n "        };" \n "    };" \n "    [_smallBlind, PGS_CFG_POKER_SMALL_BLIND, ""Small blind""] call _postBlind;" \n "    [_bigBlind, PGS_CFG_POKER_BIG_BLIND, ""Big blind""] call _postBlind;" \n "    private _pot = 0;" \n "    {_pot = _pot + _x;} forEach _contributions;" \n "    private _firstActor = [_bigBlind, _pending] call PGS_fnc_pokerGetNextIndex;" \n "    private _state = [" \n "        ""PREFLOP"", _handNumber, _dealer, _smallBlind, _bigBlind, _firstActor," \n "        _chips, _bets, _contributions, _statuses, _actions, [], _pot," \n "        PGS_CFG_POKER_BIG_BLIND, PGS_CFG_POKER_BIG_BLIND, []," \n "        ""Hole cards dealt. Action begins left of the big blind.""," \n "        _revealed, _ready, _pending, _lastActed, [], true, _choices" \n "    ];" \n "    _table setVariable [""PGS_PokerDeckServer"", _deck];" \n "    _table setVariable [""PGS_PokerHandsServer"", _hands];" \n "    _table setVariable [""PGS_PokerSnapshotServer"", _state];" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        [_table, _role] call PGS_fnc_pokerSendPrivateHandServer;" \n "    };" \n "    [_table, _state] call PGS_fnc_pokerProgressServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_pokerStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""poker"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _names = [];" \n "    private _seatIndices = [];" \n "    for ""_seat"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_seat, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _names pushBack (name _unit);" \n "            _seatIndices pushBack _seat;" \n "        };" \n "    };" \n "    private _count = count _players;" \n "    if (_count < 2 || {_count > 4}) exitWith {false};" \n "    private _chips = [];" \n "    for ""_role"" from 0 to (_count - 1) do {_chips pushBack PGS_CFG_POKER_STARTING_CHIPS;};" \n "    private _snapshot = [_count, _chips] call PGS_fnc_pokerCreateEmptySnapshot;" \n "    _snapshot set [0, ""DEALING""];" \n "    _table setVariable [""PGS_PokerActive"", true, true];" \n "    _table setVariable [""PGS_PokerFinished"", false, true];" \n "    _table setVariable [" \n "        ""PGS_PokerGameId""," \n "        format [""PGS_POKER_%1_%2"", floor (serverTime * 10), floor (random 1000000)]," \n "        true" \n "    ];" \n "    _table setVariable [""PGS_PokerPlayers"", _players, true];" \n "    _table setVariable [""PGS_PokerPlayerNames"", _names, true];" \n "    _table setVariable [""PGS_PokerSeatIndices"", _seatIndices, true];" \n "    _table setVariable [""PGS_PokerSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table] call PGS_fnc_pokerStartHandServer" \n "};" \n "" \n "PGS_fnc_pokerHandleDepartureServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_unit"", objNull]," \n "        [""_seatIndex"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_PokerActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_PokerPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_PokerSeatIndices"", []];" \n "    private _role = if (isNull _unit) then {-1} else {_players find _unit};" \n "    if (_role < 0 && {_seatIndex >= 0}) then {_role = _seatIndices find _seatIndex;};" \n "    if (_role < 0) exitWith {};" \n "    private _state = +(_table getVariable [""PGS_PokerSnapshotServer"", []]);" \n "    private _statuses = +(_state param [9, []]);" \n "    if ((_statuses param [_role, ""LEFT""]) == ""LEFT"") exitWith {};" \n "    private _chips = +(_state param [6, []]);" \n "    private _pending = +(_state param [19, []]);" \n "    private _actions = +(_state param [10, []]);" \n "    private _names = _table getVariable [""PGS_PokerPlayerNames"", []];" \n "    _chips set [_role, 0];" \n "    _statuses set [_role, ""LEFT""];" \n "    _pending set [_role, false];" \n "    _actions set [_role, ""Left table - folded""];" \n "    _state set [6, _chips];" \n "    _state set [9, _statuses];" \n "    _state set [10, _actions];" \n "    _state set [19, _pending];" \n "    _state set [16, format [""%1 left Poker and forfeited the remaining stack."", _names param [_role, ""Player""]]];" \n "    if (!isNull (_players param [_role, objNull])) then {" \n "        private _departing = _players param [_role, objNull];" \n "        _departing setVariable [""PGS_PokerPrivateHand"", [], owner _departing];" \n "    };" \n "    private _present = 0;" \n "    {if (_x != ""LEFT"") then {_present = _present + 1;};} forEach _statuses;" \n "    if (_present <= 0) exitWith {" \n "        [_table] call PGS_fnc_pokerClearServer;" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "    };" \n "    if ((_state param [0, ""HAND_END""]) in [""PREFLOP"", ""FLOP"", ""TURN"", ""RIVER""]) then {" \n "        [_table, _state] call PGS_fnc_pokerProgressServer;" \n "    } else {" \n "        if (([_state] call PGS_fnc_pokerCountSurvivorsServer) <= 1) then {" \n "            [_table, _state] call PGS_fnc_pokerCompleteHandServer;" \n "        } else {" \n "            private _ready = _state param [18, []];" \n "            private _allReady = (_state param [0, """"]) == ""HAND_END"";" \n "            for ""_other"" from 0 to ((count _chips) - 1) do {" \n "                if (" \n "                    (_chips param [_other, 0]) > 0" \n "                    && {(_statuses param [_other, ""LEFT""]) != ""LEFT""}" \n "                    && {!(_ready param [_other, false])}" \n "                ) then {" \n "                    _allReady = false;" \n "                };" \n "            };" \n "            if (_allReady) then {" \n "                _table setVariable [""PGS_PokerSnapshotServer"", _state];" \n "                [_table] call PGS_fnc_pokerStartHandServer;" \n "            } else {" \n "                [_table, _state] call PGS_fnc_pokerSetSnapshotServer;" \n "            };" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_pokerReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_PokerActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_PokerPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_PokerSeatIndices"", []];" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    for ""_role"" from 0 to ((count _players) - 1) do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seat = _seatIndices param [_role, -1];" \n "        private _valid = !isNull _unit" \n "            && {_seat >= 0}" \n "            && {_seat < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seat, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""}" \n "            && {(vehicle _unit) == _unit};" \n "        if (!_valid) then {" \n "            [_table, _unit, _seat] call PGS_fnc_pokerHandleDepartureServer;" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_pokerResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_pokerClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "}; " \n " " \n "PGS_fnc_battleshipCreateEmptySnapshot = {" \n "    [" \n "        ""IDLE"", -1, [false, false], [[], []], [5, 5], [[], []], -1," \n "        ""Waiting for a Battleship match."", [-1, -1, -1, """", -1]," \n "        [""Waiting"", ""Waiting""], 0, [0, 0], [[], []]" \n "    ]" \n "};" \n "" \n "PGS_fnc_battleshipPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_BattleshipRevision"", (_table getVariable [""PGS_BattleshipRevision"", 0]) + 1, true];" \n "    _table setVariable [""PGS_TableRevision"", (_table getVariable [""PGS_TableRevision"", 0]) + 1, true];" \n "};" \n "" \n "PGS_fnc_battleshipSetSnapshotServer = {" \n "    params [[""_table"", objNull], [""_snapshot"", []]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_BattleshipSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_BattleshipSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_battleshipPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_battleshipSendPrivateFleetServer = {" \n "    params [[""_table"", objNull], [""_role"", -1]];" \n "    if (!isServer || {isNull _table} || {_role < 0} || {_role > 1}) exitWith {};" \n "    private _players = _table getVariable [""PGS_BattleshipPlayers"", []];" \n "    private _unit = _players param [_role, objNull];" \n "    if (isNull _unit) exitWith {};" \n "    private _fleets = _table getVariable [""PGS_BattleshipFleetsServer"", []];" \n "    private _fleet = [(_fleets param [_role, []])] call PGS_fnc_battleshipCopyFleet;" \n "    private _snapshot = _table getVariable [""PGS_BattleshipSnapshotServer"", []];" \n "    private _versions = _snapshot param [11, [0, 0]];" \n "    _unit setVariable [" \n "        ""PGS_BattleshipPrivateFleet""," \n "        [_table getVariable [""PGS_BattleshipGameId"", """"], _versions param [_role, -1], _fleet]," \n "        owner _unit" \n "    ];" \n "};" \n "" \n "PGS_fnc_battleshipClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    {" \n "        if (!isNull _x) then {_x setVariable [""PGS_BattleshipPrivateFleet"", [], owner _x];};" \n "    } forEach (_table getVariable [""PGS_BattleshipPlayers"", []]);" \n "    _table setVariable [""PGS_BattleshipActive"", false, true];" \n "    _table setVariable [""PGS_BattleshipFinished"", false, true];" \n "    _table setVariable [""PGS_BattleshipGameId"", """", true];" \n "    _table setVariable [""PGS_BattleshipPlayers"", [], true];" \n "    _table setVariable [""PGS_BattleshipPlayerNames"", [], true];" \n "    _table setVariable [""PGS_BattleshipSeatIndices"", [], true];" \n "    _table setVariable [""PGS_BattleshipFleetsServer"", []];" \n "    _table setVariable [""PGS_BattleshipRevision"", 0, true];" \n "    private _empty = call PGS_fnc_battleshipCreateEmptySnapshot;" \n "    _table setVariable [""PGS_BattleshipSnapshotServer"", _empty];" \n "    _table setVariable [""PGS_BattleshipSnapshot"", _empty, true];" \n "    [_table] call PGS_fnc_battleshipPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_battleshipStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""battleship"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _names = [];" \n "    private _seatIndices = [];" \n "    for ""_seat"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_seat, obj