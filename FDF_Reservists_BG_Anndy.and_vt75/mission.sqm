         && {(_statuses param [_other, ""LEFT""]) != ""LEFT""}" \n "                    && {!(_ready param [_other, false])}" \n "                ) then {" \n "                    _allReady = false;" \n "                };" \n "            };" \n "            if (_allReady) then {" \n "                _table setVariable [""PGS_PokerSnapshotServer"", _state];" \n "                [_table] call PGS_fnc_pokerStartHandServer;" \n "            } else {" \n "                [_table, _state] call PGS_fnc_pokerSetSnapshotServer;" \n "            };" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_pokerReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_PokerActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_PokerPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_PokerSeatIndices"", []];" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    for ""_role"" from 0 to ((count _players) - 1) do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seat = _seatIndices param [_role, -1];" \n "        private _valid = !isNull _unit" \n "            && {_seat >= 0}" \n "            && {_seat < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seat, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""}" \n "            && {(vehicle _unit) == _unit};" \n "        if (!_valid) then {" \n "            [_table, _unit, _seat] call PGS_fnc_pokerHandleDepartureServer;" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_pokerResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_pokerClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "}; " \n " " \n "PGS_fnc_battleshipCreateEmptySnapshot = {" \n "    [" \n "        ""IDLE"", -1, [false, false], [[], []], [5, 5], [[], []], -1," \n "        ""Waiting for a Battleship match."", [-1, -1, -1, """", -1]," \n "        [""Waiting"", ""Waiting""], 0, [0, 0], [[], []]" \n "    ]" \n "};" \n "" \n "PGS_fnc_battleshipPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_BattleshipRevision"", (_table getVariable [""PGS_BattleshipRevision"", 0]) + 1, true];" \n "    _table setVariable [""PGS_TableRevision"", (_table getVariable [""PGS_TableRevision"", 0]) + 1, true];" \n "};" \n "" \n "PGS_fnc_battleshipSetSnapshotServer = {" \n "    params [[""_table"", objNull], [""_snapshot"", []]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_BattleshipSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_BattleshipSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_battleshipPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_battleshipSendPrivateFleetServer = {" \n "    params [[""_table"", objNull], [""_role"", -1]];" \n "    if (!isServer || {isNull _table} || {_role < 0} || {_role > 1}) exitWith {};" \n "    private _players = _table getVariable [""PGS_BattleshipPlayers"", []];" \n "    private _unit = _players param [_role, objNull];" \n "    if (isNull _unit) exitWith {};" \n "    private _fleets = _table getVariable [""PGS_BattleshipFleetsServer"", []];" \n "    private _fleet = [(_fleets param [_role, []])] call PGS_fnc_battleshipCopyFleet;" \n "    private _snapshot = _table getVariable [""PGS_BattleshipSnapshotServer"", []];" \n "    private _versions = _snapshot param [11, [0, 0]];" \n "    _unit setVariable [" \n "        ""PGS_BattleshipPrivateFleet""," \n "        [_table getVariable [""PGS_BattleshipGameId"", """"], _versions param [_role, -1], _fleet]," \n "        owner _unit" \n "    ];" \n "};" \n "" \n "PGS_fnc_battleshipClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    {" \n "        if (!isNull _x) then {_x setVariable [""PGS_BattleshipPrivateFleet"", [], owner _x];};" \n "    } forEach (_table getVariable [""PGS_BattleshipPlayers"", []]);" \n "    _table setVariable [""PGS_BattleshipActive"", false, true];" \n "    _table setVariable [""PGS_BattleshipFinished"", false, true];" \n "    _table setVariable [""PGS_BattleshipGameId"", """", true];" \n "    _table setVariable [""PGS_BattleshipPlayers"", [], true];" \n "    _table setVariable [""PGS_BattleshipPlayerNames"", [], true];" \n "    _table setVariable [""PGS_BattleshipSeatIndices"", [], true];" \n "    _table setVariable [""PGS_BattleshipFleetsServer"", []];" \n "    _table setVariable [""PGS_BattleshipRevision"", 0, true];" \n "    private _empty = call PGS_fnc_battleshipCreateEmptySnapshot;" \n "    _table setVariable [""PGS_BattleshipSnapshotServer"", _empty];" \n "    _table setVariable [""PGS_BattleshipSnapshot"", _empty, true];" \n "    [_table] call PGS_fnc_battleshipPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_battleshipStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""battleship"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _names = [];" \n "    private _seatIndices = [];" \n "    for ""_seat"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_seat, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _names pushBack (name _unit);" \n "            _seatIndices pushBack _seat;" \n "        };" \n "    };" \n "    if ((count _players) != 2) exitWith {false};" \n "    private _snapshot = [" \n "        ""PLACEMENT"", -1, [false, false], [[], []], [5, 5], [[], []], -1," \n "        ""Both commanders are deploying five private ships."", [-1, -1, -1, """", -1]," \n "        [""Deploying fleet"", ""Deploying fleet""], 0, [0, 0], [[], []]" \n "    ];" \n "    _table setVariable [""PGS_BattleshipActive"", true, true];" \n "    _table setVariable [""PGS_BattleshipFinished"", false, true];" \n "    _table setVariable [""PGS_BattleshipGameId"", format [""PGS_BATTLESHIP_%1_%2"", floor (serverTime * 10), floor (random 1000000)], true];" \n "    _table setVariable [""PGS_BattleshipPlayers"", _players, true];" \n "    _table setVariable [""PGS_BattleshipPlayerNames"", _names, true];" \n "    _table setVariable [""PGS_BattleshipSeatIndices"", _seatIndices, true];" \n "    _table setVariable [""PGS_BattleshipFleetsServer"", [call PGS_fnc_battleshipCreateEmptyFleet, call PGS_fnc_battleshipCreateEmptyFleet]];" \n "    _table setVariable [""PGS_BattleshipRevision"", 0, true];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table, _snapshot] call PGS_fnc_battleshipSetSnapshotServer;" \n "    [_table, 0] call PGS_fnc_battleshipSendPrivateFleetServer;" \n "    [_table, 1] call PGS_fnc_battleshipSendPrivateFleetServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_battleshipFinishServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]," \n "        [""_winner"", -1]," \n "        [""_message"", ""Battleship is finished.""]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _state = +_snapshot;" \n "    _state set [0, ""FINISHED""];" \n "    _state set [1, -1];" \n "    _state set [6, _winner];" \n "    _state set [7, _message];" \n "    _state set [12, [(_table getVariable [""PGS_BattleshipFleetsServer"", []])] call PGS_fnc_battleshipCopyFleets];" \n "    _table setVariable [""PGS_BattleshipFinished"", true, true];" \n "    _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "    [_table, _state] call PGS_fnc_battleshipSetSnapshotServer;" \n "};" \n "" \n "PGS_fnc_battleshipResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_battleshipClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "};" \n "" \n "PGS_fnc_battleshipHandleDepartureServer = {" \n "    params [[""_table"", objNull], [""_unit"", objNull], [""_seatIndex"", -1]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_BattleshipActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_BattleshipPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_BattleshipSeatIndices"", []];" \n "    private _role = if (isNull _unit) then {-1} else {_players find _unit};" \n "    if (_role < 0 && {_seatIndex >= 0}) then {_role = _seatIndices find _seatIndex;};" \n "    if (_role < 0) exitWith {};" \n "    private _other = 1 - _role;" \n "    private _state = +(_table getVariable [""PGS_BattleshipSnapshotServer"", []]);" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _otherSeat = _seatIndices param [_other, -1];" \n "    private _otherUnit = _players param [_other, objNull];" \n "    private _otherValid = !isNull _otherUnit" \n "        && {_otherSeat >= 0}" \n "        && {_otherSeat < PGS_CFG_SEAT_COUNT}" \n "        && {(_seats param [_otherSeat, objNull]) == _otherUnit}" \n "        && {_otherUnit in allPlayers}" \n "        && {alive _otherUnit}" \n "        && {(lifeState _otherUnit) != ""INCAPACITATED""};" \n "    if (!_otherValid) exitWith {" \n "        [_table] call PGS_fnc_battleshipClearServer;" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "        [_table] call PGS_fnc_refreshTableConsensusServer;" \n "    };" \n "    if ((_state param [0, """"]) == ""FINISHED"") exitWith {};" \n "    private _names = _table getVariable [""PGS_BattleshipPlayerNames"", []];" \n "    [_table, _state, _other, format [""%1 wins by forfeit after %2 leaves the table."", _names param [_other, ""Player""], _names param [_role, ""Player""]]] call PGS_fnc_battleshipFinishServer;" \n "};" \n "" \n "PGS_fnc_battleshipReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_BattleshipActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_BattleshipPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_BattleshipSeatIndices"", []];" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    for ""_role"" from 0 to 1 do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seat = _seatIndices param [_role, -1];" \n "        private _valid = !isNull _unit" \n "            && {_seat >= 0}" \n "            && {_seat < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seat, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""}" \n "            && {(vehicle _unit) == _unit};" \n "        if (!_valid) then {" \n "            [_table, _unit, _seat] call PGS_fnc_battleshipHandleDepartureServer;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_whosWhoFriendlyName = {" \n "    params [[""_displayName"", ""Vehicle""]];" \n "    private _lower = toLower _displayName;" \n "    private _friendly = """";" \n "    {" \n "        if (_friendly == """" && {(_lower find (_x param [0, """"])) >= 0}) then {" \n "            _friendly = _x param [1, ""Vehicle""];" \n "        };" \n "    } forEach [" \n "        [""blackfish"", ""Blackfish""], [""blackfoot"", ""Blackfoot""]," \n "        [""ghost hawk"", ""Ghost Hawk""], [""hummingbird"", ""Hummingbird""]," \n "        [""pawnee"", ""Pawnee""], [""huron"", ""Huron""], [""wipeout"", ""Wipeout""]," \n "        [""greyhawk"", ""Greyhawk""], [""sentinel"", ""Sentinel""]," \n "        [""panther"", ""Panther""], [""marshall"", ""Marshall""]," \n "        [""slammer"", ""Slammer""], [""cheetah"", ""Cheetah""]," \n "        [""bobcat"", ""Bobcat""], [""scorcher"", ""Scorcher""]," \n "        [""sandstorm"", ""Sandstorm""], [""hunter"", ""Hunter""]," \n "        [""rhino"", ""Rhino""], [""prowler"", ""Prowler""]," \n "        [""stomper"", ""Stomper""], [""darter"", ""Darter""]," \n "        [""pelican"", ""Pelican""], [""falcon"", ""Falcon""]," \n "        [""kajman"", ""Kajman""], [""varsuk"", ""Varsuk""]," \n "        [""marid"", ""Marid""], [""kamysh"", ""Kamysh""], [""tigris"", ""Tigris""]," \n "        [""ifrit"", ""Ifrit""], [""tempest"", ""Tempest""], [""qilin"", ""Qilin""]," \n "        [""xi'an"", ""Xi'an""], [""xian"", ""Xi'an""], [""orca"", ""Orca""]," \n "        [""taru"", ""Taru""], [""neophron"", ""Neophron""], [""shikra"", ""Shikra""]," \n "        [""ababil"", ""Ababil""], [""saif"", ""Saif""]," \n "        [""gorgon"", ""Gorgon""], [""strider"", ""Strider""], [""mora"", ""Mora""]," \n "        [""kuma"", ""Kuma""], [""nyx"", ""Nyx""], [""buzzard"", ""Buzzard""]," \n "        [""hellcat"", ""Hellcat""], [""mohawk"", ""Mohawk""], [""zamak"", ""Zamak""]," \n "        [""caesar"", ""Caesar""], [""m-900"", ""M-900""], [""m900"", ""M-900""]," \n "        [""water scooter"", ""Water Scooter""], [""rescue boat"", ""Rescue Boat""]," \n "        [""speedboat"", ""Speedboat""], [""motorboat"", ""Motorboat""]," \n "        [""assault boat"", ""Assault Boat""], [""submersible"", ""SDV""]," \n "        [""sdv"", ""SDV""], [""quad bike"", ""Quad Bike""], [""quadbike"", ""Quad Bike""]," \n "        [""hatchback"", ""Hatchback""], [""offroad"", ""Offroad""]," \n "        [""sport hatch"", ""Hatchback Sport""], [""suv"", ""SUV""]," \n "        [""minivan"", ""Van""], [""van"", ""Van""], [""kart"", ""Kart""]," \n "        [""tractor"", ""Tractor""], [""truck"", ""Truck""]" \n "    ];" \n "    if (_friendly == """") then {" \n "        private _parts = _displayName splitString ""("";" \n "        _friendly = _parts param [0, _displayName];" \n "    };" \n "    _friendly" \n "};" \n "" \n "PGS_fnc_whosWhoBuildCatalogServer = {" \n "    if (!isServer) exitWith {[]};" \n "    private _cached = missionNamespace getVariable [""PGS_WhosWhoCatalogServer"", []];" \n "    if ((count _cached) == 4) exitWith {_cached};" \n "    private _groups = [[], [], [], []];" \n "    private _keys = [[], [], [], []];" \n "    private _root = configFile >> ""CfgVehicles"";" \n "    for ""_index"" from 0 to ((count _root) - 1) do {" \n "        private _entry = _root select _index;" \n "        if (isClass _entry && {(getNumber (_entry >> ""scope"")) == 2}) then {" \n "            private _className = configName _entry;" \n "            private _preview = getText (_entry >> ""editorPreview"");" \n "            private _displayName = getText (_entry >> ""displayName"");" \n "            private _faction = toLower (getText (_entry >> ""faction""));" \n "            private _group = -1;" \n "            if (_faction in [""blu_f"", ""blu_t_f"", ""blu_w_f"", ""blu_ctrg_f""]) then {_group = 0;};" \n "            if (_faction in [""opf_f"", ""opf_t_f"", ""opf_r_f""]) then {_group = 1;};" \n "            if (_faction == ""ind_f"") then {_group = 2;};" \n "            if (_faction in [""civ_f"", ""civ_idap_f""]) then {_group = 3;};" \n "            private _vehicleKind = (_className isKindOf ""LandVehicle"")" \n "                || {_className isKindOf ""Air""}" \n "                || {_className isKindOf ""Ship""}" \n "                || {_className isKindOf ""Submarine""};" \n "            private _excluded = (_className isKindOf ""Man"") || {_className isKindOf ""StaticWeapon""};" \n "            if (_group >= 0 && {_preview != """"} && {_displayName != """"} && {_vehicleKind} && {!_excluded}) then {" \n "                private _friendly = [_displayName] call PGS_fnc_whosWhoFriendlyName;" \n "                private _key = toLower _friendly;" \n "                private _groupKeys = _keys param [_group, []];" \n "                if (!(_key in _groupKeys)) then {" \n "                    _groupKeys pushBack _key;" \n "                    _keys set [_group, _groupKeys];" \n "                    private _groupEntries = _groups param [_group, []];" \n "                    _groupEntries pushBack [_className, _friendly, _preview];" \n "                    _groups set [_group, _groupEntries];" \n "                };" \n "            };" \n "        };" \n "    };" \n "    missionNamespace setVariable [""PGS_WhosWhoCatalogServer"", _groups];" \n "    _groups" \n "};" \n "" \n "PGS_fnc_whosWhoShuffleServer = {" \n "    params [[""_source"", []]];" \n "    private _pool = +_source;" \n "    private _result = [];" \n "    while {(count _pool) > 0} do {" \n "        _result pushBack (_pool deleteAt (floor (random (count _pool))));" \n "    };" \n "    _result" \n "};" \n "" \n "PGS_fnc_whosWhoCreateBoardServer = {" \n "    if (!isServer) exitWith {[]};" \n "    private _catalog = call PGS_fnc_whosWhoBuildCatalogServer;" \n "    if ((count _catalog) != 4) exitWith {[]};" \n "    private _rowOrder = [[0, 1, 2, 3]] call PGS_fnc_whosWhoShuffleServer;" \n "    private _board = [];" \n "    {" \n "        private _available = _catalog param [_x, []];" \n "        if ((count _available) < PGS_CFG_WHOSWHO_PER_FACTION) exitWith {" \n "            _board = [];" \n "        };" \n "        private _shuffled = [_available] call PGS_fnc_whosWhoShuffleServer;" \n "        private _row = [];" \n "        for ""_column"" from 0 to (PGS_CFG_WHOSWHO_PER_FACTION - 1) do {" \n "            _row pushBack (+(_shuffled param [_column, []]));" \n "        };" \n "        _board pushBack _row;" \n "    } forEach _rowOrder;" \n "    _board" \n "};" \n "" \n "PGS_fnc_whosWhoCreateEmptySnapshot = {" \n "    [""IDLE"", -1, [""Waiting"", ""Waiting""], -1, ""Waiting for Who's Who: Vehicles."", -1, -1, false, [], 0]" \n "};" \n "" \n "PGS_fnc_whosWhoPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_WhosWhoRevision"", (_table getVariable [""PGS_WhosWhoRevision"", 0]) + 1, true];" \n "    _table setVariable [""PGS_TableRevision"", (_table getVariable [""PGS_TableRevision"", 0]) + 1, true];" \n "};" \n "" \n "PGS_fnc_whosWhoSetSnapshotServer = {" \n "    params [[""_table"", objNull], [""_snapshot"", []]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_WhosWhoSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_WhosWhoSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_whosWhoPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_whosWhoSendPrivateTargetServer = {" \n "    params [[""_table"", objNull], [""_role"", -1]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _players = _table getVariable [""PGS_WhosWhoPlayers"", []];" \n "    private _targets = _table getVariable [""PGS_WhosWhoTargetsServer"", []];" \n "    private _unit = _players param [_role, objNull];" \n "    if (!isNull _unit && {_role >= 0} && {_role < (count _targets)}) then {" \n "        _unit setVariable [" \n "            ""PGS_WhosWhoPrivateTarget""," \n "            [_table getVariable [""PGS_WhosWhoGameId"", """"], _targets param [_role, -1]]," \n "            owner _unit" \n "        ];" \n "    };" \n "};" \n "" \n "PGS_fnc_whosWhoClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    {" \n "        if (!isNull _x) then {_x setVariable [""PGS_WhosWhoPrivateTarget"", [], owner _x];};" \n "    } forEach (_table getVariable [""PGS_WhosWhoPlayers"", []]);" \n "    _table setVariable [""PGS_WhosWhoActive"", false, true];" \n "    _table setVariable [""PGS_WhosWhoFinished"", false, true];" \n "    _table setVariable [""PGS_WhosWhoGameId"", """", true];" \n "    _table setVariable [""PGS_WhosWhoPlayers"", [], true];" \n "    _table setVariable [""PGS_WhosWhoPlayerNames"", [], true];" \n "    _table setVariable [""PGS_WhosWhoSeatIndices"", [], true];" \n "    _table setVariable [""PGS_WhosWhoBoard"", [], true];" \n "    _table setVariable [""PGS_WhosWhoTargetsServer"", []];" \n "    _table setVariable [""PGS_WhosWhoRevision"", 0, true];" \n "    private _empty = call PGS_fnc_whosWhoCreateEmptySnapshot;" \n "    _table setVariable [""PGS_WhosWhoSnapshotServer"", _empty];" \n "    _table setVariable [""PGS_WhosWhoSnapshot"", _empty, true];" \n "    [_table] call PGS_fnc_whosWhoPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_whosWhoStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""whoswho"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _names = [];" \n "    private _seatIndices = [];" \n "    for ""_seat"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_seat, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _names pushBack (name _unit);" \n "            _seatIndices pushBack _seat;" \n "        };" \n "    };" \n "    if ((count _players) != 2) exitWith {false};" \n "    private _board = call PGS_fnc_whosWhoCreateBoardServer;" \n "    if ((count _board) != 4) exitWith {false};" \n "    private _total = PGS_CFG_WHOSWHO_PER_FACTION * 4;" \n "    private _firstTarget = floor (random _total);" \n "    private _secondTarget = floor (random (_total - 1));" \n "    if (_secondTarget >= _firstTarget) then {_secondTarget = _secondTarget + 1;};" \n "    private _actor = floor (random 2);" \n "    private _snapshot = [" \n "        ""PLAYING"", _actor, [""Asking questions"", ""Asking questions""], -1," \n "        format [""%1 asks the first yes-or-no question."", _names param [_actor, ""Player""]]," \n "        -1, -1, false, [], 0" \n "    ];" \n "    _table setVariable [""PGS_WhosWhoActive"", true, true];" \n "    _table setVariable [""PGS_WhosWhoFinished"", false, true];" \n "    _table setVariable [""PGS_WhosWhoGameId"", format [""PGS_WHOSWHO_%1_%2"", floor (serverTime * 10), floor (random 1000000)], true];" \n "    _table setVariable [""PGS_WhosWhoPlayers"", _players, true];" \n "    _table setVariable [""PGS_WhosWhoPlayerNames"", _names, true];" \n "    _table setVariable [""PGS_WhosWhoSeatIndices"", _seatIndices, true];" \n "    _table setVariable [""PGS_WhosWhoBoard"", _board, true];" \n "    _table setVariable [""PGS_WhosWhoTargetsServer"", [_firstTarget, _secondTarget]];" \n "    _table setVariable [""PGS_WhosWhoRevision"", 0, true];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table, _snapshot] call PGS_fnc_whosWhoSetSnapshotServer;" \n "    [_table, 0] call PGS_fnc_whosWhoSendPrivateTargetServer;" \n "    [_table, 1] call PGS_fnc_whosWhoSendPrivateTargetServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_whosWhoFinishServer = {" \n "    params [[""_table"", objNull], [""_snapshot"", []], [""_winner"", -1], [""_message"", ""Who's Who is finished.""]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _state = +_snapshot;" \n "    _state set [0, ""FINISHED""];" \n "    _state set [1, -1];" \n "    _state set [3, _winner];" \n "    _state set [4, _message];" \n "    _state set [8, +(_table getVariable [""PGS_WhosWhoTargetsServer"", []])];" \n "    _table setVariable [""PGS_WhosWhoFinished"", true, true];" \n "    _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "    [_table, _state] call PGS_fnc_whosWhoSetSnapshotServer;" \n "};" \n "" \n "PGS_fnc_whosWhoResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_whosWhoClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "};" \n "" \n "PGS_fnc_whosWhoHandleDepartureServer = {" \n "    params [[""_table"", objNull], [""_unit"", objNull], [""_seatIndex"", -1]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_WhosWhoActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_WhosWhoPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_WhosWhoSeatIndices"", []];" \n "    private _role = if (isNull _unit) then {-1} else {_players find _unit};" \n "    if (_role < 0 && {_seatIndex >= 0}) then {_role = _seatIndices find _seatIndex;};" \n "    if (_role < 0) exitWith {};" \n "    private _other = 1 - _role;" \n "    private _state = +(_table getVariable [""PGS_WhosWhoSnapshotServer"", []]);" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _otherSeat = _seatIndices param [_other, -1];" \n "    private _otherUnit = _players param [_other, objNull];" \n "    private _otherValid = !isNull _otherUnit" \n "        && {_otherSeat >= 0}" \n "        && {_otherSeat < PGS_CFG_SEAT_COUNT}" \n "        && {(_seats param [_otherSeat, objNull]) == _otherUnit}" \n "        && {_otherUnit in allPlayers}" \n "        && {alive _otherUnit}" \n "        && {(lifeState _otherUnit) != ""INCAPACITATED""};" \n "    if (!_otherValid) exitWith {" \n "        [_table] call PGS_fnc_whosWhoClearServer;" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "        [_table] call PGS_fnc_refreshTableConsensusServer;" \n "    };" \n "    if ((_state param [0, """"]) == ""FINISHED"") exitWith {};" \n "    private _names = _table getVariable [""PGS_WhosWhoPlayerNames"", []];" \n "    [_table, _state, _other, format [""%1 wins after %2 leaves the table."", _names param [_other, ""Player""], _names param [_role, ""Player""]]] call PGS_fnc_whosWhoFinishServer;" \n "};" \n "" \n "PGS_fnc_whosWhoReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_WhosWhoActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_WhosWhoPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_WhosWhoSeatIndices"", []];" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    for ""_role"" from 0 to 1 do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seat = _seatIndices param [_role, -1];" \n "        private _valid = !isNull _unit" \n "            && {_seat >= 0}" \n "            && {_seat < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seat, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""}" \n "            && {(vehicle _unit) == _unit};" \n "        if (!_valid) then {" \n "            [_table, _unit, _seat] call PGS_fnc_whosWhoHandleDepartureServer;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_shotgunItemLabel = {" \n "    params [[""_itemId"", """"]];" \n "    switch (_itemId) do {" \n "        case ""BLADE"": {""Serrated Blade""};" \n "        case ""BEER"": {""Beer""};" \n "        case ""CIGAR"": {""Cigar""};" \n "        case ""SPYGLASS"": {""Spyglass""};" \n "        case ""CUFFS"": {""Handcuffs""};" \n "        case ""INVERTER"": {""Inverter""};" \n "        default {""Unknown Item""};" \n "    }" \n "};" \n "" \n "PGS_fnc_shotgunCreateEmptySnapshot = {" \n "    params [[""_count"", 0]];" \n "    private _lives = [];" \n "    private _alive = [];" \n "    private _inventories = [];" \n "    private _cuffs = [];" \n "    private _blades = [];" \n "    private _actions = [];" \n "    if (_count > 0) then {" \n "        for ""_role"" from 0 to (_count - 1) do {" \n "            _lives pushBack PGS_CFG_SHOTGUN_STARTING_LIVES;" \n "            _alive pushBack true;" \n "            _inventories pushBack [];" \n "            _cuffs pushBack false;" \n "            _blades pushBack false;" \n "            _actions pushBack ""Waiting for the first load"";" \n "        };" \n "    };" \n "    [" \n "        ""IDLE"", 0, -1, _lives, _alive, _inventories, _cuffs, _blades," \n "        0, 0, 0, true, -1, -1, -1, _actions, -1," \n "        ""Waiting for Shotgun Roulette."", 0, 0" \n "    ]" \n "};" \n "" \n "PGS_fnc_shotgunPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [" \n "        ""PGS_ShotgunRevision""," \n "        (_table getVariable [""PGS_ShotgunRevision"", 0]) + 1," \n "        true" \n "    ];" \n "    _table setVariable [" \n "        ""PGS_TableRevision""," \n "        (_table getVariable [""PGS_TableRevision"", 0]) + 1," \n "        true" \n "    ];" \n "};" \n "" \n "PGS_fnc_shotgunSetSnapshotServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]" \n "    ];" \n "    if (!isServer || {isNull _table} || {(typeName _snapshot) != ""ARRAY""}) exitWith {};" \n "    _table setVariable [""PGS_ShotgunSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_ShotgunSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_shotgunPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_shotgunClearPrivatePeeksServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    {" \n "        if (!isNull _x) then {" \n "            _x setVariable [""PGS_ShotgunPrivatePeek"", [], owner _x];" \n "        };" \n "    } forEach (_table getVariable [""PGS_ShotgunPlayers"", []]);" \n "};" \n "" \n "PGS_fnc_shotgunClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_shotgunClearPrivatePeeksServer;" \n "    _table setVariable [""PGS_ShotgunActive"", false, true];" \n "    _table setVariable [""PGS_ShotgunFinished"", false, true];" \n "    _table setVariable [""PGS_ShotgunGameId"", """", true];" \n "    _table setVariable [""PGS_ShotgunPlayers"", [], true];" \n "    _table setVariable [""PGS_ShotgunPlayerNames"", [], true];" \n "    _table setVariable [""PGS_ShotgunSeatIndices"", [], true];" \n "    _table setVariable [""PGS_ShotgunRevision"", 0, true];" \n "    _table setVariable [""PGS_ShotgunChamberServer"", []];" \n "    _table setVariable [""PGS_ShotgunPendingActorServer"", -1];" \n "    _table setVariable [""PGS_ShotgunPendingReloadServer"", false];" \n "    private _empty = [] call PGS_fnc_shotgunCreateEmptySnapshot;" \n "    _table setVariable [""PGS_ShotgunSnapshotServer"", _empty];" \n "    _table setVariable [""PGS_ShotgunSnapshot"", _empty, true];" \n "    [_table] call PGS_fnc_shotgunPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_shotgunGetNextAliveRole = {" \n "    params [" \n "        [""_after"", -1]," \n "        [""_alive"", []]" \n "    ];" \n "    private _count = count _alive;" \n "    if (_count <= 0) exitWith {-1};" \n "    private _found = -1;" \n "    for ""_offset"" from 1 to _count do {" \n "        private _candidate = (_after + _offset) mod _count;" \n "        if (_found < 0 && {_alive param [_candidate, false]}) then {" \n "            _found = _candidate;" \n "        };" \n "    };" \n "    _found" \n "};" \n "" \n "PGS_fnc_shotgunResolveCuffsServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]," \n "        [""_desired"", -1]" \n "    ];" \n "    private _alive = _snapshot param [4, []];" \n "    private _cuffs = +(_snapshot param [6, []]);" \n "    private _actions = +(_snapshot param [15, []]);" \n "    private _names = if (isNull _table) then {[]} else {_table getVariable [""PGS_ShotgunPlayerNames"", []]};" \n "    private _count = count _alive;" \n "    private _candidate = _desired;" \n "    private _found = -1;" \n "    private _skipped = [];" \n "    if (_candidate < 0 || {_candidate >= _count} || {!(_alive param [_candidate, false])}) then {" \n "        _candidate = [_candidate, _alive] call PGS_fnc_shotgunGetNextAliveRole;" \n "    };" \n "    if (_count > 0) then {" \n "        for ""_attempt"" from 0 to (_count - 1) do {" \n "            if (_found < 0 && {_candidate >= 0} && {_alive param [_candidate, false]}) then {" \n "                if (_cuffs param [_candidate, false]) then {" \n "                    _cuffs set [_candidate, false];" \n "                    _actions set [_candidate, ""Turn skipped by Handcuffs""];" \n "                    _skipped pushBack (_names param [_candidate, ""Player""]);" \n "                    _candidate = [_candidate, _alive] call PGS_fnc_shotgunGetNextAliveRole;" \n "                } else {" \n "                    _found = _candidate;" \n "                };" \n "            };" \n "        };" \n "    };" \n "    if (_found < 0) then {" \n "        _found = [-1, _alive] call PGS_fnc_shotgunGetNextAliveRole;" \n "    };" \n "    [_found, _cuffs, _actions, _skipped]" \n "};" \n "" \n "PGS_fnc_shotgunCreateLoadServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]," \n "        [""_actor"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    private _state = +_snapshot;" \n "    private _alive = _state param [4, []];" \n "    if (_actor < 0 || {!(_alive param [_actor, false])}) then {" \n "        _actor = [-1, _alive] call PGS_fnc_shotgunGetNextAliveRole;" \n "    };" \n "    if (_actor < 0) exitWith {false};" \n "    private _shellCount = PGS_CFG_SHOTGUN_MIN_SHELLS + floor (random ((PGS_CFG_SHOTGUN_MAX_SHELLS - PGS_CFG_SHOTGUN_MIN_SHELLS) + 1));" \n "    private _liveCount = 1 + floor (random (_shellCount - 1));" \n "    private _blankCount = _shellCount - _liveCount;" \n "    private _source = [];" \n "    for ""_index"" from 1 to _liveCount do {_source pushBack 1;};" \n "    for ""_index"" from 1 to _blankCount do {_source pushBack 0;};" \n "    private _chamber = [];" \n "    while {(count _source) > 0} do {" \n "        private _pick = floor (random (count _source));" \n "        _chamber pushBack (_source deleteAt _pick);" \n "    };" \n "    private _itemCatalog = [""BLADE"", ""BEER"", ""CIGAR"", ""SPYGLASS"", ""CUFFS"", ""INVERTER""];" \n "    private _oldInventories = _state param [5, []];" \n "    private _inventories = [];" \n "    private _actions = +(_state param [15, []]);" \n "    for ""_role"" from 0 to ((count _alive) - 1) do {" \n "        private _inventory = +(_oldInventories param [_role, []]);" \n "        if (_alive param [_role, false]) then {" \n "            private _slots = (PGS_CFG_SHOTGUN_INVENTORY_LIMIT - (count _inventory)) max 0;" \n "            private _dealCount = PGS_CFG_SHOTGUN_ITEMS_PER_LOAD min _slots;" \n "            if (_dealCount > 0) then {" \n "                for ""_deal"" from 1 to _dealCount do {" \n "                    _inventory pushBack (_itemCatalog param [floor (random (count _itemCatalog)), ""BEER""]);" \n "                };" \n "            };" \n "            _actions set [_role, format [""Load %1 ready - %2 item%3 carried"", (_state param [1, 0]) + 1, count _inventory, if ((count _inventory) == 1) then {""""} else {""s""}]];" \n "        };" \n "        _inventories pushBack _inventory;" \n "    };" \n "    private _load = (_state param [1, 0]) + 1;" \n "    private _version = (_state param [18, 0]) + 1;" \n "    _state set [0, ""LOADING""];" \n "    _state set [1, _load];" \n "    _state set [2, -1];" \n "    _state set [5, _inventories];" \n "    _state set [8, _liveCount];" \n "    _state set [9, _blankCount];" \n "    _state set [10, _shellCount];" \n "    _state set [11, true];" \n "    _state set [12, -1];" \n "    _state set [13, -1];" \n "    _state set [14, -1];" \n "    _state set [15, _actions];" \n "    _state set [17, format [""Load %1: memorize %2 LIVE and %3 BLANK shell%4. The colour ledger will now be hidden."", _load, _liveCount, _blankCount, if (_blankCount == 1) then {""""} else {""s""}]];" \n "    _state set [18, _version];" \n "    _state set [19, serverTime + PGS_CFG_SHOTGUN_LOAD_REVEAL_SECONDS];" \n "    _table setVariable [""PGS_ShotgunChamberServer"", _chamber];" \n "    _table setVariable [""PGS_ShotgunPendingActorServer"", _actor];" \n "    _table setVariable [""PGS_ShotgunPendingReloadServer"", false];" \n "    [_table] call PGS_fnc_shotgunClearPrivatePeeksServer;" \n "    [_table, _state] call PGS_fnc_shotgunSetSnapshotServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_shotgunStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""shotgun"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _names = [];" \n "    private _seatIndices = [];" \n "    for ""_seat"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_seat, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _names pushBack (name _unit);" \n "            _seatIndices pushBack _seat;" \n "        };" \n "    };" \n "    private _count = count _players;" \n "    if (_count < 2 || {_count > 4}) exitWith {false};" \n "    private _state = [_count] call PGS_fnc_shotgunCreateEmptySnapshot;" \n "    private _firstActor = floor (random _count);" \n "    _table setVariable [""PGS_ShotgunActive"", true, true];" \n "    _table setVariable [""PGS_ShotgunFinished"", false, true];" \n "    _table setVariable [" \n "        ""PGS_ShotgunGameId""," \n "        format [""PGS_SHOTGUN_%1_%2"", floor (serverTime * 10), floor (random 1000000)]," \n "        true" \n "    ];" \n "    _table setVariable [""PGS_ShotgunPlayers"", _players, true];" \n "    _table setVariable [""PGS_ShotgunPlayerNames"", _names, true];" \n "    _table setVariable [""PGS_ShotgunSeatIndices"", _seatIndices, true];" \n "    _table setVariable [""PGS_ShotgunRevision"", 0, true];" \n "    _table setVariable [""PGS_ShotgunSnapshotServer"", _state];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table, _state, _firstActor] call PGS_fnc_shotgunCreateLoadServer" \n "};" \n "" \n "PGS_fnc_shotgunFinishServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]," \n "        [""_winner"", -1]," \n "        [""_message"", ""Shotgun Roulette is finished.""]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _state = +_snapshot;" \n "    _state set [0, ""FINISHED""];" \n "    _state set [2, -1];" \n "    _state set [16, _winner];" \n "    _state set [17, _message];" \n "    _state set [19, 0];" \n "    _table setVariable [""PGS_ShotgunFinished"", true, true];" \n "    _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "    _table setVariable [""PGS_ShotgunPendingActorServer"", -1];" \n "    _table setVariable [""PGS_ShotgunPendingReloadServer"", false];" \n "    [_table, _state] call PGS_fnc_shotgunSetSnapshotServer;" \n "};" \n "" \n "PGS_fnc_shotgunProgressServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_ShotgunActive"", false])}) exitWith {};" \n "    private _state = +(_table getVariable [""PGS_ShotgunSnapshotServer"", []]);" \n "    private _phase = _state param [0, """"];" \n "    if (_phase == ""LOADING"") exitWith {" \n "        if (serverTime >= (_state param [19, 0])) then {" \n "            private _pendingActor = _table getVariable [""PGS_ShotgunPendingActorServer"", -1];" \n "            private _resolved = [_table, _state, _pendingActor] call PGS_fnc_shotgunResolveCuffsServer;" \n "            private _actor = _resolved param [0, -1];" \n "            private _names = _table getVariable [""PGS_ShotgunPlayerNames"", []];" \n "            _state set [0, ""PLAYING""];" \n "            _state set [2, _actor];" \n "            _state set [6, _resolved param [1, _state param [6, []]]];" \n "            _state set [8, -1];" \n "            _state set [9, -1];" \n "            _state set [15, _resolved param [2, _state param [15, []]]];" \n "            _state set [17, format [""The colour ledger is hidden. %1 holds the shotgun; track every reveal."", _names param [_actor, ""Player""]]];" \n "            _state set [19, 0];" \n "            _table setVariable [""PGS_ShotgunPendingActorServer"", -1];" \n "            [_table, _state] call PGS_fnc_shotgunSetSnapshotServer;" \n "        };" \n "    };" \n "    if (_phase != ""REVEAL"") exitWith {};" \n "    if (serverTime < (_state param [19, 0])) exitWith {};" \n "    private _alive = _state param [4, []];" \n "    private _living = {_x} count _alive;" \n "    if (_living <= 1) exitWith {" \n "        private _winner = [-1, _alive] call PGS_fnc_shotgunGetNextAliveRole;" \n "        private _names = _table getVariable [""PGS_ShotgunPlayerNames"", []];" \n "        [_table, _state, _winner, format [""%1 is the last player standing."", _names param [_winner, ""Player""]]] call PGS_fnc_shotgunFinishServer;" \n "    };" \n "    private _pendingActor = _table getVariable [""PGS_ShotgunPendingActorServer"", -1];" \n "    private _resolved = [_table, _state, _pendingActor] call PGS_fnc_shotgunResolveCuffsServer;" \n "    private _actor = _resolved param [0, -1];" \n "    _state set [6, _resolved param [1, _state param [6, []]]];" \n "    _state set [15, _resolved param [2, _state param [15, []]]];" \n "    private _skipped = _resolved param [3, []];" \n "    private _reload = _table getVariable [""PGS_ShotgunPendingReloadServer"", false];" \n "    if (_reload || {(count (_table getVariable [""PGS_ShotgunChamberServer"", []])) <= 0}) then {" \n "        [_table, _state, _actor] call PGS_fnc_shotgunCreateLoadServer;" \n "    } else {" \n "        private _names = _table getVariable [""PGS_ShotgunPlayerNames"", []];" \n "        _state set [0, ""PLAYING""];" \n "        _state set [2, _actor];" \n "        _state set [17, if ((count _skipped) > 0) then {" \n "            format [""%1 skipped by Handcuffs. %2 now holds the shotgun."", _skipped joinString "", "", _names param [_actor, ""Player""]]" \n "        } else {" \n "            format [""%1 now holds the shotgun."", _names param [_actor, ""Player""]]" \n "        }];" \n "        _state set [19, 0];" \n "        _table setVariable [""PGS_ShotgunPendingActorServer"", -1];" \n "        _table setVariable [""PGS_ShotgunPendingReloadServer"", false];" \n "        [_table, _state] call PGS_fnc_shotgunSetSnapshotServer;" \n "    };" \n "};" \n "" \n "PGS_fnc_shotgunResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_shotgunClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "};" \n "" \n "PGS_fnc_shotgunHandleDepartureServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_unit"", objNull]," \n "        [""_seatIndex"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_ShotgunActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_ShotgunPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_ShotgunSeatIndices"", []];" \n "    private _role = if (isNull _unit) then {-1} else {_players find _unit};" \n "    if (_role < 0 && {_seatIndex >= 0}) then {_role = _seatIndices find _seatIndex;};" \n "    if (_role < 0) exitWith {};" \n "    private _state = +(_table getVariable [""PGS_ShotgunSnapshotServer"", []]);" \n "    private _alive = +(_state param [4, []]);" \n "    if (!(_alive param [_role, false])) exitWith {};" \n "    private _lives = +(_state param [3, []]);" \n "    private _actions = +(_state param [15, []]);" \n "    private _names = _table getVariable [""PGS_ShotgunPlayerNames"", []];" \n "    _alive set [_role, false];" \n "    _lives set [_role, 0];" \n "    _actions set [_role, ""Left the table - eliminated""];" \n "    _state set [3, _lives];" \n "    _state set [4, _alive];" \n "    _state set [15, _actions];" \n "    private _living = {_x} count _alive;" \n "    if (_living <= 0) exitWith {" \n "        [_table] call PGS_fnc_shotgunClearServer;" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "    };" \n "    if (_living == 1) exitWith {" \n "        private _winner = [-1, _alive] call PGS_fnc_shotgunGetNextAliveRole;" \n "        [_table, _state, _winner, format [""%1 wins after %2 leaves the table."", _names param [_winner, ""Player""], _names param [_role, ""Player""]]] call PGS_fnc_shotgunFinishServer;" \n "    };" \n "    private _phase = _state param [0, ""PLAYING""];" \n "    if (_phase == ""PLAYING"" && {(_state param [2, -1]) == _role}) then {" \n "        private _next = [_role, _alive] call PGS_fnc_shotgunGetNextAliveRole;" \n "        private _resolved = [_table, _state, _next] call PGS_fnc_shotgunResolveCuffsServer;" \n "        _state set [2, _resolved param [0, _next]];" \n "        _state set [6, _resolved param [1, _state param [6, []]]];" \n "        _state set [15, _resolved param [2, _actions]];" \n "    };" \n "    if (_phase in [""LOADING"", ""REVEAL""] && {(_table getVariable [""PGS_ShotgunPendingActorServer"", -1]) == _role}) then {" \n "        _table setVariable [""PGS_ShotgunPendingActorServer"", [_role, _alive] call PGS_fnc_shotgunGetNextAliveRole];" \n "    };" \n "    _state set [17, format [""%1 left the match and was eliminated."", _names param [_role, ""Player""]]];" \n "    [_table, _state] call PGS_fnc_shotgunSetSnapshotServer;" \n "};" \n "" \n "PGS_fnc_shotgunReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_ShotgunActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_ShotgunPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_ShotgunSeatIndices"", []];" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    for ""_role"" from 0 to ((count _players) - 1) do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seat = _seatIndices param [_role, -1];" \n "        private _valid = !isNull _unit" \n "            && {_seat >= 0}" \n "            && {_seat < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seat, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""}" \n "            && {(vehicle _unit) == _unit};" \n "        if (!_valid) then {" \n "            [_table, _unit, _seat] call PGS_fnc_shotgunHandleDepartureServer;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_blackjackCreateEmptySnapshot = {" \n "    params [" \n "        [""_count"", 0]," \n "        [""_stacksSource"", []]" \n "    ];" \n "    private _stacks = [];" \n "    private _numbers = [];" \n "    private _hands = [];" \n "    private _statuses = [];" \n "    private _actions = [];" \n "    private _booleans = [];" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        _stacks pushBack (_stacksSource param [_role, PGS_CFG_BLACKJACK_STARTING_CHIPS]);" \n "        _numbers pushBack 0;" \n "        _hands pushBack [];" \n "        _statuses pushBack ""BETTING"";" \n "        _actions pushBack ""Choose an even bet"";" \n "        _booleans pushBack false;" \n "    };" \n "    [" \n "        ""IDLE"", 0, -1, _stacks, +_numbers, _hands, +_numbers, _statuses," \n "        _actions, [], 0, false, false, ""Waiting for Blackjack."", +_numbers," \n "        _booleans, 0" \n "    ]" \n "};" \n "" \n "PGS_fnc_blackjackPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [" \n "        ""PGS_BlackjackRevision""," \n "        (_table getVariable [""PGS_BlackjackRevision"", 0]) + 1," \n "        true" \n "    ];" \n "    _table setVariable [" \n "        ""PGS_TableRevision""," \n "        (_table getVariable [""PGS_TableRevision"", 0]) + 1," \n "        true" \n "    ];" \n "};" \n "" \n "PGS_fnc_blackjackSetSnapshotServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]" \n "    ];" \n "    if (!isServer || {isNull _table} || {(typeName _snapshot) != ""ARRAY""}) exitWith {};" \n "    _table setVariable [""PGS_BlackjackSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_BlackjackSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_blackjackPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_blackjackClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_BlackjackActive"", false, true];" \n "    _table setVariable [""PGS_BlackjackFinished"", false, true];" \n "    _table setVariable [""PGS_BlackjackGameId"", """", true];" \n "    _table setVariable [""PGS_BlackjackPlayers"", [], true];" \n "    _table setVariable [""PGS_BlackjackPlayerNames"", [], true];" \n "    _table setVariable [""PGS_BlackjackSeatIndices"", [], true];" \n "    _table setVariable [""PGS_BlackjackEpoch"", 0, true];" \n "    _table setVariable [""PGS_BlackjackDealerNextAt"", 0, true];" \n "    _table setVariable [""PGS_BlackjackShoeServer"", []];" \n "    _table setVariable [""PGS_BlackjackDealerHandServer"", []];" \n "    _table setVariable [""PGS_BlackjackSnapshotServer"", [] call PGS_fnc_blackjackCreateEmptySnapshot];" \n "    _table setVariable [""PGS_BlackjackSnapshot"", [] call PGS_fnc_blackjackCreateEmptySnapshot, true];" \n "    [_table] call PGS_fnc_blackjackPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_blackjackGetNextPlayingRole = {" \n "    params [" \n "        [""_after"", -1]," \n "        [""_statuses"", []]" \n "    ];" \n "    private _count = count _statuses;" \n "    if (_count <= 0) exitWith {-1};" \n "    private _found = -1;" \n "    for ""_offset"" from 1 to _count do {" \n "        private _candidate = (_after + _offset) mod _count;" \n "        if (_found < 0 && {(_statuses param [_candidate, ""LEFT""]) == ""PLAYING""}) then {" \n "            _found = _candidate;" \n "        };" \n "    };" \n "    _found" \n "};" \n "" \n "PGS_fnc_blackjackAllBetsReadyServer = {" \n "    params [[""_snapshot"", []]];" \n "    private _statuses = _snapshot param [7, []];" \n "    private _eligible = 0;" \n "    private _ready = 0;" \n "    {" \n "        if (_x in [""BETTING"", ""READY""]) then {" \n "            _eligible = _eligible + 1;" \n "            if (_x == ""READY"") then {_ready = _ready + 1;};" \n "        };" \n "    } forEach _statuses;" \n "    _eligible > 0 && {_ready == _eligible}" \n "};" \n "" \n "PGS_fnc_blackjackAllNextReadyServer = {" \n "    params [[""_snapshot"", []]];" \n "    private _stacks = _snapshot param [3, []];" \n "    private _statuses = _snapshot param [7, []];" \n "    private _nextReady = _snapshot param [15, []];" \n "    private _eligible = 0;" \n "    private _ready = 0;" \n "    for ""_role"" from 0 to ((count _statuses) - 1) do {" \n "        if ((_statuses param [_role, ""LEFT""]) != ""LEFT"" && {(_stacks param [_role, 0]) >= PGS_CFG_BLACKJACK_MINIMUM_BET}) then {" \n "            _eligible = _eligible + 1;" \n "            if (_nextReady param [_role, false]) then {_ready = _ready + 1;};" \n "        };" \n "    };" \n "    _eligible > 0 && {_ready == _eligible}" \n "};" \n "" \n "PGS_fnc_blackjackPrepareBettingServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_incrementRound"", true]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    private _state = +(_table getVariable [""PGS_BlackjackSnapshotServer"", []]);" \n "    private _stacks = +(_state param [3, []]);" \n "    private _oldStatuses = +(_state param [7, []]);" \n "    private _count = count _stacks;" \n "    private _bets = [];" \n "    private _hands = [];" \n "    private _totals = [];" \n "    private _statuses = [];" \n "    private _actions = [];" \n "    private _results = [];" \n "    private _nextReady = [];" \n "    private _eligible = 0;" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        private _left = (_oldStatuses param [_role, ""LEFT""]) == ""LEFT"";" \n "        private _playable = !_left && {(_stacks param [_role, 0]) >= PGS_CFG_BLACKJACK_MINIMUM_BET};" \n "        _bets pushBack 0;" \n "        _hands pushBack [];" \n "        _totals pushBack 0;" \n "        _results pushBack 0;" \n "        _nextReady pushBack false;" \n "        if (_left) then {" \n "            _statuses pushBack ""LEFT"";" \n "            _actions pushBack ""Left table"";" \n "        } else {" \n "            if (_playable) then {" \n "                _eligible = _eligible + 1;" \n "                _statuses pushBack ""BETTING"";" \n "                _actions pushBack ""Choose an even bet"";" \n "            } else {" \n "                _statuses pushBack ""BROKE"";" \n "                _actions pushBack ""No playable chips"";" \n "            };" \n "        };" \n "    };" \n "    if (_eligible <= 0) exitWith {" \n "        _state set [0, ""SESSION_END""];" \n "        _state set [2, -1];" \n "        _state set [7, _statuses];" \n "        _state set [8, _actions];" \n "        _state set [13, ""No seated player has enough chips for the minimum bet. The dealer wins the session.""];" \n "        _state set [15, _nextReady];" \n "        _table setVariable [""PGS_BlackjackFinished"", true, true];" \n "        _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "        [_table, _state] call PGS_fnc_blackjackSetSnapshotServer;" \n "        false" \n "    };" \n "    private _round = _state param [1, 0];" \n "    if (_incrementRound) then {_round = _round + 1;};" \n "    _state set [0, ""BETTING""];" \n "    _state set [1, _round];" \n "    _state set [2, -1];" \n "    _state set [4, _bets];" \n "    _state set [5, _hands];" \n "    _state set [6, _totals];" \n "    _state set [7, _statuses];" \n "    _state set [8, _actions];" \n "    _state set [9, []];" \n "    _state set [10, 0];" \n "    _state set [11, false];" \n "    _sta