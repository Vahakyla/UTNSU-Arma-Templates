;" \n "    };" \n "};" \n "" \n "PGS_fnc_startAuthorityLoop = {" \n "    if (!isServer) exitWith {};" \n "    if (missionNamespace getVariable [""PGS_AuthorityLoopStarted"", false]) exitWith {};" \n "    missionNamespace setVariable [""PGS_AuthorityLoopStarted"", true];" \n "    [] spawn {" \n "        private _nextMaintenance = 0;" \n "        while {true} do {" \n "            private _authorityPlayers = +allPlayers;" \n "            {" \n "                [_x] call PGS_fnc_initializePlayerServer;" \n "            } forEach _authorityPlayers;" \n "            call PGS_fnc_reconcileRegisteredTablesServer;" \n "            [_authorityPlayers] call PGS_fnc_processPriorityUNORequestsServer;" \n "            {" \n "                [_x] call PGS_fnc_processPlayerRequestsServer;" \n "            } forEach _authorityPlayers;" \n "            if (serverTime >= _nextMaintenance) then {" \n "                call PGS_fnc_reconcileRegistriesServer;" \n "                _nextMaintenance = serverTime + PGS_CFG_MAINTENANCE_TICK;" \n "            };" \n "            sleep PGS_CFG_AUTHORITY_TICK;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_submitJoinRequestLocal = {" \n "    params [[""_table"", objNull]];" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    if (isNull _table) exitWith {" \n "        hintSilent ""That party table is unavailable."";" \n "    };" \n "    if (!alive player) exitWith {" \n "        hintSilent ""You must be alive to sit at the table."";" \n "    };" \n "    private _token = [""JOIN""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_JoinRequest""," \n "        [_token, netId _table, getPosATL player]," \n "        true" \n "    ];" \n "    hintSilent ""Requesting a seat from the table host..."";" \n "};" \n "" \n "PGS_fnc_submitLeaveRequestLocal = {" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    private _table = player getVariable [""PGS_SeatedTable"", objNull];" \n "    private 