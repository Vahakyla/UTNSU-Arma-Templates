_occupancy set [_index, false];" \n "                _changed = true;" \n "            } else {" \n "                if (!(_occupancy param [_index, false])) then {" \n "                    _occupancy set [_index, true];" \n "                    _changed = true;" \n "                };" \n "            };" \n "        } else {" \n "            if ((_occupancy param [_index, false]) || {(_votes param [_index, """"]) != """"} || {_ready param [_index, false]}) then {" \n "                _changed = true;" \n "            };" \n "            _occupancy set [_index, false];" \n "            _votes set [_index, """"];" \n "            _ready set [_index, false];" \n "        };" \n "    };" \n "" \n "    if (_changed) then {" \n "        _table setVariable [""PGS_TableSeats"", _seats, true];" \n "        _table setVariable [""PGS_TableVotes"", _votes, true];" \n "        _table setVariable [""PGS_TableOccupancy"", _occupancy, true];" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        [_table] call PGS_fnc_refreshTableConsensusServer;" \n "    };" \n "};" \n "" \n "PGS_fnc_reconcileRegisteredTablesServer = {" \n "    if (!isServer) exitWith {};" \n "    private _published = +(missionNamespace getVariable [""PGS_Tables"", []]);" \n "    private _clean = [];" \n "    {" \n "        if (!isNull _x && {_x getVariable [""PGS_IsPartyTable"", false]}) then {" \n "            _clean pushBackUnique _x;" \n "            [_x] call PGS_fnc_reconcileOneTableServer;" \n "        };" \n "    } forEach _published;" \n "    if ((count _clean) != (count _published)) then {" \n "        missionNamespace setVariable [""PGS_Tables"", _clean, true];" \n "    };" \n "" \n "    {" \n "        private _unit = _x;" \n "        private _table = _unit getVariable [""PGS_SeatedTable"", objNull];" \n "        private _seatIndex = _unit getVariable [""PGS_SeatIndex"", -1];" \n "        private _valid = false;" \n "        if (!isNull _table && {_table getVariable [""PGS_IsPartyTable"", false]}) then {" \n "            private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "            _valid = _seatIndex >= 0" \n "                && {_seatIndex < PGS_CFG_SEAT_COUNT}" \n "                && {(_seats param [_seatIndex, objNull]) == _unit}" \n "                && {alive _unit}" \n "                && {(vehicle _unit) == _unit};" \n "        };" \n "        if (!_valid && {(!isNull _table) || {_seatIndex >= 0}}) then {" \n "            [_unit] call PGS_fnc_clearUnitSeatVariablesServer;" \n "        };" \n "    } forEach allPlayers;" \n "};" \n "" \n "PGS_fnc_reconcileRegistriesServer = {" \n "    if (!isServer) exitWith {};" \n "    private _tables = +(missionNamespace getVariable [""PGS_Tables"", []]);" \n "    private _seeded = [PGS_CFG_TABLE_CLASSES, ""PGS_CompositionSeed""] call PGS_fnc_collectTaggedClassObjects;" \n "    private _tagged = [PGS_CFG_TABLE_CLASSES, ""PGS_IsPartyTable""] call PGS_fnc_collectTaggedClassObjects;" \n "    {" \n "        if (!isNull _x) then {" \n "            if (!(_x getVariable [""PGS_IsPartyTable"", false])) then {" \n "                [_x, ""Composition"", ""COMPOSITION""] call PGS_fnc_markTableServer;" \n "            };" \n "            _tables pushBackUnique _x;" \n "        };" \n "    } forEach (_seeded + _tagged);" \n "    private _clean = [];" \n "    {" \n "        if (!isNull _x && {_x getVariable [""PGS_IsPartyTable"", false]}) then {" \n "            _clean pushBackUnique _x;" \n "        };" \n "    } forEach _tables;" \n "    missionNamespace setVariable [""PGS_Tables"", _clean, true];" \n "    call PGS_fnc_reconcileRegisteredTablesServer;" \n "    {" \n "        [_x] call PGS_fnc_registerCuratorEditableServer;" \n "    } forEach _clean;" \n "}; " \n " " \n "PGS_fnc_processJoinRequestServer = {" \n "    params [" \n "        [""_unit"", objNull]," \n "        [""_request"", []]" \n "    ];" \n "    if (!isServer || {isNull _un