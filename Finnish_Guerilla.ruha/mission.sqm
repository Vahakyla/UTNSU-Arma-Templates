   private _guessButton = _display ctrlCreate [""RscButtonMenu"", -1];" \n "    _guessButton ctrlSetPosition ([0.030, 0.888, 0.200, 0.050] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _guessButton ctrlSetText ""MAKE A GUESS"";" \n "    _guessButton ctrlSetFontHeight 0.025;" \n "    _guessButton ctrlAddEventHandler [""ButtonClick"", {params [""_control""]; [_control] call PGS_fnc_handleWhosWhoGuessButtonLocal;}];" \n "    _guessButton ctrlCommit 0;" \n "    private _passButton = _display ctrlCreate [""RscButtonMenu"", -1];" \n "    _passButton ctrlSetPosition ([0.245, 0.888, 0.170, 0.050] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _passButton ctrlSetText ""PASS TURN"";" \n "    _passButton ctrlSetFontHeight 0.025;" \n "    _passButton setVariable [""PGS_WhosWhoAction"", ""PASS""];" \n "    _passButton ctrlAddEventHandler [""ButtonClick"", {params [""_control""]; [_control] call PGS_fnc_handleWhosWhoActionButtonLocal;}];" \n "    _passButton ctrlCommit 0;" \n "    private _resetButton = _display ctrlCreate [""RscButtonMenu"", -1];" \n "    _resetButton ctrlSetPosition ([0.030, 0.888, 0.260, 0.050] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _resetButton ctrlSetText ""RETURN TO LOBBY"";" \n "    _resetButton ctrlSetFontHeight 0.025;" \n "    _resetButton setVariable [""PGS_WhosWhoAction"", ""RESET""];" \n "    _resetButton ctrlAddEventHandler [""ButtonClick"", {params [""_control""]; [_control] call PGS_fnc_handleWhosWhoActionButtonLocal;}];" \n "    _resetButton ctrlCommit 0;" \n "    private _helpLabel = _display ctrlCreate [""RscText"", -1];" \n "    _helpLabel ctrlSetPosition ([0.430, 0.884, 0.540, 0.054] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _helpLabel ctrlSetTextColor [0.60, 0.72, 0.78, 1];" \n "    _helpLabel ctrlSetFontHeight 0.019;" \n "    _helpLabel ctrlCommit 0;" \n "    private _ruleLabel = _display ctrlCreate [""RscText"", -1];" \n "    _ruleLabel ctrlSetPosition ([0.030, 0.948, 0.940, 0.026] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _ruleLabel ctrlSetText ""FOUR UNLABELED FACTION ROWS  /  RED X MARKS ARE PRIVATE NOTES  /  WRONG GUESSES PASS THE TURN  /  CORRECT GUESS WINS"";" \n "    _ruleLabel ctrlSetTextColor [0.45, 0.56, 0.62, 1];" \n "    _ruleLabel ctrlSetFontHeight 0.016;" \n "    _ruleLabel ctrlCommit 0;" \n "" \n "    _display setVariable [""PGS_WhosWhoTurnLabel"", _turnLabel];" \n "    _display setVariable [""PGS_WhosWhoStatusLabel"", _statusLabel];" \n "    _display setVariable [""PGS_WhosWhoActionLabel"", _actionLabel];" \n "    _display setVariable [""PGS_WhosWhoTargetPicture"", _targetPicture];" \n "    _display setVariable [""PGS_WhosWhoTargetLabel"", _targetLabel];" \n "    _display setVariable [""PGS_WhosWhoTileBundles"", _tileBundles];" \n "    _display setVariable [""PGS_WhosWhoGuessButton"", _guessButton];" \n "    _display setVariable [""PGS_WhosWhoPassButton"", _passButton];" \n "    _display setVariable [""PGS_WhosWhoResetButton"", _resetButton];" \n "    _display setVariable [""PGS_WhosWhoHelpLabel"", _helpLabel];" \n "    [_display] call PGS_fnc_refreshWhosWhoLocal;" \n "    [_display] spawn {" \n "        disableSerialization;" \n "        params [""_activeDisplay""];" \n "        while {!isNull _activeDisplay} do {" \n "            [_activeDisplay] call PGS_fnc_refreshWhosWhoLocal;" \n "            uiSleep PGS_CFG_WHOSWHO_UI_TICK;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_getShotgunPlayerRoleLocal = {" \n "    params [[""_table"", objNull]];" \n "    if (isNull _table || {isNull player}) exitWith {-1};" \n "    (_table getVariable [""PGS_ShotgunPlayers"", []]) find player" \n "};" \n "" \n "PGS_fnc_handleShotgunTargetClickLocal = {" \n "    disableSerialization;" \n "    params [[""_control"", controlNull]];" \n "    if (isNull _control) exitWith {};" \n "    private _display = ctrlParent _control;" \n "    if (isNull _display || {_display getVariable [""PGS_SpectatorMode"", false]}) exitWith {};" \n "    private _table = _display getVariable [""PGS_ShotgunTable"", objNull];" \n "    private _target = _control getVariable [""PGS_ShotgunTargetRole"", -1];" \n "    private _cuffSlot = _display getVariable [""PGS_ShotgunCuffSlotLocal"", -1];" \n "    if (_cuffSlot >= 0) then {" \n "        _display setVariable [""PGS_ShotgunCuffSlotLocal"", -1];" \n "        [_table, ""USE_ITEM"", [_cuffSlot, _target]] call PGS_fnc_submitShotgunActionRequestLocal;" \n "    } else {" \n "        [_table, ""FIRE"", _target] call PGS_fnc_submitShotgunActionRequestLocal;" \n "    };" \n "    [_display] call PGS_fnc_refreshShotgunLocal;" \n "};" \n "" \n "PGS_fnc_handleShotgunItemClickLocal = {" \n "    disableSerialization;" \n "    params [[""_control"", controlNull]];" \n "    if (isNull _control) exitWith {};" \n "    private _display = ctrlParent _control;" \n "    if (isNull _display || {_display getVariable [""PGS_SpectatorMode"", false]}) exitWith {};" \n "    private _table = _display getVariable [""PGS_ShotgunTable"", objNull];" \n "    private _slot = _control getVariable [""PGS_ShotgunItemSlot"", -1];" \n "    private _item = _control getVariable [""PGS_ShotgunItemId"", """"];" \n "    if (_item == ""CUFFS"") then {" \n "        private _oldSlot = _display getVariable [""PGS_ShotgunCuffSlotLocal"", -1];" \n "        _display setVariable [""PGS_ShotgunCuffSlotLocal"", if (_oldSlot == _slot) then {-1} else {_slot}];" \n "        [_display] call PGS_fnc_refreshShotgunLocal;" \n "    } else {" \n "        _display setVariable [""PGS_ShotgunCuffSlotLocal"", -1];" \n "        [_table, ""USE_ITEM"", [_slot, -1]] call PGS_fnc_submitShotgunActionRequestLocal;" \n "    };" \n "};" \n "" \n "PGS_fnc_handleShotgunResetClickLocal = {" \n "    disableSerialization;" \n "    params [[""_control"", controlNull]];" \n "    if (isNull _control) exitWith {};" \n "    private _display = ctrlParent _control;" \n "    private _table = if (isNull _display) then {objNull} else {_display getVariable [""PGS_ShotgunTable"", objNull]};" \n "    [_table, ""RESET"", -1] call PGS_fnc_submitShotgunActionRequestLocal;" \n "};" \n "" \n "PGS_fnc_scaleShotgunDisplayLocal = {" \n "    disableSerialization;" \n "    params [[""_display"", displayNull]];" \n "    if (isNull _display || {_display getVariable [""PGS_ShotgunScaleApplied"", false]}) exitWith {};" \n "    private _scale = PGS_CFG_SHOTGUN_UI_SCALE max 0.5;" \n "    private _centerX = PGS_CFG_SHOTGUN_UI_CENTER param [0, 0.590];" \n "    private _centerY = PGS_CFG_SHOTGUN_UI_CENTER param [1, 0.5425];" \n "    {" \n "        private _position = ctrlPosition _x;" \n "        private _oldX = _position param [0, -10];" \n "        private _oldY = _position param [1, -10];" \n "        if (_oldX > -5 && {_oldY > -5}) then {" \n "            _x ctrlSetPosition [" \n "                _centerX + ((_oldX - _centerX) * _scale)," \n "                _centerY + ((_oldY - _centerY) * _scale)," \n "                _position param [2, 0]," \n "                _position param [3, 0]" \n "            ];" \n "            _x ctrlSetScale _scale;" \n "            _x ctrlCommit 0;" \n "        };" \n "    } forEach (allControls _display);" \n "    _display setVariable [""PGS_ShotgunScaleApplied"", true];" \n "};" \n "" \n "PGS_fnc_refreshShotgunLocal = {" \n "    disableSerialization;" \n "    params [[""_display"", displayNull]];" \n "    if (isNull _display) exitWith {};" \n "    if (_display getVariable [""PGS_ShotgunRefreshing"", false]) exitWith {};" \n "    _display setVariable [""PGS_ShotgunRefreshing"", true];" \n "    private _table = _display getVariable [""PGS_ShotgunTable"", objNull];" \n "    private _spectating = _display getVariable [""PGS_SpectatorMode"", false];" \n "    if (" \n "        isNull _table" \n "        || {!([_table, _spectating] call PGS_fnc_isValidGameViewerLocal)}" \n "        || {([_table] call PGS_fnc_getTableActiveGameId) != ""shotgun""}" \n "    ) exitWith {" \n "        _display closeDisplay 1;" \n "    };" \n "    private _state = _table getVariable [""PGS_ShotgunSnapshot"", []];" \n "    if ((count _state) < 20) exitWith {" \n "        _display setVariable [""PGS_ShotgunRefreshing"", false];" \n "    };" \n "    private _phase = _state param [0, ""IDLE""];" \n "    private _load = _state param [1, 0];" \n "    private _actor = _state param [2, -1];" \n "    private _lives = _state param [3, []];" \n "    private _alive = _state param [4, []];" \n "    private _inventories = _state param [5, []];" \n "    private _cuffs = _state param [6, []];" \n "    private _blades = _state param [7, []];" \n "    private _remainingLive = _state param [8, 0];" \n "    private _remainingBlank = _state param [9, 0];" \n "    private _chamberCount = _state param [10, 0];" \n "    private _ledgerTrusted = _state param [11, true];" \n "    private _lastShell = _state param [12, -1];" \n "    private _lastTarget = _state param [14, -1];" \n "    private _actions = _state param [15, []];" \n "    private _winner = _state param [16, -1];" \n "    private _status = _state param [17, ""Shotgun Roulette in progress.""];" \n "    private _chamberVersion = _state param [18, 0];" \n "    private _phaseDeadline = _state param [19, 0];" \n "    private _names = _table getVariable [""PGS_ShotgunPlayerNames"", []];" \n "    private _role = if (_spectating) then {-1} else {[_table] call PGS_fnc_getShotgunPlayerRoleLocal};" \n "" \n "    private _loadLabel = _display getVariable [""PGS_ShotgunLoadLabel"", controlNull];" \n "    private _phaseLabel = _display getVariable [""PGS_ShotgunPhaseLabel"", controlNull];" \n "    private _ledgerLabel = _display getVariable [""PGS_ShotgunLedgerLabel"", controlNull];" \n "    private _statusLabel = _display getVariable [""PGS_ShotgunStatusLabel"", controlNull];" \n "    private _instructionLabel = _display getVariable [""PGS_ShotgunInstructionLabel"", controlNull];" \n "    private _peekLabel = _display getVariable [""PGS_ShotgunPeekLabel"", controlNull];" \n "    if (!isNull _loadLabel) then {" \n "        _loadLabel ctrlSetText format [""LOAD %1  /  %2 SHELL%3"", _load, _chamberCount, if (_chamberCount == 1) then {""""} else {""S""}];" \n "        _loadLabel ctrlCommit 0;" \n "    };" \n "    if (!isNull _phaseLabel) then {" \n "        private _actorName = if (_actor >= 0) then {_names param [_actor, ""Player""]} else {""NO ACTIVE SHOOTER""};" \n "        _phaseLabel ctrlSetText (if (_phase == ""FINISHED"") then {" \n "            format [""WINNER  /  %1"", _names param [_winner, ""Player""]]" \n "        } else {" \n "            if (_phase == ""LOADING"") then {" \n "                format [""MEMORIZE LOAD  /  %1"", ceil ((_phaseDeadline - serverTime) max 0)]" \n "            } else {" \n "                if (_phase == ""REVEAL"") then {""SHELL REVEAL""} else {format [""SHOTGUN  /  %1"", _actorName]}" \n "            }" \n "        });" \n "        _phaseLabel ctrlSetTextColor (if (_phase in [""LOADING"", ""REVEAL""]) then {[1, 0.78, 0.25, 1]} else {[0.88, 0.94, 1, 1]});" \n "        _phaseLabel ctrlCommit 0;" \n "    };" \n "    if (!isNull _ledgerLabel) then {" \n "        _ledgerLabel ctrlSetText (if (_phase == ""LOADING"") then {" \n "            format [""MEMORIZE  /  %1 LIVE  /  %2 BLANK"", _remainingLive, _remainingBlank]" \n "        } else {" \n "            if (_ledgerTrusted) then {" \n "                format [""COLOUR LEDGER HIDDEN  /  TRACK REVEALS  /  %1 SHELL%2 REMAIN"", _chamberCount, if (_chamberCount == 1) then {""""} else {""S""}]" \n "            } else {" \n "                format [""INVERTER USED  /  MIX IS UNCERTAIN  /  %1 SHELL%2 REMAIN"", _chamberCount, if (_chamberCount == 1) then {""""} else {""S""}]" \n "            }" \n "        });" \n "        _ledgerLabel ctrlSetTextColor (if (_phase == ""LOADING"") then {[1, 0.82, 0.35, 1]} else {if (_ledgerTrusted) then {[0.65, 0.75, 0.82, 1]} else {[1, 0.69, 0.25, 1]}});" \n "        _ledgerLabel ctrlCommit 0;" \n "    };" \n "    if (!isNull _statusLabel) then {" \n "        _statusLabel ctrlSetText _status;" \n "        _statusLabel ctrlSetTooltip _status;" \n "        _statusLabel ctrlCommit 0;" \n "    };" \n "" \n "    private _playerPanels = _display getVariable [""PGS_ShotgunPlayerPanels"", []];" \n "    for ""_index"" from 0 to ((count _playerPanels) - 1) do {" \n "        private _bundle = _playerPanels param [_index, []];" \n "        private _panel = _bundle param [0, controlNull];" \n "        private _nameControl = _bundle param [1, controlNull];" \n "        private _livesControl = _bundle param [2, controlNull];" \n "        private _inventoryControl = _bundle param [3, controlNull];" \n "        private _actionControl = _bundle param [4, controlNull];" \n "        private _exists = _index < (count _names);" \n "        {" \n "            if (!isNull _x) then {_x ctrlShow _exists;};" \n "        } forEach _bundle;" \n "        if (_exists) then {" \n "            private _isAlive = _alive param [_index, false];" \n "            private _isActor = _phase == ""PLAYING"" && {_actor == _index};" \n "            private _wasTarget = _phase == ""REVEAL"" && {_lastTarget == _index};" \n "            if (!isNull _panel) then {" \n "                _panel ctrlSetBackgroundColor (if (!_isAlive) then {" \n "                    [0.055, 0.055, 0.060, 0.97]" \n "                } else {" \n "                    if (_wasTarget) then {[0.34, 0.065, 0.045, 0.98]} else {if (_isActor) then {[0.30, 0.205, 0.050, 0.98]} else {[0.025, 0.080, 0.110, 0.97]}}" \n "                });" \n "                _panel ctrlCommit 0;" \n "            };" \n "            if (!isNull _nameControl) then {" \n "                _nameControl ctrlSetText format [""P%1  /  %2%3"", _index + 1, _names param [_index, ""Player""], if (_index == _role) then {""  /  YOU""} else {""""}];" \n "                _nameControl ctrlSetTooltip (_names param [_index, ""Player""]);" \n "                _nameControl ctrlCommit 0;" \n "            };" \n "            if (!isNull _live