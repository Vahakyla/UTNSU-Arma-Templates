									class Attributes
									{
										init="M9SD_fnc_spawnFlammableFuelBladder_Forest =  " \n "{ " \n " params [['_helipad', objNull]]; " \n " private _pos = getPos _helipad; " \n " private _bladder = createVehicle  [""StorageBladder_01_fuel_forest_F"", _pos, [], 0, ""CAN_COLLIDE""]; " \n " _bladder attachTo [_helipad, [0,0,0.85]]; " \n " _bladder setVariable  " \n " [ " \n "  'M9SD_EH_bladderHit',  " \n "  _bladder addEventHandler ['hit', " \n "  { " \n "   params [""_unit"", ""_source"", ""_damage"", ""_instigator""]; " \n "   private _bladder = _unit; " \n "   _bladder removeEventHandler ['hit', _bladder getVariable ['M9SD_EH_bladderHit', -420]]; " \n "   private _pos = getPos _bladder; " \n "   private _posATL = getPosATL _bladder; " \n "   private _fire1 = createVehicle [""test_EmptyObjectForFireBig"", _pos, [], 0, ""CAN_COLLIDE""]; " \n "   _fire1 attachTo [_bladder,[3,1.5,0]]; " \n "   private _fire2 = createVehicle [""test_EmptyObjectForFireBig"", _pos, [], 0, ""CAN_COLLIDE""]; " \n "   _fire2 attachTo [_bladder,[3,-1.5,0]]; " \n "   private _fire3 = createVehicle [""test_EmptyObjectForFireBig"", _pos, [], 0, ""CAN_COLLIDE""]; " \n "   _fire3 attachTo [_bladder,[0,-1.5,0]]; " \n "   private _fire4 = createVehicle [""test_EmptyObjectForFireBig"", _pos, [], 0, ""CAN_COLLIDE""]; " \n "   _fire4 attachTo [_bladder,[0,1.5,0]]; " \n "   private _fire5 = createVehicle [""test_EmptyObjectForFireBig"", _pos, [], 0, ""CAN_COLLIDE""]; " \n "   _fire5 attachTo [_bladder,[-3,1.5,0]]; " \n "   private _fire6 = createVehicle [""test_EmptyObjectForFireBig"", _pos, [], 0, ""CAN_COLLIDE""]; " \n "   _fire6 attachTo [_bladder,[-3,-1.5,0]]; " \n "   _bladder spawn  " \n "   { " \n "    while {!isNull _this} do  " \n "    { " \n "     playSound3D [""A3\Missions_F_EPA\data\sounds\burning_car_loop1.wss"", _this, false, getPosATL _this, 5, 1, 100];  " \n "     playSound3D [""A3\Missions_F_EPA\data\sounds\burning_car_loop2.wss"", _this, false, getPosATL _this, 5, 1, 100]; " \n "     uiSleep 6; " \n "    }; " \n "   }; " \n "   playSound3D [""A3\Sounds_F\weapons\smokeshell\smoke_3.wss"", _bladder, false, _posATL, 5, 0.7, 100]; " \n "   _unit setDamage 1; " \n "   _unit spawn  " \n "   { " \n "    uiSleep 30; " \n "    deleteVehicle _this; " \n "   }; " \n "   [_unit, [_fire1,_fire2,_fire3,_fire4,_fire5,_fire6]] spawn  " \n "   { " \n "    params ['_unit', '_fires']; " \n "    waitUntil {sleep 1; isNull _unit}; " \n "    { " \n "     deleteVehicle _x; " \n "    } forEach _fires; " \n "   }; " \n "   _bladder spawn  " \n "   { " \n "    _light = createVehicle [""#lightpoint"",getPos _this,[],0,""CAN_COLLIDE""]; " \n "    [_light,1.5] remoteExec [""setLightBrightness"",0,_light]; " \n "    [_light,[0.75, 0.25, 0.1]] remoteExec [""setLightAmbient"",0,_light]; " \n "    [_light,[0.75, 0.25, 0.1]] remoteExec [""setLightColor"",0,_light]; " \n "    _light attachTo [_this,[0,0,0]]; " \n "    waitUntil {sleep 1; isNull _this}; " \n "    deleteVehicle _light; " \n "   }; " \n "  }] " \n " ]; " \n " 0 = [_helipad, _bladder] spawn  " \n " { " \n "  params ['_helipad', '_bladder']; " \n "  waitUntil {sleep 1; ((isNull _helipad) || (isNull _bladder))}; " \n "  deleteVehicle _helipad; " \n "  deleteVehicle _bladder; " \n " }; " \n "}; " \n "[this] call M9SD_fnc_spawnFlammableFuelBladder_Forest; " \n "";
