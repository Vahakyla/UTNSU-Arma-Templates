NODiscardServer"", _discard];" \n "    private _topCard = _selectedCards param [(count _selectedCards) - 1, _firstCard];" \n "    private _activeColour = if (_firstKind in [14, 15]) then {_chosenColour} else {_firstColour};" \n "    private _playedName = [_topCard, _activeColour] call PGS_fnc_unoCardName;" \n "    private _hadUNOArmed = _armed param [_role, false];" \n "    _armed set [_role, false];" \n "    private _remainingCards = count _hand;" \n "    private _vulnerable = -1;" \n "    private _unoText = """";" \n "    if (_remainingCards == 1) then {" \n "        if (_hadUNOArmed) then {" \n "            _unoText = "" UNO!"";" \n "        } else {" \n "            _vulnerable = _role;" \n "            _unoText = "" UNO was not called!"";" \n "        };" \n "    };" \n "    _actions set [_role, format [""Played %1%2"", _playedName, _unoText]];" \n "    _state set [4, _topCard];" \n "    _state set [5, _activeColour];" \n "    _state set [11, -1];" \n "    _state set [12, _actions];" \n "    _state set [13, _vulnerable];" \n "    _state set [17, _armed];" \n "    _state set [18, 0];" \n "    _state set [19, (_state param [19, 0]) + 1];" \n "" \n "    if (_remainingCards <= 0) exitWith {" \n "        private _changedRoles = [_role];" \n "        if (_firstKind in [13, 15]) then {" \n "            private _finalPenalty = if (_firstKind == 13) then {2} else {4};" \n "            if (_pendingKind == _firstKind) then {_finalPenalty = _finalPenalty + _pendingAmount;};" \n "            private _victim = [_role, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "            if (_victim >= 0 && {_victim != _role}) then {" \n "                private _drawResult = [_table, _victim, _finalPenalty] call PGS_fnc_unoDrawCardsServer;" \n "                private _drawn = _drawResult param [0, 0];" \n "                _justDrawnIds = +(_table getVariable [""PGS_UNOJustDrawnIdsServer"", []]);" \n "                _justDrawnIds set [_victim, -1];" \n "                _table setVariable [""PGS_UNOJustDrawnIdsServer"", _justDrawnIds];" \n "                _actions set [_victim, format [""Final penalty: +%1"", _drawn]];" \n "                _state set [12, _actions];" \n "                _changedRoles pushBackUnique _victim;" \n "            };" \n "        };" \n "        private _names = _table getVariable [""PGS_UNOPlayerNames"", []];" \n "        [_table, _state, _role, format [""%1 wins UNO by shedding every card."", _names param [_role, name _unit]], _changedRoles] call PGS_fnc_unoFinishServer;" \n "        [_unit, _token, ""Card accepted. You won the UNO match.""] call PGS_fnc_resultServer;" \n "    };" \n "" \n "    if (_firstKind == 13) then {" \n "        _pendingAmount = (if (_pendingKind == 13) then {_pendingAmount} else {0}) + 2;" \n "        _pendingKind = 13;" \n "        _turn = [_role, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "    } else {" \n "        if (_firstKind == 15) then {" \n "            _pendingAmount = (if (_pendingKind == 15) then {_pendingAmount} else {0}) + 4;" \n "            _pendingKind = 15;" \n "            _turn = [_role, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "        } else {" \n "            _pendingKind = -1;" \n "            _pendingAmount = 0;" \n "            if (_firstKind == 11) then {" \n "                _turn = [_role, _direction, _activeFlags, 2] call PGS_fnc_unoGetNextActiveRole;" \n "            } else {" \n "                if (_firstKind == 12) then {" \n "                    if (([_activeFlags] call PGS_fnc_unoCountActiveRoles) == 2) then {" \n "                        _turn = _role;" \n "                    } else {" \n "                        _direction = -_direction;" \n "                        _turn = [_role, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "                    };" \n "                } else {" \n "                    _turn = [_role, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "                };" \n "            };" \n "        };" \n "    };" \n "    private _names = _table getVariable [""PGS_UNOPlayerNames"", []];" \n "    private _status = format [""%1 played %2.%3 %4 is next."", name _unit, _playedName, _unoText, _names param [_turn, ""Player""]];" \n "    if (_pendingAmount > 0) then {" \n "        _status = format [""%1 played %2. %3 must stack the same draw card or take +%4."", name _unit, _playedName, _names param [_turn, ""Player""], _pendingAmount];" \n "    };" \n "    _state set [2, _turn];" \n "    _state set [3, _direction];" \n "    _state set [9, _pendingKind];" \n "    _state set [10, _pendingAmount];" \n "    _state set [15, _status];" \n "    [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "    [_table, [_role]] call PGS_fnc_unoSendPrivateHandsServer;" \n "    [_unit, _token, ""UNO play accepted.""] call PGS_fnc_resultServer;" \n "};" \n "" \n "PGS_fnc_processPriorityUNORequestsServer = {" \n "    params [[""_players"", []]];" \n "    if (!isServer) exitWith {}; " \n " " \n "    {" \n "        private _unit = _x;" \n "        private _request = _unit getVariable [""PGS_UNOActionRequest"", []];" \n "        if ((typeName _request) == ""ARRAY"" && {(count _request) >= 6} && {(_request param [4, """"]) == ""UNO""}) then {" \n "            private _tableNetId = _request param [1, """"];" \n "            if ((typeName _tableNetId) == ""STRING"") then {" \n "                private _table = objectFromNetId _tableNetId;" \n "                if (!isNull _table && {_table getVariable [""PGS_UNOActive"", false]}) then {" \n "                    private _role = (_table getVariable [""PGS_UNOPlayers"", []]) find _unit;" \n "                    private _state = _table getVariable [""PGS_UNOSnapshotServer"", []];" \n "                    private _hands = _table getVariable [""PGS_UNOHandsServer"", []];" \n "                    if (" \n "                        _role >= 0" \n "                        && {(_state param [13, -1]) == _role}" \n "                        && {(count (_hands param [_role, []])) == 1}" \n "                    ) then {" \n "                        [_unit, +_request] call PGS_fnc_processUNOActionRequestServer;" \n "                    };" \n "                };" \n "            };" \n "        };" \n "    } forEach _players;" \n "" \n "    {" \n "        private _unit = _x;" \n "        private _request = _unit getVariable [""PGS_UNOActionRequest"", []];" \n "        if ((typeName _request) == ""ARRAY"" && {(count _request) >= 6} && {(_request param [4, """"]) == ""CALLOUT""}) then {" \n "            [_unit, +_request] call PGS_fnc_processUNOActionRequestServer;" \n "        };" \n "    } forEach _players;" \n "};" \n "" \n "PGS_fnc_processPlayerRequestsServer = {" \n "    params [[""_unit"", objNull]];" \n "    if (!isServer || {isNull _unit}) exitWith {};" \n "    private _join = _unit getVariable [""PGS_JoinRequest"", []];" \n "    if ((typeName _join) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_JoinRequest"", [], true];" \n "        _join = [];" \n "    } else {" \n "        _join = +_join;" \n "    };" \n "    if ((count _join) > 0) then {" \n "        [_unit, _join] call PGS_fnc_processJoinRequestServer;" \n "    };" \n "    private _leave = _unit getVariable [""PGS_LeaveRequest"", []];" \n "    if ((typeName _leave) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_LeaveRequest"", [], true];" \n "        _leave = [];" \n "    } else {" \n "        _leave = +_leave;" \n "    };" \n "    if ((count _leave) > 0) then {" \n "        [_unit, _leave] call PGS_fnc_processLeaveRequestServer;" \n "    };" \n "    private _vote = _unit getVariable [""PGS_VoteRequest"", []];" \n "    if ((typeName _vote) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_VoteRequest"", [], true];" \n "        _vote = [];" \n "    } else {" \n "        _vote = +_vote;" \n "    };" \n "    if ((count _vote) > 0) then {" \n "        [_unit, _vote] call PGS_fnc_processVoteRequestServer;" \n "    };" \n "    private _ready = _unit getVariable [""PGS_ReadyRequest"", []];" \n "    if ((typeName _ready) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_ReadyRequest"", [], true];" \n "        _ready = [];" \n "    } else {" \n "        _ready = +_ready;" \n "    };" \n "    if ((count _ready) > 0) then {" \n "        [_unit, _ready] call PGS_fnc_processReadyRequestServer;" \n "    };" \n "    private _battleshipAction = _unit getVariable [""PGS_BattleshipActionRequest"", []];" \n "    if ((typeName _battleshipAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_BattleshipActionRequest"", [], true];" \n "        _battleshipAction = [];" \n "    } else {" \n "        _battleshipAction = +_battleshipAction;" \n "    };" \n "    if ((count _battleshipAction) > 0) then {" \n "        [_unit, _battleshipAction] call PGS_fnc_processBattleshipActionRequestServer;" \n "    };" \n "    private _whosWhoAction = _unit getVariable [""PGS_WhosWhoActionRequest"", []];" \n "    if ((typeName _whosWhoAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_WhosWhoActionRequest"", [], true];" \n "        _whosWhoAction = [];" \n "    } else {" \n "        _whosWhoAction = +_whosWhoAction;" \n "    };" \n "    if ((count _whosWhoAction) > 0) then {" \n "        [_unit, _whosWhoAction] call PGS_fnc_processWhosWhoActionRequestServer;" \n "    };" \n "    private _shotgunAction = _unit getVariable [""PGS_ShotgunActionRequest"", []];" \n "    if ((typeName _shotgunAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_ShotgunActionRequest"", [], true];" \n "        _shotgunAction = [];" \n "    } else {" \n "        _shotgunAction = +_shotgunAction;" \n "    };" \n "    if ((count _shotgunAction) > 0) then {" \n "        [_unit, _shotgunAction] call PGS_fnc_processShotgunActionRequestServer;" \n "    };" \n "    private _rpsAction = _unit getVariable [""PGS_RPSActionRequest"", []];" \n "    if ((typeName _rpsAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_RPSActionRequest"", [], true];" \n "        _rpsAction = [];" \n "    } else {" \n "        _rpsAction = +_rpsAction;" \n "    };" \n "    if ((count _rpsAction) > 0) then {" \n "        [_unit, _rpsAction] call PGS_fnc_processRPSActionRequestServer;" \n "    };" \n "    private _blackjackAction = _unit getVariable [""PGS_BlackjackActionRequest"", []];" \n "    if ((typeName _blackjackAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_BlackjackActionRequest"", [], true];" \n "        _blackjackAction = [];" \n "    } else {" \n "        _blackjackAction = +_blackjackAction;" \n "    };" \n "    if ((count _blackjackAction) > 0) then {" \n "        [_unit, _blackjackAction] call PGS_fnc_processBlackjackActionRequestServer;" \n "    };" \n "    private _checkersMove = _unit getVariable [""PGS_CheckersMoveRequest"", []];" \n "    if ((typeName _checkersMove) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_CheckersMoveRequest"", [], true];" \n "        _checkersMove = [];" \n "    } else {" \n "        _checkersMove = +_checkersMove;" \n "    };" \n "    if ((count _checkersMove) > 0) then {" \n "        [_unit, _checkersMove] call PGS_fnc_processCheckersMoveRequestServer;" \n "    };" \n "    private _checkersReset = _unit getVariable [""PGS_CheckersResetRequest"", []];" \n "    if ((typeName _checkersReset) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_CheckersResetRequest"", [], true];" \n "        _checkersReset = [];" \n "    } else {" \n "        _checkersReset = +_checkersReset;" \n "    };" \n "    if ((count _checkersReset) > 0) then {" \n "        [_unit, _checkersReset] call PGS_fnc_processCheckersResetRequestServer;" \n "    };" \n "    private _chessMove = _unit getVariable [""PGS_ChessMoveRequest"", []];" \n "    if ((typeName _chessMove) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_ChessMoveRequest"", [], true];" \n "        _chessMove = [];" \n "    } else {" \n "        _chessMove = +_chessMove;" \n "    };" \n "    if ((count _chessMove) > 0) then {" \n "        [_unit, _chessMove] call PGS_fnc_processChessMoveRequestServer;" \n "    };" \n "    private _chessAction = _unit getVariable [""PGS_ChessActionRequest"", []];" \n "    if ((typeName _chessAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_ChessActionRequest"", [], true];" \n "        _chessAction = [];" \n "    } else {" \n "        _chessAction = +_chessAction;" \n "    };" \n "    if ((count _chessAction) > 0) then {" \n "        [_unit, _chessAction] call PGS_fnc_processChessActionRequestServer;" \n "    };" \n "    private _pokerAction = _unit getVariable [""PGS_PokerActionRequest"", []];" \n "    if ((typeName _pokerAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_PokerActionRequest"", [], true];" \n "        _pokerAction = [];" \n "    } else {" \n "        _pokerAction = +_pokerAction;" \n "    };" \n "    if ((count _pokerAction) > 0) then {" \n "        [_unit, _pokerAction] call PGS_fnc_processPokerActionRequestServer;" \n "    };" \n "    private _unoAction = _unit getVariable [""PGS_UNOActionRequest"", []];" \n "    if ((typeName _unoAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_UNOActionRequest"", [], true];" \n "        _unoAction = [];" \n "    } else {" \n "        _unoAction = +_unoAction;" \n "    };" \n "    if ((count _unoAction) > 0) then {" \n "        [_unit, _unoAction] call PGS_fnc_processUNOActionRequestServer;" \n "    };" \n "};" \n "" \n "PGS_fnc_initializeServerState = {" \n "    if (!isServer) exitWith {};" \n "    if (isNil {missionNamespace getVariable ""PGS_Tables""}) then {" \n "        missionNamespace setVariable [""PGS_Tables"", [], true];" \n "    };" \n "    if (isNil {missionNamespace getVariable ""PGS_HandledTokensServer""}) then {" \n "        missionNamespace setVariable [""PGS_HandledTokensServer"", []];" \n "    };" \n "};" \n "" \n "PGS_fnc_startAuthorityLoop = {" \n "    if (!isServer) exitWith {};" \n "    if (missionNamespace getVariable [""PGS_AuthorityLoopStarted"", false]) exitWith {};" \n "    missionNamespace setVariable [""PGS_AuthorityLoopStarted"", true];" \n "    [] spawn {" \n "        private _nextMaintenance = 0;" \n "        while {true} do {" \n "            private _authorityPlayers = +allPlayers;" \n "            {" \n "                [_x] call PGS_fnc_initializePlayerServer;" \n "            } forEach _authorityPlayers;" \n "            call PGS_fnc_reconcileRegisteredTablesServer;" \n "            [_authorityPlayers] call PGS_fnc_processPriorityUNORequestsServer;" \n "            {" \n "                [_x] call PGS_fnc_processPlayerRequestsServer;" \n "            } forEach _authorityPlayers;" \n "            if (serverTime >= _nextMaintenance) then {" \n "                call PGS_fnc_reconcileRegistriesServer;" \n "                _nextMaintenance = serverTime + PGS_CFG_MAINTENANCE_TICK;" \n "            };" \n "            sleep PGS_CFG_AUTHORITY_TICK;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_submitJoinRequestLocal = {" \n "    params [[""_table"", objNull]];" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    if (isNull _table) exitWith {" \n "        hintSilent ""That party table is unavailable."";" \n "    };" \n "    if (!alive player) exitWith {" \n "        hintSilent ""You must be alive to sit at the table."";" \n "    };" \n "    private _token = [""JOIN""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_JoinRequest""," \n "        [_token, netId _table, getPosATL player]," \n "        true" \n "    ];" \n "    hintSilent ""Requesting a seat from the table host..."";" \n "};" \n "" \n "PGS_fnc_submitLeaveRequestLocal = {" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    private _table = player getVariable [""PGS_SeatedTable"", objNull];" \n "    private _token = [""LEAVE""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_LeaveRequest""," \n "        [_token, if (isNull _table) then {""""} else {netId _table}]," \n "        true" \n "    ];" \n "    hintSilent ""Leaving the party table..."";" \n "};" \n "" \n "PGS_fnc_submitVoteRequestLocal = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_gameId"", """"]" \n "    ];" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    if (isNull _table || {_gameId == """"}) exitWith {" \n "        hintSilent ""Select an available game before voting."";" \n "    };" \n "    private _token = [""VOTE""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_VoteRequest""," \n "        [_token, netId _table, _gameId]," \n "        true" \n "    ];" \n "    hintSilent ""Submitting your table vote..."";" \n "};" \n "" \n "PGS_fnc_submitReadyRequestLocal = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_desired"", true]" \n "    ];" \n "    if (!hasInterface || {isNull player} || {isNull _table}) exitWith {};" \n "    private _token = [""READY""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_ReadyRequest""," \n "        [_token, netId _table, _desired]," \n "        true" \n "    ];" \n "    hintSilent ""Updating your ready state..."";" \n "};" \n "" \n "PGS_fnc_submitBattleshipActionRequestLocal = {" \n "    params [[""_table"", objNull], [""_action"", """"], [""_payload"", []]];" \n "    if (!hasInterface || {isNull player} || {isNull _table} || {_action == """"}) exitWith {false};" \n "    private _pending = missionNamespace getVariable [""PGS_BattleshipPendingRequestLocal"", []];" \n "    if ((count _pending) >= 2 && {(diag_tickTime - (_pending param [1, -10])) < 1.5}) exitWith {" \n "        hintSilent ""Waiting for the table host to answer your previous Battleship action..."";" \n "        false" \n "    };" \n "    private _token = [""BATTLESHIP_ACTION""] call PGS_fnc_makeToken;" \n "    missionNamespace setVariable [""PGS_BattleshipPendingRequestLocal"", [_token, diag_tickTime]];" \n "    player setVariable [" \n "        ""PGS_BattleshipActionRequest""," \n "        [" \n "            _token," \n "            netId _table," \n "            _table getVariable [""PGS_BattleshipGameId"", """"]," \n "            _table getVariable [""PGS_BattleshipRevision"", -1]," \n "            _action," \n "            _payload" \n "        ]," \n "        true" \n "    ];" \n "    true" \n "};" \n "" \n "PGS_fnc_submitRPSActionRequestLocal = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_action"", """"]," \n "        [""_payload"", """"]" \n "    ];" \n "    if (!hasInterface || {isNull player} || {isNull _table} || {_action == """"}) exitWith {false};" \n "    private _pending = missionNamespace getVariable [""PGS_RPSPendingRequestLocal"", []];" \n "    if ((count _pending) >= 2 && {(diag_tickTime - (_pending param [1, -10])) < 1.5}) exitWith {" \n "        hintSilent ""Waiting for the table host to answer your previous choice..."";" \n "        false" \n "    };" \n "    private _token = [""RPS_ACTION""] call PGS_fnc_makeToken;" \n "    missionNamespace setVariable [""PGS_RPSPendingRequestLocal"", [_token, diag_tickTime]];" \n "    player setVariable [" \n "        ""PGS_RPSActionRequest""," \n "        [" \n "            _token," \n "            netId _table," \n "            _table getVariable [""PGS_RPSGameId"", """"]," \n "            _table getVariable [""PGS_RPSEpoch"", -1]," \n "            _action," \n "            _payload" \n "        ]," \n "        2" \n "    ];" \n "    true" \n "};" \n "" \n "PGS_fnc_submitWhosWhoActionRequestLocal = {" \n "    params [[""_table"", objNull], [""_action"", """"], [""_payload"", -1]];" \n "    if (!hasInterface || {isNull player} || {isNull _table} || {_action == """"}) exitWith {false};" \n "    private _pending = missionNamespace getVariable [""P