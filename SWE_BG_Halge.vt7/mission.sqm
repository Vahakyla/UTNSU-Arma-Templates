 \n "        if (!isNull _host) then {" \n "            [_host, ""Composition"", ""COMPOSITION""] call PGS_fnc_markTableServer;" \n "        };" \n "        {" \n "            [_x] call PGS_fnc_initializePlayerServer;" \n "        } forEach allPlayers;" \n "        call PGS_fnc_reconcileRegistriesServer;" \n "        call PGS_fnc_startAuthorityLoop;" \n "    };" \n "    if (hasInterface) then {" \n "        call PGS_fnc_discoverTaggedTablesLocal;" \n "        call PGS_fnc_startClientLoop;" \n "    };" \n "    missionNamespace setVariable [""PGS_SystemInitialized"", true];" \n "};" \n "" \n "call PGS_fnc_bootstrap; " \n "}; " \n "[] call _PGS_Runtime; " \n "if (isMultiplayer) then { " \n "    [[], _PGS_Runtime] remoteExec [""spawn"", 0, ""PGS_PartyGamesRuntime_JIP""]; " \n "};";
