tureServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_checkersFinishForfeitServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_rpsFinishForfeitServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_blackjackHandleDepartureServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_chessFinishForfeitServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_pokerHandleDepartureServer;" \n "        [_table, _unit, _seatIndex] call PGS_fnc_unoHandleDepartureServer;" \n "        private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "        if (_seatIndex < 0 || {_seatIndex >= PGS_CFG_SEAT_COUNT} || {(_seats param [_seatIndex, objNull]) != _unit}) then {" \n "            _seatIndex = _seats find _unit;" \n "        };" \n "        if (_seatIndex >= 0 && {_seatIndex < PGS_CFG_SEAT_COUNT}) then {" \n "            private _votes = [(_table getVariable [""PGS_TableVotes"", []])] call PGS_fnc_normalizeVotes;" \n "            _seats set [_seatIndex, objNull];" \n "            _votes set [_seatIndex, """"];" \n "            _table setVariable [""PGS_TableSeats"", _seats, true];" \n "            _table setVariable [""PGS_TableVotes"", _votes, true];" \n "            _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "            [_table] call PGS_fnc_refreshTableConsensusServer;" \n "        };" \n "    };" \n "    [_unit] call PGS_fnc_clearUnitSeatVariablesServer;" \n "};" \n "" \n "PGS_fnc_initializePlayerServer = {" \n "    params [[""_unit"", objNull]];" \n "    if (!isServer || {isNull _unit}) exitWith {};" \n "    if (_unit getVariable [""PGS_ServerInitialized"", false]) exitWith {};" \n "    if (isNil {_unit getVariable ""PGS_SeatedTable""}) then {" \n "        _unit setVariable [""PGS_SeatedTable"", objNull, true];" \n "    };" \n "    if (isNil {_unit getVariable ""PGS_SeatIndex""}) then {" \n "        _unit setVariable [""PGS_SeatIndex"", -1, true];" \n "    };" \n "    if (isNil {_unit getVariable ""PGS_SeatToken""}) then {" \n "        _unit setVariable [""PGS_SeatToken"", """", true];" \n "    };" \n "    {" \n "        if (isNil {_unit getVariable _x}) then {" \n "            _unit setVariable [_x, [], true];" \n "        };" \n "    } forEach [" \n "        ""PGS_JoinRequest""," \n "        ""PGS_LeaveRequest""," \n "        ""PGS_VoteRequest""," \n "        ""PGS_ReadyRequest""," \n "        ""PGS_BattleshipActionRequest""," \n "        ""PGS_WhosWhoActionRequest""," \n "        ""PGS_ShotgunActionRequest""," \n "        ""PGS_CheckersMoveRequest""," \n "        ""PGS_CheckersResetRequest""," \n "        ""PGS_RPSActionRequest""," \n "        ""PGS_BlackjackActionRequest""," \n "        ""PGS_ChessMoveRequest""," \n "        ""PGS_ChessActionRequest""," \n "        ""PGS_PokerActionRequest""," \n "        ""PGS_UNOActionRequest""," \n "        ""PGS_RequestResult""" \n "    ];" \n "    _unit setVariable [""PGS_ServerInitialized"", true];" \n "};" \n "" \n "PGS_fnc_reconcileOneTableServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_enforceInvulnerableLocal;" \n "    [_table] call PGS_fnc_battleshipReconcilePlayersServer;" \n "    [_table] call PGS_fnc_whosWhoReconcilePlayersServer;" \n "    [_table] call PGS_fnc_shotgunReconcilePlayersServer;" \n "    [_table] call PGS_fnc_shotgunProgressServer;" \n "    [_table] call PGS_fnc_checkersReconcilePlayersServer;" \n "    [_table] call PGS_fnc_rpsReconcilePlayersServer;" \n "    [_table] call PGS_fnc_rpsProgressServer;" \n "    [_table] call PGS_fnc_blackjackReconcilePlayersServer;" \n "    [_table] call PGS_fnc_blackjackProgressServer;" \n "    [_table] call PGS_fnc_chessReconcilePlayersServer;" \n "    [_table] call PGS_fnc_pokerReconcilePlayersServer;" \n "    [_table] call PGS_fnc_unoReconcilePlayersServer;" \n "    private _originalSeats = _table getVariable [""PGS_TableSeats"", []];" \n "    private _originalVotes = _table getVariable [""PGS_TableVotes"", []];" \n "    private _originalReady = _table getVariable [""PGS_TableReady"", []];" \n "    private _originalOccupancy = _table getVariable [""PGS_TableOccupancy"", []];" \n "    private _seats = [_originalSeats] call PGS_fnc_normalizeSeats;" \n "    private _votes = [_originalVotes] call PGS_fnc_normalizeVotes;" \n "    private _ready = [_originalReady] call PGS_fnc_normalizeReady;" \n "    private _occupancy = [_originalOccupancy] call PGS_fnc_normalizeOccupancy;" \n "    private _changed = (typeName _originalSeats) != ""ARRAY""" \n "        || {(typeName _originalVotes) != ""ARRAY""}" \n "        || {(typeName _originalReady) != ""ARRAY""}" \n "        || {(typeName _originalOccupancy) != ""ARRAY""}" \n "        || {(count _originalSeats) != PGS_CFG_SEAT_COUNT}" \n "        || {(count _originalVotes) != PGS_CFG_SEAT_COUNT}" \n "        || {(count _originalReady) != PGS_CFG_SEAT_COUNT}" \n "        || {(count _originalOccupancy) != PGS_CFG_SEAT_COUNT};" \n "" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_index, objNull];" \n "        if (!isNull _unit) then {" \n "            private _valid = alive _unit" \n "                && {(lifeState _unit) != ""INCAPACITATED""}" \n "                && {_unit in allPlayers}" \n "                && {(vehicle _unit) == _unit}" \n "                && {(_unit getVariable [""PGS_SeatedTable"", objNull]) == _table}" \n "                && {(_unit getVariable [""PGS_SeatIndex"", -1]) == _index};" \n "            if (!_valid) then {" \n "                if ((_unit getVariable [""PGS_SeatedTable"", objNull]) == _table && {(_unit getVariable [""PGS_SeatIndex"", -1]) == _index}) then {" \n "                    [_unit] call PGS_fnc_clearUnitSeatVariablesServer;" \n "                };" \n "                _seats set [_index, objNull];" \n "                _votes set [_index, """"];" \n "                _occupancy set [_index, false];" \n "                _changed = true;" \n "            } else {" \n "                if (!(_occupancy param [_index, false])) then {" \n "                    _occupancy set [_index, true];" \n "                    _changed = true;" \n "                };" \n "            };" \n "        } else {" \n "            if ((_occupancy param [_index, false]) || {(_votes param [_index, """"]) != """"} || {_ready param [_index, false]}) then {" \n "                _changed = true;" \n "            };" \n "            _occupancy set [_index, false];" \n "            _votes set [_index, """"];" \n "            _ready set [_index, false];" \n "        };" \n "    };" \n "" \n "    if (_changed) then {" \n "        _table setVariable [""PGS_TableSeats"", _seats, true];" \n "        _table setVariable [""PGS_TableVotes"", _votes, true];" \n "        _table setVariable [""PGS_TableOccupancy"", _occupancy, true];" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        [_table] call PGS_fnc_refreshTableConsensusServer;" \n "    };" \n "};" \n "" \n "PGS_fnc_reconcileRegisteredTablesServer = {" \n "    if (!isServer) exitWith {};" \n "    private _published = +(missionNamespace getVariable [""PGS_Tables"", []]);" \n "    private _clean = [];" \n "    {" \n "        if (!isNull _x && {_x getVariable [""PGS_IsPartyTable"", false]}) then {" \n "            _clean pushBackUnique _x;" \n "            [_x] call PGS_fnc_reconcileOneTableServer;" \n "        };" \n "    } forEach _published;" \n "    if ((count _clean) != (count _published)) then {" \n "        missionNamespace setVariable [""PGS_Tables"", _clean, true];" \n "    };" \n "" \n "    {" \n "        private _unit = _x;" \n "        private _table = _unit getVariable [""PGS_SeatedTable"", objNull];" \n "        private _seatIndex = _unit getVariable [""PGS_SeatIndex"", -1];" \n "        private _valid = false;" \n "        if (!isNull _table && {_table getVariable [""PGS_IsPartyTable"", false]}) then {" \n "            private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "            _valid = _seatIndex >= 0" \n "                && {_seatIndex < PGS_CFG_SEAT_COUNT}" \n "                && {(_seats param [_seatIndex, objNull]) == _unit}" \n "                && {alive _unit}" \n "                && {(vehicle _unit) == _unit};" \n "        };" \n "        if (!_valid && {(!isNull _table) || {_seatIndex >= 0}}) then {" \n "            [_unit] call PGS_fnc_clearUnitSeatVariablesServer;" \n "        };" \n "    } forEach allPlayers;" \n "};" \n "" \n "PGS_fnc_reconcileRegistriesServer = {" \n "    if (!isServer) exitWith {};" \n "    private _tables = +(missionNamespace getVariable [""PGS_Tables"", []]);" \n "    private _seeded = [PGS_CFG_TABLE_CLASSES, ""PGS_CompositionSeed""] call PGS_fnc_collectTaggedClassObjects;" \n "    private _tagged = [PGS_CFG_TABLE_CLASSES, ""PGS_IsPartyTable""] call PGS_fnc_collectTaggedClassObjects;" \n "    {" \n "        if (!isNull _x) then {" \n "            if (!(_x getVariable [""PGS_IsPartyTable"", false])) then {" \n "                [_x, ""Composition"", ""COMPOSITION""] call PGS_fnc_markTableServer;" \n "            };" \n "            _tables pushBackUnique _x;" \n "        };" \n "    } forEach (_seeded + _tagged);" \n "    private _clean = [];" \n "    {" \n "        if (!isNull _x && {_x getVariable [""PGS_IsPartyTable"", false]}) then {" \n "            _clean pushBackUnique _x;" \n "        };" \n "    } forEach _tables;" \n "    missionNamespace setVariable [""PGS_Tables"", _clean, true];" \n "    call PGS_fnc_reconcileRegisteredTablesServer;" \n "    {" \n "        [_x] call PGS_fnc_registerCuratorEditableServer;" \n "    } forEach _clean;" \n "}; " \n " " \n "PGS_fnc_processJoinRequestServer = {" \n "    params [" \n "        [""_unit"", objNull]," \n "        [""_request"", []]" \n "    ];" \n "    if (!isServer || {isNull _