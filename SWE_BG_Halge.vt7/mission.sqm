l]" \n "                }" \n "            }" \n "        };" \n "        _handLabel ctrlSetText _handText;" \n "        _handLabel ctrlCommit 0;" \n "    };" \n "" \n "    private _foldButton = _display getVariable [""PGS_PokerFoldButton"", controlNull];" \n "    private _callButton = _display getVariable [""PGS_PokerCallButton"", controlNull];" \n "    private _allInButton = _display getVariable [""PGS_PokerAllInButton"", controlNull];" \n "    private _raiseButton = _display getVariable [""PGS_PokerRaiseButton"", controlNull];" \n "    private _raiseLabel = _display getVariable [""PGS_PokerRaiseLabel"", controlNull];" \n "    private _raiseTargetLabel = _display getVariable [""PGS_PokerRaiseTargetLabel"", controlNull];" \n "    private _adjustButtons = _display getVariable [""PGS_PokerAdjustButtons"", []];" \n "    private _revealButton = _display getVariable [""PGS_PokerRevealButton"", controlNull];" \n "    private _muckButton = _display getVariable [""PGS_PokerMuckButton"", controlNull];" \n "    private _nextButton = _display getVariable [""PGS_PokerNextButton"", controlNull];" \n "    private _yourStatus = if (_role >= 0) then {_statuses param [_role, ""OBSERVER""]} else {""OBSERVER""};" \n "    private _yourStack = if (_role >= 0) then {_chips param [_role, 0]} else {0};" \n "    private _yourBet = if (_role >= 0) then {_bets param [_role, 0]} else {0};" \n "    private _toCall = 0 max (_currentBet - _yourBet);" \n "    private _yourTurn = _betting && {_role == _turn} && {_yourStatus == ""ACTIVE""} && {_pending param [_role, false]};" \n "    private _actedAt = if (_role >= 0) then {_lastActed param [_role, -1]} else {-1};" \n "    private _reopenIncrement = if (_fullBetEstablished) then {_lastFullRaise} else {PGS_CFG_POKER_BIG_BLIND};" \n "    private _canRaise = _actedAt < 0 || {(_currentBet - _actedAt) >= _reopenIncrement};" \n "    private _minimumRaise = if (!_fullBetEstablished) then {PGS_CFG_POKER_BIG_BLIND} else {_currentBet + _lastFullRaise};" \n "    private _maximumRaise = _yourBet + _yourStack;" \n "    private _canFullRaise = _yourTurn && {_canRaise} && {_maximumRaise >= _minimumRaise} && {_maximumRaise > _currentBet};" \n "    private _raiseTarget = _display getVariable [""PGS_PokerRaiseTarget"", _minimumRaise];" \n "    if ((_display getVariable [""PGS_PokerRaiseRevision"", -1]) != _revision) then {" \n "        _raiseTarget = _minimumRaise min _maximumRaise;" \n "        _display setVariable [""PGS_PokerRaiseRevision"", _revision];" \n "    };" \n "    _raiseTarget = (_minimumRaise max _raiseTarget) min _maximumRaise;" \n "    _display setVariable [""PGS_PokerRaiseTarget"", _raiseTarget];" \n "    _display setVariable [""PGS_PokerRaiseMinimum"", _minimumRaise];" \n "    _display setVariable [""PGS_PokerRaiseMaximum"", _maximumRaise];" \n "    if (!isNull _foldButton) then {_foldButton ctrlShow (_betting && {!_spectating}); _foldButton ctrlEnable (!_spectating && {_yourTurn});};" \n "    if (!isNull _callButton) then {" \n "        _callButton ctrlShow (_betting && {!_spectating});" \n "        _callButton ctrlEnable (!_spectating && {_yourTurn});" \n "        _callButton ctrlSetText (if (_toCall <= 0) then {""Check""} else {format [""Call %1"", _yourStack min _toCall]});" \n "    };" \n "    if (!isNull _allInButton) then {" \n "        private _allInLegal = _yourTurn && {_yourStack > 0} && {(_maximumRaise <= _currentBet) || {_canRaise}};" \n "        _allInButton ctrlShow (_betting && {!_spectating});" \n "        _allInButton ctrlEnable (!_spectating && {_allInLegal});" \n "        _allInButton ctrlSetText format [""All In %1"", _yourStack];" \n "    };" \n "    if (!isNull _raiseButton) then {" \n "        _raiseButton ctrlShow (_betting && {!_spectating});" \n "        _raiseButton ctrlEnable (!_spectating && {_canFullRaise});" \n "        _raiseButton ctrlSetText format [""Raise %1"", _raiseTarget];" \n "    };" \n "    if (!isNull _raiseLabel) then {" \n "        _raiseLabel ctrlShow (_betting &&