;" \n "    private _table = _display getVariable [""PGS_CheckersTable"", objNull];" \n "    private _index = _control getVariable [""PGS_CheckersSquareIndex"", -1];" \n "    if (isNull _table || {_index < 0} || {_index > 63}) exitWith {};" \n "    if (([_table] call PGS_fnc_getTableActiveGameId) != ""checkers"") exitWith {" \n "        hintSilent ""That Checkers match is no longer active."";" \n "    };" \n "    if ((_table getVariable [""PGS_CheckersWinner"", 0]) != 0) exitWith {" \n "        hintSilent ""The match is finished. Reset it to return to the lobby."";" \n "    };" \n "    private _side = [_table] call PGS_fnc_getCheckersPlayerSideLocal;" \n "    if (_side == 0) exitWith {" \n "        hintSilent ""Only the two assigned players may move these pieces."";" \n "    };" \n "    if ((_table getVariable [""PGS_CheckersTurn"", 1]) != _side) exitWith {" \n "        hintSilent ""It is the other player's turn."";" \n "    };" \n "    if (_display getVariable [""PGS_CheckersMovePending"", false]) exitWith {" \n "        hintSilent ""Waiting for the table host to confirm your move..."";" \n "    };" \n "    private _revision = _table getVariable [""PGS_CheckersRevision"", 0];" \n "    private _board = [(_table getVariable [""PGS_CheckersBoard"", []])] call PGS_fnc_checkersNormalizeBoard;" \n "    private _forcedFrom = _table getVariable [""PGS_CheckersForcedFrom"", -1];" \n "    private _selected = _display getVariable [""PGS_CheckersSelectedFrom"", -1];" \n "    private _pieceSide = [_board param [_index, 0]] call PGS_fnc_checkersPieceSide;" \n "" \n "    if (_pieceSide == _side) exitWith {" \n "        if (_forcedFrom >= 0 && {_index != _forcedFrom}) then {" \n "            hintSilent ""Continue the capture chain with the highlighted piece."";" \n "        } else {" \n "            private _moves = [_board, _side, _index, _forcedFrom] call PGS_fnc_checkersGetLegalMoves;" \n "            if ((count _moves) <= 0) then {" \n "                if ([_board, _side] call PGS_fnc_checkersSideHasCapture) then {" \n "                    hintSilent ""Another piece has a compulsory capture."";" \n "                } else {" \n "                    hintSilent ""That piece has no legal move."";" \n "                };" \n "            } else {" \n "                _display setVariable [""PGS_CheckersSelectedFrom"", _index];" \n "                [_display] call PGS_fnc_refreshCheckersLocal;" \n "            };" \n "        };" \n "    };" \n "" \n "    if (_selected < 0) exitWith {" \n "        hintSilent ""Select one of your pieces first."";" \n "    };" \n "    private _legalMoves = [_board, _side, _selected, _forcedFrom] call PGS_fnc_checkersGetLegalMoves;" \n "    private _isLegal = false;" \n "    {" \n "        if ((_x param [0, -1]) == _index) exitWith {" \n "            _isLegal = true;" \n "        };" \n "    } forEach _legalMoves;" \n "    if (!_isLegal) exitWith {" \n "        hintSilent ""Choose one of the highlighted destination squares."";" \n "    };" \n "    _display setVariable [""PGS_CheckersMovePending"", true];" \n "    _display setVariable [""PGS_CheckersSelectedFrom"", -1];" \n "    [_table, _selected, _index, _revision] call PGS_fnc_submitCheckersMoveRequestLocal;" \n "};" \n "" \n "PGS_fnc_refreshCheckersLocal = {" \n "    disableSerialization;" \n "    params [[""_display"", displayNull]];" \n "    if (isNull _display) exitWith {};" \n "    if (_display getVariable [""PGS_CheckersRefreshing"", false]) exitWith {};" \n "    _display setVariable [""PGS_CheckersRefreshing"", true];" \n "    private _table = _display getVariable [""PGS_CheckersTable"", objNull];" \n "    private _spectating = _display getVariable [""PGS_SpectatorMode"", false];" \n "    if (!([_table, _spectating] call PGS_fnc_isValidGameViewerLocal)) exitWith {" \n "        _display closeDisplay 1;" \n "    };" \n "    if (([_table] call PGS_fnc_getTableActiveGameId) != ""checkers"") exitWith {" \n "        if (_spectating) then {" \n "            [true] call PGS_fnc_exitSpectatorLocal;" \n "        } else {" \n "            _display closeDisplay 1;" \n "            [_table] spawn {" \n "                params [""_lobbyTable""];" \n "                uiSleep 0.1;" \n "                if (!isNull _lobbyTable && {(_lobbyTable == (player getVariable [""PGS_SeatedTable"", objNull]))}) then {" \n "                    [_lobbyTable] call PGS_fnc_openLobbyLocal;" \n "                };" \n "            };" \n "        };" \n "    };" \n "" \n "    private _side = [_table] call PGS_fnc_getCheckersPlayerSideLocal;" \n "    private _board = [(_table getVariable [""PGS_CheckersBoard"", []])] call PGS_fnc_checkersNormalizeBoard;" \n "    private _turn = _table getVariable [""PGS_CheckersTurn"", 1];" \n "    private _forcedFrom = _table getVariable [""PGS_CheckersForcedFrom"", -1];" \n "    private _winner = _table getVariable [""PGS_CheckersWinner"", 0];" \n "    private _revision = _table getVariable [""PGS_CheckersRevision"", 0];" \n "    private _lastRevision = _display getVariable [""PGS_CheckersLastRevision"", -1];" \n "    private _selected = _display getVariable [""PGS_CheckersSelectedFrom"", -1];" \n "    if (_revision != _lastRevision) then {" \n "        _display setVariable [""PGS_CheckersMovePending"", false];" \n "        if (_forcedFrom >= 0 && {_turn == _side}) then {" \n "            _selected = _forcedFrom;" \n "        } else {" \n "            if (_selected >= 0 && {([_board param [_selected, 0]] call PGS_fnc_checkersPieceSide) != _side}) then {" \n "                _selected = -1;" \n "            };" \n "        };" \n "        _display setVariable [""PGS_CheckersSelectedFrom"", _selected];" \n "        private _captureSources = [];" \n "        if (_winner == 0) then {" \n "            if (_forcedFrom >= 0) then {" \n "                if ((count ([_board, _forcedFrom] call PGS_fnc_checkersGetCaptureMoves)) > 0) then {" \n "                    _captureSources pushBack _forcedFrom;" \n "                };" \n "            } else {" \n "                for ""_index"" from 0 to 63 do {" \n "                    if (" \n "                        ([_board param [_index, 0]] call PGS_fnc_checkersPieceSide) == _turn" \n "                        && {(count ([_board, _index] call PGS_fnc_checkersGetCaptureMoves)) > 0}" \n "                    ) then {" \n "                        _captureSources pushBack _index;" \n "                    };" \n "                };" \n "            };" \n "        };" \n "        _display setVariable [""PGS_CheckersCaptureSources"", _captureSources];" \n "        _display setVariable [""PGS_CheckersLastRevision"", _revision];" \n "    };" \n "    private _legalMoves = if (_selected >= 0 && {_turn == _side} && {_winner == 0}) then {" \n "        [_board, _side, _selected, _forcedFrom] call PGS_fnc_checkersGetLegalMoves" \n "    } else {" \n "        []" \n "    };" \n "    private _legalDestinations = [];" \n "    {" \n "        _legalDestinations pushBack (_x param [0, -1]);" \n "    } forEach _legalMoves;" \n "    private _captureSources = _display getVariable [""PGS_CheckersCaptureSources"", []];" \n "    private _lastMove = _table getVariable [""PGS_CheckersLastMove"", []];" \n "    private _lastFrom = _lastMove param [0, -1];" \n "    private _lastTo = _lastMove param [1, -1];" \n "    private _controls = _display getVariable [""PGS_CheckersSquareControls"", []];" \n "    {" \n "        private _control = _x;" \n "        if (!isNull _control) then {" \n "            private _index = _control getVariable [""PGS_CheckersSquareIndex"", -1];" \n "            private _row = floor (_index / 8);" \n "            private _column = _index mod 8;" \n "            private _dark = ((_row + _column) mod 2) == 1;" \n "            private _background = if (_dark) then {" \n "                [0.075, 0.085, 0.105, 1]" \n "            } else {" \n "                [0.78, 0.79, 0.74, 1]" \n "            };" \n "            if (_index == _lastFrom || {_index == _lastTo}) then {" \n "                _background = [0.22, 0.32, 0.40, 1];" \n "            };" \n "            if (_index in _captureSources) then {" \n "                _background = [0.68, 0.34, 0.06, 1];" \n "            };" \n "            if (_index == _selected) then {" \n "                _background = [0.88, 0.63, 0.12, 1];" \n "            };" \n "            if (_index in _legalDestinations) then {" \n "                _background = [0.16, 0.58, 0.30, 1];" \n "            };" \n "            _control ctrlSetBackgroundColor _background;" \n "            private _piece = _board param [_index, 0];" \n "            private _pieceText = """";" \n "            if (_piece != 0) then {" \n "                _pieceText = if ((abs _piece) == 2) then {""O+""} else {""O""};" \n "            };" \n "            _control ctrlSetText _pieceText;" \n "            _control ctrlSetTextColor (if (_piece > 0) then {" \n "                [0.18, 0.58, 1, 1]" \n "            } else {" \n "                if (_piece < 0) then {[1, 0.20, 0.16, 1]} else {[1, 1, 1, 1]}" \n "            });" \n "            _control ctrlSetTooltip (if (_piece == 0) then {" \n "                if (_index in _legalDestinations) then {""Legal destination""} else {""Empty square""}" \n "            } else {" \n "                if (_index in _captureSources) then {" \n "                    ""Compulsory capture available - select this piece""" \n "                } else {" \n "                    format [" \n "                        ""%1 %2""," \n "                        [[_piece] call PGS_fnc_checkersPieceSide] call PGS_fnc_checkersSideName," \n "                        if ((abs _piece) == 2) then {""king (+)""} else {""piece""}" \n "                    ]" \n "                }" \n "            });" \n "            _control ctrlCommit 0;" \n "        };" \n "    } forEach _controls;" \n "" \n "    private _names = _table getVariable [""PGS_CheckersPlayerNames"", [""NATO Blue"", ""OPFOR Red""]];" \n 