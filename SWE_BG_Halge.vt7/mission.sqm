_table setVariable [""PGS_BlackjackSnapshotServer"", _state];" \n "        [_table] call PGS_fnc_blackjackDealServer;" \n "    };" \n "    if (_phase == ""ROUND_END"" && {[_state] call PGS_fnc_blackjackAllNextReadyServer}) exitWith {" \n "        _table setVariable [""PGS_BlackjackSnapshotServer"", _state];" \n "        [_table, true] call PGS_fnc_blackjackPrepareBettingServer;" \n "    };" \n "    [_table, _state] call PGS_fnc_blackjackSetSnapshotServer;" \n "};" \n "" \n "PGS_fnc_blackjackReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_BlackjackActive"", false])) exitWith {};" \n "    private _players = _table getVariable [""PGS_BlackjackPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_BlackjackSeatIndices"", []];" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    for ""_role"" from 0 to ((count _players) - 1) do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seat = _seatIndices param [_role, -1];" \n "        private _valid = !isNull _unit" \n "            && {_seat >= 0}" \n "            && {_seat < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seat, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""}" \n "            && {(vehicle _unit) == _unit};" \n "        if (!_valid) then {" \n "            [_table, _unit, _seat] call PGS_fnc_blackjackHandleDepartureServer;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_unoCreateEmptySnapshot = {" \n "    [" \n "        ""IDLE"", -1, -1, 1, [], 0, 0, [], [], -1, 0, -1, [], -1, -1," \n "        ""Waiting for an UNO match."", [], [], 0, 0" \n "    ]" \n "};" \n "" \n "PGS_fnc_unoPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [" \n "        ""PGS_UNORevision""," \n "        (_table getVariable [""PGS_UNORevision"", 0]) + 1," \n "        true" \n "    ];" \n "    _table setVariable [" \n "        ""PGS_TableRevision""," \n "        (_table getVariable [""PGS_TableRevision"", 0]) + 1," \n "        true" \n "    ];" \n "};" \n "" \n "PGS_fnc_unoRefreshSnapshotCountsServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {_snapshot};" \n "    private _state = +_snapshot;" \n "    private _hands = _table getVariable [""PGS_UNOHandsServer"", []];" \n "    private _counts = [];" \n "    {" \n "        _counts pushBack (if ((typeName _x) == ""ARRAY"") then {count _x} else {0});" \n "    } forEach _hands;" \n "    _state set [6, count (_table getVariable [""PGS_UNODeckServer"", []])];" \n "    _state set [7, _counts];" \n "    _state set [16, +(_table getVariable [""PGS_UNOHandVersionsServer"", []])];" \n "    _state" \n "};" \n "" \n "PGS_fnc_unoSetSnapshotServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _state = [_table, _snapshot] call PGS_fnc_unoRefreshSnapshotCountsServer;" \n "    _table setVariable [""PGS_UNOSnapshotServer"", _state];" \n "    _table setVariable [""PGS_UNOSnapshot"", _state, true];" \n "    [_table] call PGS_fnc_unoPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_unoBumpHandVersionServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_role"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {_role < 0}) exitWith {-1};" \n "    private _versions = +(_table getVariable [""PGS_UNOHandVersionsServer"", []]);" \n "    if (_role >= (count _versions)) exitWith {-1};" \n "    private _version = (_versions param [_role, 0]) + 1;" \n "    _versions set [_role, _version];" \n "    _table setVariable [""PGS_UNOHandVersionsServer"", _versions];" \n "    _version" \n "};" \n "" \n "PGS_fnc_unoSendPrivateHandServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_role"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {_role < 0}) exitWith {};" \n "    private _players = _table getVariable [""PGS_UNOPlayers"", []];" \n "    if (_role >= (count _players)) exitWith {};" \n "    private _recipient = _players param [_role, objNull];" \n "    if (isNull _recipient) exitWith {};" \n "    private _hands = _table getVariable [""PGS_UNOHandsServer"", []];" \n "    private _versions = _table getVariable [""PGS_UNOHandVersionsServer"", []];" \n "    private _justDrawn = _table getVariable [""PGS_UNOJustDrawnIdsServer"", []];" \n "    private _payload = [" \n "        _table getVariable [""PGS_UNOGameId"", """"]," \n "        _versions param [_role, 0]," \n "        +(_hands param [_role, []])," \n "        _justDrawn param [_role, -1]" \n "    ];" \n "    _recipient setVariable [""PGS_UNOPrivateHand"", _payload, owner _recipient];" \n "};" \n "" \n "PGS_fnc_unoSendPrivateHandsServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_roles"", []]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    {" \n "        if ((typeName _x) == ""SCALAR"") then {" \n "            [_table, floor _x] call PGS_fnc_unoSendPrivateHandServer;" \n "        };" \n "    } forEach _roles;" \n "};" \n "" \n "PGS_fnc_unoClearPrivateHandsServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    {" \n "        if (!isNull _x) then {" \n "            _x setVariable [""PGS_UNOPrivateHand"", [], owner _x];" \n "        };" \n "    } forEach (_table getVariable [""PGS_UNOPlayers"", []]);" \n "};" \n "" \n "PGS_fnc_unoDrawCardsServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_role"", -1]," \n "        [""_requested"", 1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {_role < 0}) exitWith {[0, -1]};" \n "    private _hands = +(_table getVariable [""PGS_UNOHandsServer"", []]);" \n "    if (_role >= (count _hands)) exitWith {[0, -1]};" \n "    private _hand = +(_hands param [_role, []]);" \n "    private _deck = +(_table getVariable [""PGS_UNODeckServer"", []]);" \n "    private _discard = +(_table getVariable [""PGS_UNODiscardServer"", []]);" \n "    private _drawn = 0;" \n "    private _lastId = -1;" \n "    private _target = 0 max (floor _requested);" \n "    while {_drawn < _target} do {" \n "        if ((count _deck) <= 0 && {(count _discard) > 1}) then {" \n "            private _top = _discard deleteAt ((count _discard) - 1);" \n "            _deck = [_discard] call PGS_fnc_unoShuffleCardsServer;" \n "            _discard = [_top];" \n "        };" \n "        if ((count _deck) <= 0) exitWith {};" \n "        private _card = _deck deleteAt ((count _deck) - 1);" \n "        _hand pushBack _card;" \n "        _lastId = _card param [0, -1];" \n "        _drawn = _drawn + 1;" \n "    };" \n "    _hands set [_role, _hand];" \n "    _table setVariable [""PGS_UNOHandsServer"", _hands];" \n "    _table setVariable [""PGS_UNODeckServer"", _deck];" \n "    _table setVariable [""PGS_UNODiscardServer"", _discard];" \n "    if (_drawn > 0) then {[_table, _role] call PGS_fnc_unoBumpHandVersionServer;};" \n "    [_drawn, _lastId]" \n "};" \n "" \n "PGS_fnc_unoClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_unoClearPrivateHandsServer;" \n "    _table setVariable [""PGS_UNOActive"", false, true];" \n "    _table setVariable [""PGS_UNOFinished"", false, true];" \n "    _table setVariable [""PGS_UNOGameId"", """", true];" \n "    _table setVariable [""PGS_UNOPlayers"", [], true];" \n "    _table setVariable [""PGS_UNOPlayerNames"", [], true];" \n "    _table setVariable [""PGS_UNOSeatIndices"", [], true];" \n "    _table setVariable [""PGS_UNOHandsServer"", []];" \n "    _table setVariable [""PGS_UNODeckServer"", []];" \n "    _table setVariable [""PGS_UNODiscardServer"", []];" \n "    _table setVariable [""PGS_UNOHandVersionsServer"", []];" \n "    _table setVariable [""PGS_UNOJustDrawnIdsServer"", []];" \n "    private _snapshot = call PGS_fnc_unoCreateEmptySnapshot;" \n "    _table setVariable [""PGS_UNOSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_UNOSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_unoPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_unoStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""uno"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _seatIndices = [];" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_index, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _seatIndices pushBack _index;" \n "        };" \n "    };" \n "    private _playerCount = count _players;" \n "    if (_playerCount < 2 || {_playerCount > 4}) exitWith {false};" \n "" \n "    [_table] call PGS_fnc_unoClearPrivateHandsServer;" \n "    private _deck = call PGS_fnc_unoCreateShuffledDeckServer;" \n "    private _hands = [];" \n "    private _names = [];" \n "    private _statuses = [];" \n "    private _actions = [];" \n "    private _activeFlags = [];" \n "    private _versions = [];" \n "    private _justDrawn = [];" \n "    private _armed = [];" \n "    for ""_role"" from 0 to (_playerCount - 1) do {" \n "        _hands pushBack [];" \n "        _names pushBack (name (_players param [_role, objNull]));" \n "        _statuses pushBack ""ACTIVE"";" \n "        _actions pushBack ""Ready"";" \n "        _activeFlags pushBack true;" \n "        _versions pushBack 1;" \n "        _justDrawn pushBack -1;" \n "        _armed pushBack false;" \n "    };" \n "    for ""_round"" from 1 to PGS_CFG_UNO_STARTING_CARDS do {" \n "        for ""_role"" from 0 to (_playerCount - 1) do {" \n "            private _hand = +(_hands param [_role, []]);" \n "            _hand pushBack (_deck deleteAt ((count _deck) - 1));" \n "            _hands set [_role, _hand];" \n "        };" \n "    };" \n "" \n "    private _deferredWilds = [];" \n "    private _topCard = [];" \n "    while {(count _deck) > 0 && {(count _topCard) <= 0}} do {" \n "        private _candidate = _deck deleteAt ((count _deck) - 1);" \n "        if ((_candidate param [2, -1]) in [14, 15]) then {" \n "            _deferredWilds pushBack _candidate;" \n "        } else {" \n "            _topCard = _candidate;" \n "        };" \n "    };" \n "    _deck append _deferredWilds;" \n "    _deck = [_deck] call PGS_fnc_unoShuffleCardsServer;" \n "    if ((count _topCard) <= 0) exitWith {false};" \n "" \n "    private _dealer = floor (random _playerCount);" \n "    private _direction = 1;" \n "    private _turn = [_dealer, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "    private _pendingKind = -1;" \n "    private _pendingAmount = 0;" \n "    private _topKind = _topCard param [2, -1];" \n "    private _status = format [" \n "        ""%1 begins in ascending player order. %2 is on the discard pile.""," \n "        _names param [_turn, ""Player""]," \n "        [_topCard] call PGS_fnc_unoCardName" \n "    ];" \n "    if (_topKind == 11) then {" \n "        private _skipped = _turn;" \n "        _turn = [_turn, _direction, _activeFlags, 1] call PGS