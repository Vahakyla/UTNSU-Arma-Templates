        _state set [15, format [""The draw pile is empty, but %1 still has a legal play."", name _unit]];" \n "                        _state set [17, _armed];" \n "                        _state set [18, 0];" \n "                        [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "                        [_unit, _token, ""The pile is empty, but you hold a playable card. Play it to continue.""] call PGS_fnc_resultServer;" \n "                    } else {" \n "                        private _noProgress = (_state param [18, 0]) + 1;" \n "                        _turn = [_role, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "                        _actions set [_role, ""No card available""];" \n "                        _state set [2, _turn];" \n "                        _state set [11, -1];" \n "                        _state set [12, _actions];" \n "                        _state set [15, format [""The pile could not produce a card and %1 has no legal play. The turn advances."", name _unit]];" \n "                        _state set [17, _armed];" \n "                        _state set [18, _noProgress];" \n "                        _state set [19, (_state param [19, 0]) + 1];" \n "                        if (_noProgress >= ([_activeFlags] call PGS_fnc_unoCountActiveRoles)) then {" \n "                            [_table, _state, -1, ""UNO ends in a draw: no drawable or playable cards remain."", []] call PGS_fnc_unoFinishServer;" \n "                        } else {" \n "                            [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "                        };" \n "                        [_unit, _token, ""No card was available and you had no legal play; your turn passed.""] call PGS_fnc_resultServer;" \n "                    };" \n "                } else {" \n "                    _hands = +(_table getVariable [""PGS_UNOHandsServer"", []]);" \n "                    _hand = +(_hands param [_role, []]);" \n "                    private _drawnCard = [];" \n "                    {" \n "                        if ((_x param [0, -2]) == _drawnId) exitWith {_drawnCard = _x;};" \n "                    } forEach _hand;" \n "                    private _playable = [_drawnCard, _hand, _state param [4, []], _state param [5, -1], -1] call PGS_fnc_unoCanPlayFromHand;" \n "                    _justDrawnIds = +(_table getVariable [""PGS_UNOJustDrawnIdsServer"", []]);" \n "                    if (_playable) then {" \n "                        _justDrawnIds set [_role, _drawnId];" \n "                        _state set [11, _role];" \n "                        _actions set [_role, ""Drew a playable card""];" \n "                        _state set [15, format [""%1 drew one card and may play only that card, or Pass."", name _unit]];" \n "                    } else {" \n "                        _justDrawnIds set [_role, -1];" \n "                        _turn = [_role, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "                        _state set [2, _turn];" \n "                        _state set [11, -1];" \n "                        _actions set [_role, ""Drew and passed""];" \n "                        _state set [15, format [""%1 drew an unplayable card. The turn advances."", name _unit]];" \n "                    };" \n "                    _table setVariable [""PGS_UNOJustDrawnIdsServer"", _justDrawnIds];" \n "                    _state set [12, _actions];" \n "                    _state set [17, _armed];" \n "                    _state set [18, 0];" \n "                    _state set [19, (_state param [19, 0]) + 1];" \n "                    [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "                    [_table, [_role]] call PGS_fnc_unoSendPrivateHandsServer;" \n "                    [_unit, _token, if (_playable) then {""Card drawn. Play that card or press Pass.""} else {""Card drawn; it was not playable, so your turn passed.""}] call PGS_fnc