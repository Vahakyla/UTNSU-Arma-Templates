									side="Empty";
									flags=4;
									class Attributes
									{
										init="private _PGS_Runtime = { " \n "private _pgsCompositionHost = if (isNil ""this"") then {objNull} else {this};" \n "private _pgsStoredHost = missionNamespace getVariable [""PGS_CompositionHostObject"", objNull];" \n "if (!isNull _pgsCompositionHost) then {" \n "    missionNamespace setVariable [""PGS_CompositionHostObject"", _pgsCompositionHost];" \n "    if (local _pgsCompositionHost) then {" \n "        _pgsCompositionHost allowDamage false;" \n "    };" \n "    _pgsCompositionHost setVariable [""PGS_CompositionSeed"", true, true];" \n "} else {" \n "    if (isNull _pgsStoredHost) then {" \n "        missionNamespace setVariable [""PGS_CompositionHostObject"", objNull];" \n "    };" \n "};" \n "" \n "PGS_Version = ""1.5.0"";" \n "" \n "private _pgsRuntimeKey = missionNamespace getVariable [""PGS_RuntimeKeyLocal"", []];" \n "private _pgsRuntimeVersion = _pgsRuntimeKey param [0, """"];" \n "private _pgsRuntimeHost = _pgsRuntimeKey param [1, objNull];" \n "private _pgsDuplicateRuntime = (_pgsRuntimeVersion == PGS_Version) && {" \n "    isNull _pgsCompositionHost || {_pgsRuntimeHost == _pgsCompositionHost}" \n "};" \n "if (_pgsDuplicateRuntime) exitWith {};" \n "missionNamespace setVariable [""PGS_RuntimeKeyLocal"", [PGS_Version, _pgsCompositionHost]]; " \n " " \n "PGS_Games = [" \n "    [" \n "        ""battleship""," \n "        ""Battleship""," \n "        [" \n "            ""Deploy a hidden fleet, call coordinates and trade shots.""," \n "            ""Find and sink all five opposing ships before yours disappear.""" \n "        ]," \n "        2," \n "        2," \n "        [" \n "            ""Playable: private 10x10 fleets, placement previews and rotation.""," \n "            ""Alternating shots, misses, hits, sunk ships and safe spectators.""" \n "        ]" \n "    ]," \n "    [" \n "        ""whoswho""," \n "        ""Who's Who: Vehicles""," \n "        [" \n "            ""Ask questions aloud and eliminate vehicle suspects.""," \n "            ""Guess the opponent's hidden vehicle before they find yours.""" \n "        ]," \n "        2," \n "        2," \n "        [" \n "            ""Playable: 48 vanilla vehicle previews and private targets.""," \n "            ""Local red-X notes, alternating turns, guesses and spectators.""" \n "        ]" \n "    ]," \n "    [" \n "        ""shotgun""," \n "        ""Shotgun Roulette""," \n "        [" \n "            ""Read the shell ledger, use items and choose where to aim.""," \n "            ""Last player with lives remaining wins the table.""" \n "        ]," \n "        2," \n "        4," \n "        [" \n "            ""Playable: hidden chamber, self-shots, targeting and six items.""," \n "            ""Three lives each; empty loads preserve lives and carried items.""" \n "        ]" \n "    ]," \n "    [" \n "        ""blackjack""," \n "        ""Blackjack""," \n "        [" \n "            ""Challenge the automated dealer without passing 21.""," \n "            ""Playable alone or with up to three fellow gamblers.""" \n "        ]," \n "        1," \n "        4," \n "        [" \n "            ""Playable: even bets, Hit, Stand, Double and 3:2 Blackjack.""," \n "            ""Dealer stands on soft 17; no splits, insurance or surrender.""" \n "        ]" \n "    ]," \n "    [" \n "        ""poker""," \n "        ""Poker""," \n "        [" \n "            ""Read the table and manage the pot.""," \n "            ""Conceal good hands; bluff responsibly.""" \n "        ]," \n "        2," \n "        4," \n "        [" \n "            ""Playable no-limit Hold'em with blinds, side pots and all-ins.""," \n "            ""Start with 100 chips; survive the table to win.""" \n "        ]" \n "    ]," \n "    [" \n "        ""chess""," \n "        ""Chess""," \n "        [" \n "            ""A two-player strategy duel.""," \n "            ""Plan ahead while Zeus plans the mission.""" \n "        ]," \n "        2," \n "        2," \n "        [" \n "            ""Playable: check, castling, en passant and promotion.""," \n "            ""Marker-icon armies turn the table into a command board.""" \n "        ]" \n "    ]," \n "    [" \n "        ""checkers""," \n "        ""Checkers""," \n "        [" \n "            ""A quick duel of diagonals and captures.""," \n "            ""Reach the far side and earn a king.""" \n "        ]," \n "        2," \n "        2," \n "        [" \n "            ""Playable: compulsory captures and chained jumps.""," \n "            ""Blue moves first; reach the far rank to earn a king.""" \n "        ]" \n "    ]," \n "    [" \n "        ""rps""," \n "        ""Rock Paper Scissors""," \n "        [" \n "            ""Lock a choice, then face the reveal together.""," \n "            ""A quick two-player contest with no hidden arithmetic.""" \n "        ]," \n "        2," \n "        2," \n "        [" \n "            ""Playable: simultaneous hidden choices and a reveal countdown.""," \n "            ""First to two round wins takes the best-of-three match; draws replay.""" \n "        ]" \n "    ]," \n "    [" \n "        ""uno""," \n "        ""UNO""," \n "        [" \n "            ""Shed cards quickly with two to four players.""," \n "            ""Ideal for short, preventable arguments.""" \n "        ]," \n "        2," \n "        4," \n "        [" \n "            ""Playable: paged private hands, stacking and draw chains.""," \n "            ""Call UNO before one card remains, or risk a callout.""" \n "        ]" \n "    ]" \n "];" \n "" \n "PGS_CFG_TABLE_CLASSES = [" \n "    ""Land_CampingTable_F""," \n "    ""Land_CampingTable_small_F""," \n "    ""Land_CampingTable_small_white_F""," \n "    ""Land_TablePlastic_01_F""" \n "];" \n "PGS_CFG_SEAT_COUNT = 4;" \n "PGS_CFG_SEAT_OFFSETS = [" \n "    [0, -1.05, 0]," \n "    [0, 1.05, 0]," \n "    [-1.35, 0, 0]," \n "    [1.35, 0, 0]" \n "];" \n "PGS_CFG_SEAT_EXIT_OFFSETS = [" \n "    [0, -1.85, 0]," \n "    [0, 1.85, 0]," \n "    [-2.05, 0, 0]," \n "    [2.05, 0, 0]" \n "];" \n "PGS_CFG_SEAT_DIRECTIONS = [0, 180, 90, 270];" \n "PGS_CFG_SEATED_ANIMATION = ""HubSittingChairA_idle1"";" \n "PGS_CFG_ACTION_RANGE = 4.5;" \n "PGS_CFG_PERSONAL_ACTION_RANGE = 2;" \n "PGS_CFG_REQUEST_RANGE = 6;" \n "PGS_CFG_AUTHORITY_TICK = 0.5;" \n "PGS_CFG_CLIENT_TICK = 0.5;" \n "PGS_CFG_DISCOVERY_TICK = 10;" \n "PGS_CFG_MAINTENANCE_TICK = 10;" \n "PGS_CFG_CHECKERS_UI_TICK = 0.15;" \n "PGS_CFG_RPS_UI_TICK = 0.10;" \n "PGS_CFG_RPS_COUNTDOWN_SECONDS = 3;" \n "PGS_CFG_RPS_REVEAL_SECONDS = 3.5;" \n "PGS_CFG_SHOTGUN_UI_TICK = 0.10;" \n "PGS_CFG_SHOTGUN_STARTING_LIVES = 3;" \n "PGS_CFG_SHOTGUN_MAX_LIVES = 5;" \n "PGS_CFG_SHOTGUN_MIN_SHELLS = 2;" \n "PGS_CFG_SHOTGUN_MAX_SHELLS = 8;" \n "PGS_CFG_SHOTGUN_ITEMS_PER_LOAD = 2;" \n "PGS_CFG_SHOTGUN_INVENTORY_LIMIT = 4;" \n "PGS_CFG_SHOTGUN_REVEAL_SECONDS = 1.6;" \n "PGS_CFG_SHOTGUN_LOAD_REVEAL_SECONDS = 4.0;" \n "PGS_CFG_SHOTGUN_UI_SCALE = 1.18;" \n "PGS_CFG_SHOTGUN_UI_CENTER = [0.590, 0.5425];" \n "PGS_CFG_WHOSWHO_UI_TICK = 0.15;" \n "PGS_CFG_WHOSWHO_PER_FACTION = 12;" \n "PGS_CFG_BLACKJACK_UI_TICK = 0.15;" \n "PGS_CFG_BLACKJACK_STARTING_CHIPS = 100;" \n "PGS_CFG_BLACKJACK_MINIMUM_BET = 2;" \n "PGS_CFG_BLACKJACK_DECKS = 6;" \n "PGS_CFG_BLACKJACK_CUT_REMAINING = 52;" \n "PGS_CFG_BLACKJACK_DEALER_STEP_SECONDS = 1;" \n "PGS_CFG_BLACKJACK_CARD_SLOTS = 8;" \n "PGS_CFG_CHESS_UI_TICK = 0.15;" \n "PGS_CFG_POKER_UI_TICK = 0.15;" \n "PGS_CFG_POKER_STARTING_CHIPS = 100;" \n "PGS_CFG_POKER_SMALL_BLIND = 1;" \n "PGS_CFG_POKER_BIG_BLIND = 2;" \n "PGS_CFG_POKER_UI_SCALE = 1.25;" \n "PGS_CFG_POKER_UI_CENTER = [0.590, 0.5425];" \n "PGS_CFG_UNO_UI_TICK = 0.15;" \n "PGS_CFG_UNO_HAND_PAGE_SIZE = 10;" \n "PGS_CFG_UNO_STARTING_CARDS = 7;" \n "PGS_CFG_UNO_CALLOUT_PENALTY = 2;" \n "PGS_CFG_BATTLESHIP_UI_TICK = 0.15;" \n "PGS_CFG_BATTLESHIP_GRID_SIZE = 10;" \n "PGS_CFG_BATTLESHIP_BUTTON_FONT = 0.054;" \n "PGS_CFG_BATTLESHIP_SHIPS = [" \n "    [""Carrier"", 5]," \n "    [""Battleship"", 4]," \n "    [""Cruiser"", 3]," \n "    [""Submarine"", 3]," \n "    [""Destroyer"", 2]" \n "]; " \n " " \n "PGS_fnc_getGame = {" \n "    params [[""_gameId"", """"]];" \n "    private _game = [];" \n "    {" \n "        if ((_x param [0, """"]) == _gameId) exitWith {" \n "            _game = +_x;" \n "        };" \n "    } forEach PGS_Games;" \n "    _game" \n "};" \n "" \n "PGS_fnc_getGameName = {" \n "    params [[""_gameId"", """"]];" \n "    private _game = [_gameId] call PGS_fnc_getGame;" \n "    _game param [1, ""No vote""]" \n "};" \n "" \n "PGS_fnc_getPlayerRequirementText = {" \n "    params [[""_game"", []]];" \n "    if ((count _game) < 5) exitWith {""Unknown player requirement""};" \n "    private _minimum = _game param [3, 2];" \n "    private _maximum = _game param [4, 4];" \n "    if (_minimum == _maximum) exitWith {" \n "        format [""Exactly %1 players"", _minimum]" \n "    };" \n "    format [""%1-%2 players"", _minimum, _maximum]" \n "};" \n "" \n "PGS_fnc_normalizeSeats = {" \n "    params [[""_source"", []]];" \n "    if ((typeName _source) != ""ARRAY"") then {" \n "        _source = [];" \n "    };" \n "    private _result = [objNull, objNull, objNull, objNull];" \n "    private _limit = (count _source) min PGS_CFG_SEAT_COUNT;" \n "    if (_limit > 0) then {" \n "        for ""_index"" from 0 to (_limit - 1) do {" \n "            private _value = _source param [_index, objNull];" \n "            if ((typeName _value) == ""OBJECT"") then {" \n "                _result set [_index, _value];" \n "            };" \n "        };" \n "    };" \n "    _result" \n "};" \n "" \n "PGS_fnc_normalizeVotes = {" \n "    params [[""_source"", []]];" \n "    if ((typeName _source) != ""ARRAY"") then {" \n "        _source = [];" \n "    };" \n "    private _result = ["""", """", """", """"];" \n "    private _limit = (count _source) min PGS_CFG_SEAT_COUNT;" \n "    if (_limit > 0) then {" \n "        for ""_index"" from 0 to (_limit - 1) do {" \n "            private _value = _source