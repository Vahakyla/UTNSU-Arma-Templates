 "    _table setVariable [""PGS_UNOSeatIndices"", [], true];" \n "    _table setVariable [""PGS_UNOHandsServer"", []];" \n "    _table setVariable [""PGS_UNODeckServer"", []];" \n "    _table setVariable [""PGS_UNODiscardServer"", []];" \n "    _table setVariable [""PGS_UNOHandVersionsServer"", []];" \n "    _table setVariable [""PGS_UNOJustDrawnIdsServer"", []];" \n "    private _snapshot = call PGS_fnc_unoCreateEmptySnapshot;" \n "    _table setVariable [""PGS_UNOSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_UNOSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_unoPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_unoStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""uno"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _seatIndices = [];" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_index, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _seatIndices pushBack _index;" \n "        };" \n "    };" \n "    private _playerCount = count _players;" \n "    if (_playerCount < 2 || {_playerCount > 4}) exitWith {false};" \n "" \n "    [_table] call PGS_fnc_unoClearPrivateHandsServer;" \n "    private _deck = call PGS_fnc_unoCreateShuffledDeckServer;" \n "    private _hands = [];" \n "    private _names = [];" \n "    private _statuses = [];" \n "    private _actions = [];" \n "    private _activeFlags = [];" \n "    private _versions = [];" \n "    private _justDrawn = [];" \n "    private _armed = [];" \n "    for ""_role"" from 0 to (_playerCount - 1) do {" \n "        _hands pushBack [];" \n "        _names pushBack (name (_players param [_role, objNull]));" \n "        _statuses pushBack ""ACTIVE"";" \n "        _actions pushBack ""Ready"";" \n "        _activeFlags pushBack true;" \n "        _versions pushBack 1;" \n "        _justDrawn pushBack -1;" \n "        _armed pushBack false;" \n "    };" \n "    for ""_round"" from 1 to PGS_CFG_UNO_STARTING_CARDS do {" \n "        for ""_role"" from 0 to (_playerCount - 1) do {" \n "            private _hand = +(_hands param [_role, []]);" \n "            _hand pushBack (_deck deleteAt ((count _deck) - 1));" \n "            _hands set [_role, _hand];" \n "        };" \n "    };" \n "" \n "    private _deferredWilds = [];" \n "    private _topCard = [];" \n "    while {(count _deck) > 0 && {(count _topCard) <= 0}} do {" \n "        private _candidate = _deck deleteAt ((count _deck) - 1);" \n "        if ((_candidate param [2, -1]) in [14, 15]) then {" \n "            _deferredWilds pushBack _candidate;" \n "        } else {" \n "            _topCard = _candidate;" \n "        };" \n "    };" \n "    _deck append _deferredWilds;" \n "    _deck = [_deck] call PGS_fnc_unoShuffleCardsServer;" \n "    if ((count _topCard) <= 0) exitWith {false};" \n "" \n "    private _dealer = floor (random _playerCount);" \n "    private _direction = 1;" \n "    private _turn = [_dealer, _direction, _activeFlags, 1] call PGS_fnc_unoGetNextActiveRole;" \n "    private _pendingKind = -1;" \n "    private _pendingAmount = 0;" \n "    private _topKind = _topCard param [2, -1];" \n "    private _status = format [" \n "        ""%1 begins in ascending player order. %2 is on the discard pile.""," \n "        _names param [_turn, ""Player""]," \n "        [_topCard] call PGS_fnc_unoCardName" \n "    ];" \n "    if (_topKind == 11) then {" \n "        private _skipped = _turn;" \n "        _turn = [_turn, _direction, _activeFlags, 1] call PGS