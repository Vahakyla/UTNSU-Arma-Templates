 \n "    _resetButton ctrlSetPosition [0.385, 0.900, 0.310, 0.075];" \n "    _resetButton ctrlSetText ""Return to Lobby"";" \n "    _resetButton ctrlSetBackgroundColor [0.28, 0.17, 0.08, 1];" \n "    _resetButton ctrlSetFontHeight 0.024;" \n "    _resetButton setVariable [""PGS_BlackjackAction"", ""RESET""];" \n "    _resetButton ctrlAddEventHandler [""ButtonClick"", {params [""_control""]; [_control] call PGS_fnc_submitBlackjackButtonLocal;}];" \n "    _resetButton ctrlCommit 0;" \n "    private _rulesLabel = _display ctrlCreate [""RscText"", -1];" \n "    _rulesLabel ctrlSetPosition [0.050, 0.995, 1.080, 0.042];" \n "    _rulesLabel ctrlSetText ""EVEN BETS  /  BLACKJACK PAYS 3:2  /  DEALER STANDS ON SOFT 17  /  HIT, STAND OR DOUBLE  /  NO SPLITS"";" \n "    _rulesLabel ctrlSetTextColor [0.56, 0.69, 0.64, 1];" \n "    _rulesLabel ctrlSetFontHeight 0.019;" \n "    _rulesLabel ctrlCommit 0;" \n "" \n "    _display setVariable [""PGS_BlackjackRoundLabel"", _roundLabel];" \n "    _display setVariable [""PGS_BlackjackShoeLabel"", _shoeLabel];" \n "    _display setVariable [""PGS_BlackjackDealerTotalLabel"", _dealerTotalLabel];" \n "    _display setVariable [""PGS_BlackjackStatusLabel"", _statusLabel];" \n "    _display setVariable [""PGS_BlackjackStatusLabelTwo"", _statusLabelTwo];" \n "    _display setVariable [""PGS_BlackjackDealerCards"", _dealerCards];" \n "    _display setVariable [""PGS_BlackjackDealerOverflow"", _dealerOverflow];" \n "    _display setVariable [""PGS_BlackjackPlayerRows"", _playerRows];" \n "    _display setVariable [""PGS_BlackjackBetLabel"", _betLabel];" \n "    _display setVariable [""PGS_BlackjackBetButton"", _betButton];" \n "    _display setVariable [""PGS_BlackjackAdjustButtons"", _adjustButtons];" \n "    _display setVariable [""PGS_BlackjackHitButton"", _hitButton];" \n "    _display setVariable [""PGS_BlackjackStandButton"", _standButton];" \n "    _display setVariable [""PGS_BlackjackDoubleButton"", _doubleButton];" \n "    _display setVariable [""PGS_BlackjackNextButton"", _nextButton];" \n "    _display setVariable [""PGS_BlackjackResetButton"", _resetButton];" \n "    [_display] call PGS_fnc_refreshBlackjackLocal;" \n "    [_display] spawn {" \n "        disableSerialization;" \n "        params [""_activeDisplay""];" \n "        while {!isNull _activeDisplay} do {" \n "            [_activeDisplay] call PGS_fnc_refreshBlackjackLocal;" \n "            uiSleep PGS_CFG_BLACKJACK_UI_TICK;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_getRPSRoleLocal = {" \n "    params [[""_table"", objNull]];" \n "    if (isNull _table || {isNull player}) exitWith {-1};" \n "    (_table getVariable [""PGS_RPSPlayers"", [objNull, objNull]]) find player" \n "};" \n "" \n "PGS_fnc_handleRPSChoiceClickLocal = {" \n "    disableSerialization;" \n "    params [[""_control"", controlNull]];" \n "    if (isNull _control) exitWith {};" \n "    private _display = ctrlParent _control;" \n "    if (isNull _display || {_display getVariable [""PGS_SpectatorMode"", false]}) exitWith {};" \n "    private _table = _display getVariable [""PGS_RPSTable"", objNull];" \n "    private _choice = _control getVariable [""PGS_RPSChoice"", """"];" \n "    if (_choice == """" || {isNull _table}) exitWith {};" \n "    if ([_table, ""CHOOSE"", _choice] call PGS_fnc_submitRPSActionRequestLocal) then {" \n "        _display setVariable [""PGS_RPSLocalChoice"", _choice];" \n "        [_display] call PGS_fnc_refreshRPSLocal;" \n "    };" \n "};" \n "" \n "PGS_fnc_handleRPSResetClickLocal = {" \n "    disableSerialization;" \n "    params [[""_control"", controlNull]];" \n "    if (isNull _control) exitWith {};" \n "    private _display = ctrlParent _control;" \n "    private _table = _display getVariable [""PGS_RPSTable"", objNull];" \n "    [_table, ""RESET"", """"] call PGS_fnc_submitRPSActionRequestLocal;" \n "};" \n "" \n "PGS_fnc_refreshRPSLocal = {" \n "    disableSerialization;" \n "    params [[""_display"", displayNull]];" \n "    if (isNull _display) exitWith {};" \n "    if (_display getVariable [""PGS_RPSRefreshing"", false]) exitWith {};" \n "    _display setVariable [""PGS_RPSRefreshing"", true];" \n "    private _table = _display getVariable [""PGS_RPSTable"", objNull];" \n "    private _spectating = _display getVariable [""PGS_SpectatorMode"", false];" \n "    if (" \n "        isNull _table" \n "        || {!([_table, _spectating] call PGS_fnc_isValidGameViewerLocal)}" \n "        || {([_table] call PGS_fnc_getTableActiveGameId) != ""rps""}" \n "    ) exitWith {" \n "        _display closeDisplay 1;" \n "    };" \n "" \n "    private _players = _table getVariable [""PGS_RPSPlayers"", [objNull, objNull]];" \n "    private _names = _table getVariable [""PGS_RPSPlayerNames"", [""Player One"", ""Player Two""]];" \n "    private _scores = _table getVariable [""PGS_RPSScores"", [0, 0]];" \n "    private _locked = _table getVariable [""PGS_RPSLocked"", [false, false]];" \n "    private _revealed = _table getVariable [""PGS_RPSRevealedChoices"", ["""", """"]];" \n "    private _phase = _table getVariable [""PGS_RPSPhase"", ""CHOOSING""];" \n "    private _round = _table getVariable [""PGS_RPSRound"", 1];" \n "    private _roundWinner = _table getVariable [""PGS_RPSRoundWinner"", -2];" \n "    private _winner = _table getVariable [""PGS_RPSWinner"", -1];" \n "    private _finished = _table getVariable [""PGS_RPSFinished"", false];" \n "    private _epoch = _table getVariable [""PGS_RPSEpoch"", 0];" \n "    private _role = if (_spectating) then {-1} else {_players find player};" \n "    private _lastEpoch = _display getVariable [""PGS_RPSLastEpoch"", -1];" \n "    if (_epoch != _lastEpoch) then {" \n "        _display setVariable [""PGS_RPSLastEpoch"", _epoch];" \n "        _display setVariable [""PGS_RPSLocalChoice"", """"];" \n "    };" \n "    private _localChoice = _display getVariable [""PGS_RPSLocalChoice"", """"];" \n "" \n "    private _nameControls = _display getVariable [""PGS_RPSNameControls"", []];" \n "    private _scoreControls = _display getVariable [""PGS_RPSScoreControls"", []];" \n "    private _choiceControls = _display getVariable [""PGS_RPSChoiceControls"", []];" \n "    private _panelControls = _display getVariable [""PGS_RPSPanelControls"", []];" \n "    for ""_index"" from 0 to 1 do {" \n "        private _nameControl = _nameControls param [_index, controlNull];" \n "        private _scoreControl = _scoreControls param [_index, controlNull];" \n "        private _choiceControl = _choiceControls param [_index, controlNull];" \n "        private _panelControl = _panelControls param [_index, controlNull];" \n "        if (!isNull _nameControl) then {" \n "            _nameControl ctrlSetText format [""%1%2"", _names param [_index, format [""Player %1"", _index + 1]], if (_role == _index) then {""  /  YOU""} else {""""}];" \n "            _nameControl ctrlCommit 0;" \n "        };" \n "        if (!isNull _scoreControl) then {" \n "            _scoreControl ctrlSetText format [""ROUND WINS  %1 / 2"", _scores param [_index, 0]];" \n "            _scoreControl ctrlCommit 0;" \n "        };" \n "        private _word = ""CHOOSING"";" \n "        if (_phase in [""REVEAL"", ""FINISHED""]) then {" \n "            _word = _revealed param [_index, """"];" \n "            if (_word == """") then {_word = ""NO REVEAL"";};" \n "        } else {" \n "            if (_locked param [_index, false]) then {" \n "                _word = if (!_spectating && {_role == _index} && {_localChoice != """"}) then {_localChoice} else {""LOCKED""};" \n "            };" \n "        };" \n "        if (!isNull _choiceControl) then {" \n "            _choiceControl ctrlSetText _word;" \n "            _choiceControl ctrlSetTextColor (if (_word in [""LOCKED"", ""CHOOSING""]) then {[0.72, 0.78, 0.84, 1]} else {[1, 1, 1, 1]});" \n "            _choiceControl ctrlCommit 0;" \n "        };" \n "        if (!isNull _panelControl) then {" \n "            private _panelColour = if (_index == 0) then {[0.035, 0.125, 0.225, 1]} else {[0.235, 0.055, 0.055, 1]};" \n "            if (_phase in [""REVEAL"", ""FINISHED""] && {_roundWinner == _index}) then {" \n "                _panelColour = [0.075, 0.31, 0.15, 1];" \n "            };" \n "            _panelControl ctrlSetBackgroundColor _panelColour;" \n "            _panelControl ctrlCommit 0;" \n "        };" \n "    };" \n "" \n "    private _roundLabel = _display getVariable [""PGS_RPSRoundLabel"", controlNull];" \n "    private _phaseLabel = _display getVariable [""PGS_RPSPhaseLabel"", controlNull];" \n "    private _statusLabel = _display getVariable [""PGS_RPSStatusLabel"", controlNull];" \n "    private _instructionLabel = _display getVariable [""PGS_RPSInstructionLabel"", controlNull];" \n "    if (!isNull _roundLabel) then {" \n "        _roundLabel ctrlSetText format [""ROUND %1  /  FIRST TO TWO"", _round];" \n "        _roundLabel ctrlCommit 0;" \n "    };" \n "    private _phaseText = ""MAKE YOUR CHOICE"";" \n "    if (_phase == ""COUNTDOWN"") then {" \n "        private _remaining = ceil (((_table getVariable [""PGS_RPSCountdownEnd"", 0]) - serverTime) max 0);" \n "        _phaseText = format [""REVEAL IN %1"", _remaining];" \n "    };" \n "    if (_phase == ""REVEAL"") then {_phaseText = ""REVEAL"";};" \n "    if (_phase == ""FINISHED"") then {_phaseText = ""MATCH COMPLETE"";};" \n "    if (_phase == ""CHOOSING"" && {_spectating}) then {_phaseText = ""PLAYERS ARE CHOOSING"";};" \n "    if (_phase == ""CHOOSING"" && {_role >= 0} && {_locked param [_role, false]}) then {_phaseText = ""WAITING FOR OPPONENT"";};" \n "    if (!isNull _phaseLabel) then {" \n "        _phaseLabel ctrlSetText _phaseText;" \n "        _phaseLabel ctrlSetTextColor (if (_phase == ""COUNTDOWN"") then {[1, 0.82, 0.28, 1]} else {[0.88, 0.94, 1, 1]});" \n "        _phaseLabel ctrlCommit 0;" \n "    };" \n "    if (!isNull _statusLabel) then {" \n "        _statusLabel ctrlSetText (_table getVariable [""PGS_RPSStatus"", ""Rock Paper Scissors in progress.""]);" \n "        _statusLabel ctrlCommit 0;" \n "    };" \n "    if (!isNull _instructionLabel) then {" \n "        _instructionLabel ctrlSetText (if (_spectating) then {" \n "            ""Spectator view keeps both choices hidden until the shared reveal.""" \n "        } else {" \n "            if (_phase == ""CHOOSING"") then {""Choose once. Your opponent sees only LOCKED until the countdown ends.""} else {""Rock beats Scissors. Scissors beats Paper. Paper beats Rock.""}" \n "        });" \n "        _instructionLabel ctrlCommit 0;" \n "    };" \n "" \n "    private _choiceButtons = _display getVariable [""PGS_RPSChoiceButtons"", []];" \n "    private _canChoose = !_spectating" \n "        && {_role >= 0}" \n "        && {!_finished}" \n "        && {_phase == ""CHOOSING""}" \n "        && {!(_locked param [_role, false])};" \n "    {" \n "        if (!isNull _x) then {" \n "            _x ctrlShow !_spectating;" \n "            _x ctrlEnable _canChoose;" \n "            _x ctrlCommit 0;" \n "        };" \n "    } forEach _choiceButtons;" \n "    private _resetButton = _display getVariable [""PGS_RPSResetButton"", controlNull];" \n "    if (!isNull _resetButton) then {" \n "        _resetButton ctrlShow (!_spectating && {_finished});" \n "        _resetButton ctrlEnable (!_spectating && {_finished} && {_winner >= 0});" \n "        _resetButton ctrlCommit 0;" \n "    };" \n "    _display setVariable [""PGS_RPSRefreshing"", false];" \n "};" \n "" \n "PGS_fnc_openRPSLocal = {" \n "    disableSerialization;" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_spectating"", false]" \n "    ];" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    if (" \n "        isNull _table" \n "        || {!([_table, _spectating] call PGS_fnc_isValidGameViewerLocal)}" \n "        || {([_table] call PGS_fnc_getTableActiveGameId) != ""rps""}" \n "    ) exitWith {" \n "        hintSilent ""No active