   };" \n "    if (!_selectionValid) exitWith {" \n "        [_unit, _token, ""Only exact duplicate numbered cards may be played together.""] call PGS_fnc_resultServer;" \n "    };" \n "    if (" \n "        _drawnRole == _role" \n "        && {" \n "            (count _cardIds) != 1" \n "            || {(_cardIds param [0, -2]) != (_justDrawnIds param [_role, -1])}" \n "        }" \n "    ) exitWith {" \n "        [_unit, _token, ""After drawing, you may play only the newly drawn card.""] call PGS_fnc_resultServer;" \n "    };" \n "    if (!([_firstCard, _state param [4, []], _state param [5, -1], _pendingKind] call PGS_fnc_unoCanPlayCard)) exitWith {" \n "        [_unit, _token, if (_pendingKind == 13) then {""A +2 chain accepts only another +2.""} else {if (_pendingKind == 15) then {""A +4 chain accepts only another +4.""} else {""That card does not match the active colour or symbol.""}}] call PGS_fnc_resultServer;" \n "    };" \n "    if (!([_firstCard, _hand, _state param [4, []], _state param [5, -1], _pendingKind] call PGS_fnc_unoCanPlayFromHand)) exitWith {" \n "        [_unit, _token, ""+4 is legal only when you hold no card of the active colour.""] call PGS_fnc_resultServer;" \n "    };" \n "    if (_firstKind in [14, 15] && {!(_chosenColour in [0, 1, 2, 3])}) exitWith {" \n "        [_unit, _token, ""Choose Red, Blue, Green, or Yellow for the Wild card.""] call PGS_fnc_resultServer;" \n "    };" \n "    _selectedIndexes sort false;" \n "    {" \n "        _hand deleteAt _x;" \n "    } forEach _selectedIndexes;" \n "    _hands set [_role, _hand];" \n "    _table setVariable [""PGS_UNOHandsServer"", _hands];" \n "    [_table, _role] call PGS_fnc_unoBumpHandVersionServer;" \n "    _justDrawnIds set [_role, -1];" \n "    _table setVariable [""PGS_UNOJustDrawnIdsServer"", _justDrawnIds];" \n "    private _discard = +(_table getVariable [""PGS_UNODiscardServer"", []]);" \n "    {_discard pushBack _x;} forEach _selectedCards;" \n "    _table setVariable [""PGS_U