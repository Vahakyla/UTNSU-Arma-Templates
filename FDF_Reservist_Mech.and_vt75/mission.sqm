   private _guessButton = _display ctrlCreate [""RscButtonMenu"", -1];" \n "    _guessButton ctrlSetPosition ([0.030, 0.888, 0.200, 0.050] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _guessButton ctrlSetText ""MAKE A GUESS"";" \n "    _guessButton ctrlSetFontHeight 0.025;" \n "    _guessButton ctrlAddEventHandler [""ButtonClick"", {params [""_control""]; [_control] call PGS_fnc_handleWhosWhoGuessButtonLocal;}];" \n "    _guessButton ctrlCommit 0;" \n "    private _passButton = _display ctrlCreate [""RscButtonMenu"", -1];" \n "    _passButton ctrlSetPosition ([0.245, 0.888, 0.170, 0.050] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _passButton ctrlSetText ""PASS TURN"";" \n "    _passButton ctrlSetFontHeight 0.025;" \n "    _passButton setVariable [""PGS_WhosWhoAction"", ""PASS""];" \n "    _passButton ctrlAddEventHandler [""ButtonClick"", {params [""_control""]; [_control] call PGS_fnc_handleWhosWhoActionButtonLocal;}];" \n "    _passButton ctrlCommit 0;" \n "    private _resetButton = _display ctrlCreate [""RscButtonMenu"", -1];" \n "    _resetButton ctrlSetPosition ([0.030, 0.888, 0.260, 0.050] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _resetButton ctrlSetText ""RETURN TO LOBBY"";" \n "    _resetButton ctrlSetFontHeight 0.025;" \n "    _resetButton setVariable [""PGS_WhosWhoAction"", ""RESET""];" \n "    _resetButton ctrlAddEventHandler [""ButtonClick"", {params [""_control""]; [_control] call PGS_fnc_handleWhosWhoActionButtonLocal;}];" \n "    _resetButton ctrlCommit 0;" \n "    private _helpLabel = _display ctrlCreate [""RscText"", -1];" \n "    _helpLabel ctrlSetPosition ([0.430, 0.884, 0.540, 0.054] call PGS_fnc_whosWhoSafePositionLocal);" \n "    _helpLabel ctrlSetTextColor [0.60, 0.72, 0.78, 1];" \n "    _helpLabel ctrlSetFontHeight 0.019;" \n "    _helpLabel ctrlCommit 0;" \n "    private _ruleLabel = _display ctrlCreate [""RscText"", -1];" \n "    _ruleLabel ctrlSetPosition ([0.030, 0.948, 0.940, 0.026] call PGS_fnc_whosWhoSafePositionLocal