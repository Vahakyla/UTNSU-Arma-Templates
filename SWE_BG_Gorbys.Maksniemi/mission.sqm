Card, _activeColour, _pendingKind] call PGS_fnc_unoCanPlayCard;" \n "    if (!_legal) exitWith {false};" \n "    if ((_card param [2, -1]) == 15 && {_pendingKind != 15}) then {" \n "        {" \n "            if (" \n "                (_x param [1, 4]) == _activeColour" \n "                && {!((_x param [2, -1]) in [14, 15])}" \n "            ) then {" \n "                _legal = false;" \n "            };" \n "        } forEach _hand;" \n "    };" \n "    _legal" \n "};" \n "" \n "PGS_fnc_unoCountActiveRoles = {" \n "    params [[""_activeFlags"", []]];" \n "    private _count = 0;" \n "    {" \n "        if ((typeName _x) == ""BOOL"" && {_x}) then {_count = _count + 1;};" \n "    } forEach _activeFlags;" \n "    _count" \n "};" \n "" \n "PGS_fnc_unoGetNextActiveRole = {" \n "    params [" \n "        [""_start"", -1]," \n "        [""_direction"", 1]," \n "        [""_activeFlags"", []]," \n "        [""_steps"", 1]" \n "    ];" \n "    private _count = count _activeFlags;" \n "    if (_count <= 0 || {([_activeFlags] call PGS_fnc_unoCountActiveRoles) <= 0}) exitWith {-1};" \n "    _direction = if (_direction < 0) then {-1} else {1};" \n "    _steps = 1 max (floor _steps);" \n "    private _cursor = _start;" \n "    private _moved = 0;" \n "    private _guard = 0;" \n "    while {_moved < _steps && {_guard < (_count * (_steps + 1))}} do {" \n "        _cursor = (_cursor + _direction) mod _count;" \n "        if (_cursor < 0) then {_cursor = _cursor + _count;};" \n "        if (_activeFlags param [_cursor, false]) then {_moved = _moved + 1;};" \n "        _guard = _guard + 1;" \n "    };" \n "    if (_moved == _steps) then {_cursor} else {-1}" \n "}; " \n " " \n "PGS_fnc_battleshipShipName = {" \n "    params [[""_shipIndex"", -1]];" \n "    (PGS_CFG_BATTLESHIP_SHIPS param [_shipIndex, [""Ship"", 0]]) param [0, ""Ship""]" \n "};" \n "" \n "PGS_fnc_battleshipShipLength = {" \n "    params [[""_shipIndex"", -1]];" \n "    (PGS_CFG_BATTLESHIP_SHIPS param [_shipIndex, [""Ship"", 0]]) param [1, 0]" \n "};" \n "" \n "PGS_fnc_battleshipCellLabel = {" \n "    params [[""_cell"", -1]];" \n "    private _grid = PGS_CFG_BATTLESHIP_GRID_SIZE;" \n "    if ((typeName _cell) != ""SCALAR"" || {_cell != floor _cell} || {_cell < 0} || {_cell >= (_grid * _grid)}) exitWith {""?""};" \n "    private _letters = [""A"", ""B"", ""C"", ""D"", ""E"", ""F"", ""G"", ""H"", ""I"", ""J""];" \n "    format [""%1%2"", _letters param [_cell mod _grid, ""?""], (floor (_cell / _grid)) + 1]" \n "};" \n "" \n "PGS_fnc_battleshipCreateEmptyFleet = {" \n "    private _fleet = [];" \n "    {" \n "        _fleet pushBack [];" \n "    } forEach PGS_CFG_BATTLESHIP_SHIPS;" \n "    _fleet" \n "};" \n "" \n "PGS_fnc_battleshipCopyFleet = {" \n "    params [[""_fleet"", []]];" \n "    private _copy = [];" \n "    {" \n "        _copy pushBack (+_x);" \n "    } forEach _fleet;" \n "    _copy" \n "};" \n "" \n "PGS_fnc_battleshipCopyFleets = {" \n "    params [[""_fleets"", []]];" \n "    private _copy = [];" \n "    {" \n "        _copy pushBack ([_x] call PGS_fnc_battleshipCopyFleet);" \n "    } forEach _fleets;" \n "    _copy" \n "};" \n "" \n "PGS_fnc_battleshipGetPlacementCells = {" \n "    params [" \n "        [""_origin"", -1]," \n "        [""_length"", 0]," \n "        [""_orientation"", 0]" \n "    ];" \n "    private _grid = PGS_CFG_BATTLESHIP_GRID_SIZE;" \n "    if (" \n "        (typeName _origin) != ""SCALAR""" \n "        || {(typeName _length) != ""SCALAR""}" \n "        || {(typeName _orientation) != ""SCALAR""}" \n "        || {_origin != floor _origin}" \n "        || {_origin < 0}" \n "        || {_origin >= (_grid * _grid)}" \n "        || {_length != floor _length}" \n "        || {_length <= 0}" \n "        || {!(_orientation in [0, 1])}" \n "    ) exitWith {[]};" \n "    private _row = floor (_origin / _grid);" \n "    private _column = _origin mod _grid;" \n "    if (_orientation == 0 && {(_column + _length) > _grid}) exitWith {[]};" \n "    if (_orientation == 1 && {(_row + _length) > _grid}) exitWith {[]};" \n "    private _cells = [];" \n "    for ""_offset"" from 0 to (_length - 1) do {" \n "        _cells pushBack (_origin + (if (_orientation == 0) then {_offset} else {_offset * _grid}));" \n "    };" \n "    _cells" \n "};" \n "" \n "PGS_fnc_battleshipFleetComplete = {" \n "    params [[""_fleet"", []]];" \n "    if ((count _fleet) != (count PGS_CFG_BATTLESHIP_SHIPS)) exitWith {false};" \n "    private _complete = true;" \n "    for ""_shipIndex"" from 0 to ((count PGS_CFG_BATTLESHIP_SHIPS) - 1) do {" \n "        if ((count (_fleet param [_shipIndex, []])) != ([_shipIndex] call PGS_fnc_battleshipShipLength)) then {" \n "            _complete = false;" \n "        };" \n "    };" \n "    _complete" \n "}; " \n " " \n "PGS_fnc_resultServer = {" \n "    params [" \n "        [""_unit"", objNull]," \n "        [""_token"", """"]," \n "        [""_message"", """"]" \n "    ];" \n "    if (!isServer || {isNull _unit} || {_token == """"}) exitWith {};" \n "    _unit setVariable [""PGS_RequestResult"", [_token, _message], true];" \n "};" \n "" \n "PGS_fnc_rememberHandledTokenServer = {" \n "    params [[""_token"", """"]];" \n "    if (!isServer) exitWith {false};" \n "    if (_token == """" || {(typeName _token) != ""STRING""}) exitWith {false};" \n "    private _handled = +(missionNamespace getVariable [""PGS_HandledTokensServer"", []]);" \n "    if (_token in _handled) exitWith {false};" \n "    _handled pushBack _token;" \n "    while {(count _handled) > 256} do {" \n "        _handled deleteAt 0;" \n "    };" \n "    missionNamespace setVariable [""PGS_HandledTokensServer"", _handled];" \n "    true" \n "};" \n "" \n "PGS_fnc_getKnownCuratorsServer = {" \n "    private _curators = [];" \n "    if (!isServer) exitWith {_curators};" \n "    {" \n "        if (!isNull _x) then {" \n "            _curators pushBackUnique _x;" \n "        };" \n "    } forEach allCurators;" \n "    _curators" \n "};" \n "" \n "PGS_fnc_registerCuratorEditableServer = {" \n "    params [[""_object"", objNull]];" \n "    if (!isServer || {isNull _object}) exitWith {};" \n "    {" \n "        _x addCuratorEditableObjects [[_object], true];" \n "    } forEach (call PGS_fnc_getKnownCuratorsServer);" \n "};" \n "" \n "PGS_fnc_checkersPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [" \n "        ""PGS_CheckersRevision""," \n "        (_table getVariable [""PGS_CheckersRevision"", 0]) + 1," \n "        true" \n "    ];" \n "    _table setVariable [" \n "        ""PGS_TableRevision""," \n "        (_table getVariable [""PGS_TableRevision"", 0]) + 1," \n "        true" \n "    ];" \n "};" \n "" \n "PGS_fnc_checkersClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_CheckersActive"", false, true];" \n "    _table setVariable [""PGS_CheckersGameId"", """", true];" \n "    _table setVariable [""PGS_CheckersPlayers"", [objNull, objNull], true];" \n "    _table setVariable [""PGS_CheckersPlayerNames"", [""NATO Blue"", ""OPFOR Red""], true];" \n "    _table setVariable [""PGS_CheckersSeatIndices"", [-1, -1], true];" \n "    _table setVariable [""PGS_CheckersBoard"", [], true];" \n "    _table setVariable [""PGS_CheckersTurn"", 1, true];" \n "    _table setVariable [""PGS_CheckersForcedFrom"", -1, true];" \n "    _table setVariable [""PGS_CheckersWinner"", 0, true];" \n "    _table setVariable [""PGS_CheckersMoveNumber"", 0, true];" \n "    _table setVariable [""PGS_CheckersLastMove"", [], true];" \n "    _table setVariable [""PGS_CheckersStatus"", ""Waiting for a Checkers match."", true];" \n "    [_table] call PGS_fnc_checkersPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_checkersStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""checkers"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _seatIndices = [];" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_index, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _seatIndices pushBack _index;" \n "        };" \n "    };" \n "    if ((count _players) != 2) exitWith {false};" \n "    private _blue = _players param [0, objNull];" \n "    private _red = _players param [1, objNull];" \n "    if (isNull _blue || {isNull _red}) exitWith {false};" \n "    _table setVariable [""PGS_CheckersActive"", true, true];" \n "    _table setVariable [" \n "        ""PGS_CheckersGameId""," \n "        format [""PGS_CHECKERS_%1_%2"", floor (serverTime * 10), floor (random 1000000)]," \n "        true" \n "    ];" \n "    _table setVariable [""PGS_CheckersPlayers"", [_blue, _red], true];" \n "    _table setVariable [""PGS_CheckersPlayerNames"", [name _blue, name _red], true];" \n "    _table setVariable [""PGS_CheckersSeatIndices"", _seatIndices, true];" \n "    _table setVariable [""PGS_CheckersBoard"", call PGS_fnc_checkersCreateBoard, true];" \n "    _table setVariable [""PGS_CheckersTurn"", 1, true];" \n "    _table setVariable [""PGS_CheckersForcedFrom"", -1, true];" \n "    _table setVariable [""PGS_CheckersWinner"", 0, true];" \n "    _table setVariable [""PGS_CheckersMoveNumber"", 0, true];" \n "    _table setVariable [""PGS_CheckersLastMove"", [], true];" \n "    _table setVariable [""PGS_CheckersStatus"", format [""%1 has the first move as NATO Blue."", name _blue], true];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table] call PGS_fnc_checkersPublishRevisionServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_checkersFinishForfeitServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_departingUnit"", objNull]," \n "        [""_departingSeat"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_CheckersActive"", false])) exitWith {};" \n "    if ((_table getVariable [""PGS_CheckersWinner"", 0]) != 0) exitWith {};" \n "    private _players = _table getVariable [""PGS_CheckersPlayers"", [objNull, objNull]];" \n "    private _seatIndices = _table getVariable [""PGS_CheckersSeatIndices"", [-1, -1]];" \n "    private _names = _table getVariable [""PGS_CheckersPlayerNames"", [""NATO Blue"", ""OPFOR Red""]];" \n "    private _roleIndex = -1;" \n "    if (!isNull _departingUnit) then {" \n "        _roleIndex = _players find _departingUnit;" \n "    };" \n "    if (_roleIndex < 0 && {_departingSeat >= 0}) then {" \n "        _roleIndex = _seatIndices find _departingSeat;" \n "    };" \n "    if (_roleIndex < 0) exitWith {};" \n "    private _losingSide = if (_roleIndex == 0) then {1} else {-1};" \n "    private _winner = -_losingSide;" \n "    private _winnerName = _names param [if (_winner > 0) then {0} else {1}, ""Opponent""];" \n "    private _loserName = _names param [_roleIndex, ""Opponent""];" \n "    _table setVariable [""PGS_CheckersWinner"", _winner, true];" \n "    _table setVariable [""PGS_CheckersForcedFrom"", -1, true];" \n "    _table setVariable [""PGS_CheckersStatus"", format [""%1 wins by forfeit after %2 left the table."", _winnerName, _loserName], true];" \n "    _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "    [_table] call PGS_fnc_checkersPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_checkersReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_CheckersActive"", false])) exitWith {};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = _table getVariable [""PGS_CheckersPlayers"", [objNull, objNull]];" \n "    private _seatIndices = _table getVariable [""PGS_CheckersSeatIndices"", [-1, -1]];" \n "    private _valid = [false, false];" \n "    for ""_role"" from 0 to 1 do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seatIndex = _seatIndices param [_role, -1];" \n "        private _isValid = !isNull _unit" \n "            && {_seatIndex >= 0}" \n "            && {_seatIndex < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seatIndex, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""};" \n "        _valid set [_role, _isValid];" \n "    };" \n "    if ((_table getVariable [""PGS_CheckersWinner"", 0]) == 0) then {" \n "        if (!(_valid param [0, false]) && {!(_valid param [1, false])}) then {" \n "            [_table] call PGS_fnc_checkersClearServer;" \n "            _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "            _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "        } else {" \n "            if (!(_valid param [0, false])) then {" \n "                [_table, objNull, _seatIndices param [0, -1]] call PGS_fnc_checkersFinishForfeitServer;" \n "            } else {" \n "                if (!(_valid param [1, false])) then {" \n "                    [_table, objNull, _seatIndices param [1, -1]] call PGS_fnc_checkersFinishForfeitServer;" \n "                };" \n "            };" \n "        };" \n "    } else {" \n "        if (!(_valid param [0, false]) && {!(_valid param [1, false])}) then {" \n "            [_table] call PGS_fnc_checkersClearServer;" \n "            _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "            _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_checkersResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_checkersClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "};" \n "" \n "PGS_fnc_rpsPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [" \n "        ""PGS_RPSRevision""," \n "        (_table getVariable [""PGS_RPSRevision"", 0]) + 1," \n "        true" \n "    ];" \n "    _table setVariable [" \n "        ""PGS_TableRevision""," \n "        (_table getVariable [""PGS_TableRevision"", 0]) + 1," \n "        true" \n "    ];" \n "};" \n "" \n "PGS_fnc_rpsClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_RPSActive"", false, true];" \n "    _table setVariable [""PGS_RPSFinished"", false, true];" \n "    _table setVariable [""PGS_RPSGameId"", """", true];" \n "    _table setVariable [""PGS_RPSPlayers"", [objNull, objNull], true];" \n "    _table setVariable [""PGS_RPSPlayerNames"", [""Player One"", ""Player Two""], true];" \n "    _table setVariable [""PGS_RPSSeatIndices"", [-1, -1], true];" \n "    _table setVariable [""PGS_RPSRound"", 1, true];" \n "    _table setVariable [""PGS_RPSEpoch"", 0, true];" \n "    _table setVariable [""PGS_RPSScores"", [0, 0], true];" \n "    _table setVariable [""PGS_RPSLocked"", [false, false], true];" \n "    _table setVariable [""PGS_RPSPhase"", ""CHOOSING"", true];" \n "    _table setVariable [""PGS_RPSCountdownEnd"", 0, true];" \n "    _table setVariable [""PGS_RPSRevealEnd"", 0, true];" \n "    _table setVariable [""PGS_RPSRevealedChoices"", ["""", """"], true];" \n "    _table setVariable [""PGS_RPSRoundWinner"", -2, true];" \n "    _table setVariable [""PGS_RPSWinner"", -1, true];" \n "    _table setVariable [""PGS_RPSStatus"", ""Waiting for a Rock Paper Scissors match."", true];" \n "    _table setVariable [""PGS_RPSChoicesServer"", ["""", """"]];" \n "    [_table] call PGS_fnc_rpsPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_rpsStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""rps"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _seatIndices = [];" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_index, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _seatIndices pushBack _index;" \n "        };" \n "    };" \n "    if ((count _players) != 2) exitWith {false};" \n "    private _first = _players param [0, objNull];" \n "    private _second = _players param [1, objNull];" \n "    if (isNull _first || {isNull _second}) exitWith {false};" \n "    _table setVariable [""PGS_RPSActive"", true, true];" \n "    _table setVariable [""PGS_RPSFinished"", false, true];" \n "    _table setVariable [" \n "        ""PGS_RPSGameId""," \n "        format [""PGS_RPS_%1_%2"", floor (serverTime * 10), floor (random 1000000)]," \n "        true" \n "    ];" \n "    _table setVariable [""PGS_RPSPlayers"", [_first, _second], true];" \n "    _table setVariable [""PGS_RPSPlayerNames"", [name _first, name _second], true];" \n "    _table setVariable [""PGS_RPSSeatIndices"", _seatIndices, true];" \n "    _table setVariable [""PGS_RPSRound"", 1, true];" \n "    _table setVariable [""PGS_RPSEpoch"", 1, true];" \n "    _table setVariable [""PGS_RPSScores"", [0, 0], true];" \n "    _table setVariable [""PGS_RPSLocked"", [false, false], true];" \n "    _table setVariable [""PGS_RPSPhase"", ""CHOOSING"", true];" \n "    _table setVariable [""PGS_RPSCountdownEnd"", 0, true];" \n "    _table setVariable [""PGS_RPSRevealEnd"", 0, true];" \n "    _table setVariable [""PGS_RPSRevealedChoices"", ["""", """"], true];" \n "    _table setVariable [""PGS_RPSRoundWinner"", -2, true];" \n "    _table setVariable [""PGS_RPSWinner"", -1, true];" \n "    _table setVariable [""PGS_RPSStatus"", ""Round 1: both players must lock a choice."", true];" \n "    _table setVariable [""PGS_RPSChoicesServer"", ["""", """"]];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table] call PGS_fnc_rpsPublishRevisionServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_rpsFinishForfeitServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_departingUnit"", objNull]," \n "        [""_departingSeat"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_RPSActive"", false])) exitWith {};" \n "    if (_table getVariable [""PGS_RPSFinished"", false]) exitWith {};" \n "    private _players = _table getVariable [""PGS_RPSPlayers"", [objNull, objNull]];" \n "    private _seatIndices = _table getVariable [""PGS_RPSSeatIndices"", [-1, -1]];" \n "    private _names = _table getVariable [""PGS_RPSPlayerNames"", [""Player One"", ""Player Two""]];" \n "    private _roleIndex = -1;" \n "    if (!isNull _departingUnit) then {" \n "        _roleIndex = _players find _departingUnit;" \n "    };" \n "    if (_roleIndex < 0 && {_departingSeat >= 0}) then {" \n "        _roleIndex = _seatIndices find _departingSeat;" \n "    };" \n "    if (_roleIndex < 0) exitWith {};" \n "    private _winnerRole = 1 - _roleIndex;" \n "    private _winnerName = _names param [_winnerRole, ""Opponent""];" \n "    private _loserName = _names param [_roleIndex, ""Opponent""];" \n "    _table setVariable [""PGS_RPSFinished"", true, true];" \n "    _table setVariable [""PGS_RPSPhase"", ""FINISHED"", true];" \n "    _table setVariable [""PGS_RPSWinner"", _winnerRole, true];" \n "    _table setVariable [""PGS_RPSCountdownEnd"", 0, true];" \n "    _table setVariable [""PGS_RPSRevealEnd"", 0, true];" \n "    _table setVariable [""PGS_RPSStatus"", format [""%1 wins the match by forfeit after %2 left."", _winnerName, _loserName], true];" \n "    _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "    [_table] call PGS_fnc_rpsPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_rpsProgressServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_RPSActive"", false])) exitWith {};" \n "    if (_table getVariable [""PGS_RPSFinished"", false]) exitWith {};" \n "    private _phase = _table getVariable [""PGS_RPSPhase"", ""CHOOSING""];" \n "    if (_phase == ""COUNTDOWN"") exitWith {" \n "        if (serverTime < (_table getVariable [""PGS_RPSCountdownEnd"", 0])) exitWith {};" \n "        private _choices = +(_table getVariable [""PGS_RPSChoicesServer"", ["""", """"]]);" \n "        private _firstChoice = _choices param [0, """"];" \n "        private _secondChoice = _choices param [1, """"];" \n "        if (!(_firstChoice in [""ROCK"", ""PAPER"", ""SCISSORS""]) || {!(_secondChoice in [""ROCK"", ""PAPER"", ""SCISSORS""])}) exitWith {" \n "            _table setVariable [""PGS_RPSChoicesServer"", ["""", """"]];" \n "            _table setVariable [""PGS_RPSEpoch"", (_table getVariable [""PGS_RPSEpoch"", 0]) + 1, true];" \n "            _table setVariable [""PGS_RPSLocked"", [false, false], true];" \n "            _table setVariable [""PGS_RPSPhase"", ""CHOOSING"", true];" \n "            _table setVariable [""PGS_RPSCountdownEnd"", 0, true];" \n "            _table setVariable [""PGS_RPSStatus"", ""The choices could not be verified. Both players must choose again."", true];" \n "            [_table] call PGS_fnc_rpsPublishRevisionServer;" \n "        };" \n "        private _roundWinner = -1;" \n "        if (_firstChoice != _secondChoice) then {" \n "            _roundWinner = if (" \n "                (_firstChoice == ""ROCK"" && {_secondChoice == ""SCISSORS""})" \n "                || {(_firstChoice == ""SCISSORS"" && {_secondChoice == ""PAPER""})}" \n "                || {(_firstChoice == ""PAPER"" && {_secondChoice == ""ROCK""})}" \n "            ) then {0} else {1};" \n "        };" \n "        private _round = _table getVariable [""PGS_RPSRound"", 1];" \n "        private _scores = +(_table getVariable [""PGS_RPSScores"", [0, 0]]);" \n "        private _names = _table getVariable [""PGS_RPSPlayerNames"", [""Player One"", ""Player Two""]];" \n "        private _status = format [""Round %1 is a draw. The round will replay."", _round];" \n "        if (_roundWinner >= 0) then {" \n "            _scores set [_roundWinner, (_scores param [_roundWinner, 0]) + 1];" \n "            _status = format [""%1 wins round %2: %3 beats %4."", _names param [_roundWinner, ""Player""], _round, _choices param [_roundWinner, """"], _choices param [1 - _roundWinner, """"]];" \n "        };" \n "        _table setVariable [""PGS_RPSScores"", _scores, true];" \n "        _table setVariable [""PGS_RPSRevealedChoices"", _choices, true];" \n "        _table setVariable [""PGS_RPSRoundWinner"", _roundWinner, true];" \n "        _table setVariable [""PGS_RPSCountdownEnd"", 0, true];" \n "        if (_roundWinner >= 0 && {(_scores param [_roundWinner, 0]) >= 2}) then {" \n "            _table setVariable [""PGS_RPSFinished"", true, true];" \n "            _table setVariable [""PGS_RPSPhase"", ""FINISHED"", true];" \n "            _table setVariable [""PGS_RPSWinner"", _roundWinner, true];" \n "            _table setVariable [""PGS_RPSRevealEnd"", 0, true];" \n "            _table setVariable [""PGS_RPSStatus"", format [""%1 wins the best-of-three match, %2 to %3."", _names param [_roundWinner, ""Player""], _scores param [_roundWinner, 0], _scores param [1 - _roundWinner, 0]], true];" \n "            _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "        } else {" \n "            _table setVariable [""PGS_RPSPhase"", ""REVEAL"", true];" \n "            _table setVariable [""PGS_RPSRevealEnd"", serverTime + PGS_CFG_RPS_REVEAL_SECONDS, true];" \n "            _table setVariable [""PGS_RPSStatus"", _status, true];" \n "        };" \n "        [_table] call PGS_fnc_rpsPublishRevisionServer;" \n "    };" \n "    if (_phase == ""REVEAL"") exitWith {" \n "        if (serverTime < (_table getVariable [""PGS_RPSRevealEnd"", 0])) exitWith {};" \n "        private _round = _table getVariable [""PGS_RPSRound"", 1];" \n "        if ((_table getVariable [""PGS_RPSRoundWinner"", -2]) >= 0) then {" \n "            _round = _round + 1;" \n "        };" \n "        _table setVariable [""PGS_RPSRound"", _round, true];" \n "        _table setVariable [""PGS_RPSEpoch"", (_table getVariable [""PGS_RPSEpoch"", 0]) + 1, true];" \n "        _table setVariable [""PGS_RPSLocked"", [false, false], true];" \n "        _table setVariable [""PGS_RPSPhase"", ""CHOOSING"", true];" \n "        _table setVariable [""PGS_RPSRevealEnd"", 0, true];" \n "        _table setVariable [""PGS_RPSRevealedChoices"", ["""", """"], true];" \n "        _table setVariable [""PGS_RPSRoundWinner"", -2, true];" \n "        _table setVariable [""PGS_RPSChoicesServer"", ["""", """"]];" \n "        _table setVariable [""PGS_RPSStatus"", format [""Round %1: both players must lock a choice."", _round], true];" \n "        [_table] call PGS_fnc_rpsPublishRevisionServer;" \n "    };" \n "};" \n "" \n "PGS_fnc_rpsReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_RPSActive"", false])) exitWith {};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = _table getVariable [""PGS_RPSPlayers"", [objNull, objNull]];" \n "    private _seatIndices = _table getVariable [""PGS_RPSSeatIndices"", [-1, -1]];" \n "    private _valid = [false, false];" \n "    for ""_role"" from 0 to 1 do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seatIndex = _seatIndices param [_role, -1];" \n "        _valid set [_role," \n "            !isNull _unit" \n "                && {_seatIndex >= 0}" \n "                && {_seatIndex < PGS_CFG_SEAT_COUNT}" \n "                && {(_seats param [_seatIndex, objNull]) == _unit}" \n "                && {_unit in allPlayers}" \n "                && {alive _unit}" \n "                && {(lifeState _unit) != ""INCAPACITATED""}" \n "        ];" \n "    };" \n "    if (!(_valid param [0, false]) && {!(_valid param [1, false])}) exitWith {" \n "        [_table] call PGS_fnc_rpsClearServer;" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "    };" \n "    if (!(_table getVariable [""PGS_RPSFinished"", false])) then {" \n "        if (!(_valid param [0, false])) then {" \n "            [_table, objNull, _seatIndices param [0, -1]] call PGS_fnc_rpsFinishForfeitServer;" \n "        } else {" \n "            if (!(_valid param [1, false])) then {" \n "                [_table, objNull, _seatIndices param [1, -1]] call PGS_fnc_rpsFinishForfeitServer;" \n "            };" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_rpsResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_rpsClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "};" \n "" \n "PGS_fnc_getTableActiveGameId = {" \n "    params [[""_table"", objNull]];" \n "    if (isNull _table) exitWith {""""};" \n "    private _activeGame = """";" \n "    if (_table getVariable [""PGS_BattleshipActive"", false]) then {_activeGame = ""battleship"";};" \n "    if (_activeGame == """" && {_table getVariable [""PGS_WhosWhoActive"", false]}) then {_activeGame = ""whoswho"";};" \n "    if (_activeGame == """" && {_table getVariable [""PGS_ShotgunActive"", false]}) then {_activeGame = ""shotgun"";};" \n "    if (_activeGame == """" && {_table getVariable [""PGS_CheckersActive"", false]}) then {_activeGame = ""checkers"";};" \n "    if (_activeGame == """" && {_table getVariable [""PGS_RPSActive"", false]}) then {_activeGame = ""rps"";};" \n "    if (_activeGame == """" && {_table getVariable [""PGS_BlackjackActive"", false]}) then {_activeGame = ""blackjack"";};" \n "    if (_activeGame == """" && {_table getVariable [""PGS_ChessActive"", false]}) then {_activeGame = ""chess"";};" \n "    if (_activeGame == """" && {_table getVariable [""PGS_PokerActive"", false]}) then {_activeGame = ""poker"";};" \n "    if (_activeGame == """" && {_table getVariable [""PGS_UNOActive"", false]}) then {_activeGame = ""uno"";};" \n "    if (_activeGame == """") then {" \n "        private _phase = _table getVariable [""PGS_TablePhase"", ""LOBBY""];" \n "        private _selected = _table getVariable [""PGS_TableSelectedGame"", """"];" \n "        if (_phase in [""PLAYING"", ""FINISHED""] && {_selected in [""battleship"", ""whoswho"", ""shotgun"", ""checkers"", ""rps"", ""blackjack"", ""chess"", ""poker"", ""uno""]}) then {" \n "            _activeGame = _selected;" \n "        };" \n "    };" \n "    _activeGame" \n "};" \n "" \n "PGS_fnc_isTableGameActive = {" \n "    params [[""_table"", objNull]];" \n "    ([_table] call PGS_fnc_getTableActiveGameId) != """"" \n "};" \n "" \n "PGS_fnc_chessPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [" \n "        ""PGS_ChessRevision""," \n "        (_table getVariable [""PGS_ChessRevision"", 0]) + 1," \n "        true" \n "    ];" \n "    _table setVariable [" \n "        ""PGS_TableRevision""," \n "        (_table getVariable [""PGS_TableRevision"", 0]) + 1," \n "        true" \n "    ];" \n "};" \n "" \n "PGS_fnc_chessClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [""PGS_ChessActive"", false, true];" \n "    _table setVariable [""PGS_ChessFinished"", false, true];" \n "    _table setVariable [""PGS_ChessGameId"", """", true];" \n "    _table setVariable [""PGS_ChessPlayers"", [objNull, objNull], true];" \n "    _table setVariable [""PGS_ChessPlayerNames"", [""NATO White"", ""CSAT Black""], true];" \n "    _table setVariable [""PGS_ChessSeatIndices"", [-1, -1], true];" \n "    _table setVariable [""PGS_ChessBoard"", [], true];" \n "    _table setVariable [""PGS_ChessTurn"", 1, true];" \n "    _table setVariable [""PGS_ChessCastlingRights"", [false, false, false, false], true];" \n "    _table setVariable [""PGS_ChessEnPassant"", -1, true];" \n "    _table setVariable [""PGS_ChessHalfmoveClock"", 0, true];" \n "    _table setVariable [""PGS_ChessFullmoveNumber"", 1, true];" \n "    _table setVariable [""PGS_ChessWinner"", 0, true];" \n "    _table setVariable [""PGS_ChessResult"", """", true];" \n "    _table setVariable [""PGS_ChessMoveNumber"", 0, true];" \n "    _table setVariable [""PGS_ChessLastMove"", [], true];" \n "    _table setVariable [""PGS_ChessStatus"", ""Waiting for a Chess match."", true];" \n "    _table setVariable [""PGS_ChessDrawOfferSide"", 0, true];" \n "    _table setVariable [""PGS_ChessCanClaimThreefold"", false, true];" \n "    _table setVariable [""PGS_ChessCanClaimFifty"", false, true];" \n "    _table setVariable [""PGS_ChessPositionHistoryServer"", []];" \n "    [_table] call PGS_fnc_chessPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_chessStartServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {false};" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {false};" \n "    if ((_table getVariable [""PGS_TableSelectedGame"", """"]) != ""chess"") exitWith {false};" \n "    if ((_table getVariable [""PGS_TablePhase"", ""LOBBY""]) != ""READY"") exitWith {false};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = [];" \n "    private _seatIndices = [];" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        private _unit = _seats param [_index, objNull];" \n "        if (!isNull _unit) then {" \n "            _players pushBack _unit;" \n "            _seatIndices pushBack _index;" \n "        };" \n "    };" \n "    if ((count _players) != 2) exitWith {false};" \n "    private _white = _players param [0, objNull];" \n "    private _black = _players param [1, objNull];" \n "    if (isNull _white || {isNull _black}) exitWith {false};" \n "    private _board = call PGS_fnc_chessCreateBoard;" \n "    private _rights = [true, true, true, true];" \n "    _table setVariable [""PGS_ChessActive"", true, true];" \n "    _table setVariable [""PGS_ChessFinished"", false, true];" \n "    _table setVariable [" \n "        ""PGS_ChessGameId""," \n "        format [""PGS_CHESS_%1_%2"", floor (serverTime * 10), floor (random 1000000)]," \n "        true" \n "    ];" \n "    _table setVariable [""PGS_ChessPlayers"", [_white, _black], true];" \n "    _table setVariable [""PGS_ChessPlayerNames"", [name _white, name _black], true];" \n "    _table setVariable [""PGS_ChessSeatIndices"", _seatIndices, true];" \n "    _table setVariable [""PGS_ChessBoard"", _board, true];" \n "    _table setVariable [""PGS_ChessTurn"", 1, true];" \n "    _table setVariable [""PGS_ChessCastlingRights"", _rights, true];" \n "    _table setVariable [""PGS_ChessEnPassant"", -1, true];" \n "    _table setVariable [""PGS_ChessHalfmoveClock"", 0, true];" \n "    _table setVariable [""PGS_ChessFullmoveNumber"", 1, true];" \n "    _table setVariable [""PGS_ChessWinner"", 0, true];" \n "    _table setVariable [""PGS_ChessResult"", """", true];" \n "    _table setVariable [""PGS_ChessMoveNumber"", 0, true];" \n "    _table setVariable [""PGS_ChessLastMove"", [], true];" \n "    _table setVariable [""PGS_ChessStatus"", format [""%1 has the first move as NATO White."", name _white], true];" \n "    _table setVariable [""PGS_ChessDrawOfferSide"", 0, true];" \n "    _table setVariable [""PGS_ChessCanClaimThreefold"", false, true];" \n "    _table setVariable [""PGS_ChessCanClaimFifty"", false, true];" \n "    _table setVariable [" \n "        ""PGS_ChessPositionHistoryServer""," \n "        [[_board, 1, _rights, -1] call PGS_fnc_chessPositionKey]" \n "    ];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table] call PGS_fnc_chessPublishRevisionServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_chessFinishServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_winner"", 0]," \n "        [""_result"", ""DRAW""]," \n "        [""_status"", ""Chess match finished.""]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_ChessActive"", false])) exitWith {};" \n "    _table setVariable [""PGS_ChessFinished"", true, true];" \n "    _table setVariable [""PGS_ChessWinner"", _winner, true];" \n "    _table setVariable [""PGS_ChessResult"", _result, true];" \n "    _table setVariable [""PGS_ChessStatus"", _status, true];" \n "    _table setVariable [""PGS_ChessDrawOfferSide"", 0, true];" \n "    _table setVariable [""PGS_ChessCanClaimThreefold"", false, true];" \n "    _table setVariable [""PGS_ChessCanClaimFifty"", false, true];" \n "    _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "    [_table] call PGS_fnc_chessPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_chessFinishForfeitServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_departingUnit"", objNull]," \n "        [""_departingSeat"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_ChessActive"", false])) exitWith {};" \n "    if (_table getVariable [""PGS_ChessFinished"", false]) exitWith {};" \n "    private _players = _table getVariable [""PGS_ChessPlayers"", [objNull, objNull]];" \n "    private _seatIndices = _table getVariable [""PGS_ChessSeatIndices"", [-1, -1]];" \n "    private _names = _table getVariable [""PGS_ChessPlayerNames"", [""NATO White"", ""CSAT Black""]];" \n "    private _roleIndex = -1;" \n "    if (!isNull _departingUnit) then {" \n "        _roleIndex = _players find _departingUnit;" \n "    };" \n "    if (_roleIndex < 0 && {_departingSeat >= 0}) then {" \n "        _roleIndex = _seatIndices find _departingSeat;" \n "    };" \n "    if (_roleIndex < 0) exitWith {};" \n "    private _loserSide = if (_roleIndex == 0) then {1} else {-1};" \n "    private _winner = -_loserSide;" \n "    private _winnerName = _names param [if (_winner > 0) then {0} else {1}, ""Opponent""];" \n "    private _loserName = _names param [_roleIndex, ""Opponent""];" \n "    [_table, _winner, ""FORFEIT"", format [""%1 wins by forfeit after %2 left the table."", _winnerName, _loserName]] call PGS_fnc_chessFinishServer;" \n "};" \n "" \n "PGS_fnc_chessReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    if (!(_table getVariable [""PGS_ChessActive"", false])) exitWith {};" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _players = _table getVariable [""PGS_ChessPlayers"", [objNull, objNull]];" \n "    private _seatIndices = _table getVariable [""PGS_ChessSeatIndices"", [-1, -1]];" \n "    private _valid = [false, false];" \n "    for ""_role"" from 0 to 1 do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seatIndex = _seatIndices param [_role, -1];" \n "        private _isValid = !isNull _unit" \n "            && {_seatIndex >= 0}" \n "            && {_seatIndex < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seatIndex, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {alive _unit}" \n "            && {(lifeState _unit) != ""INCAPACITATED""};" \n "        _valid set [_role, _isValid];" \n "    };" \n "    if (!(_table getVariable [""PGS_ChessFinished"", false])) then {" \n "        if (!(_valid param [0, false]) && {!(_valid param [1, false])}) then {" \n "            [_table] call PGS_fnc_chessClearServer;" \n "            _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "            _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "        } else {" \n "            if (!(_valid param [0, false])) then {" \n "                [_table, objNull, _seatIndices param [0, -1]] call PGS_fnc_chessFinishForfeitServer;" \n "            } else {" \n "                if (!(_valid param [1, false])) then {" \n "                    [_table, objNull, _seatIndices param [1, -1]] call PGS_fnc_chessFinishForfeitServer;" \n "                };" \n "            };" \n "        };" \n "    } else {" \n "        if (!(_valid param [0, false]) && {!(_valid param [1, false])}) then {" \n "            [_table] call PGS_fnc_chessClearServer;" \n "            _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "            _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "        };" \n "    };" \n "};" \n "" \n "PGS_fnc_chessResetServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_chessClearServer;" \n "    _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "    [_table] call PGS_fnc_refreshTableConsensusServer;" \n "}; " \n " " \n "PGS_fnc_pokerCreateEmptySnapshot = {" \n "    params [" \n "        [""_count"", 0]," \n "        [""_chipsSource"", []]" \n "    ];" \n "    private _chips = [];" \n "    private _numbers = [];" \n "    private _statuses = [];" \n "    private _actions = [];" \n "    private _revealed = [];" \n "    private _booleans = [];" \n "    private _lastActed = [];" \n "    private _choices = [];" \n "    if (_count > 0) then {" \n "        for ""_role"" from 0 to (_count - 1) do {" \n "            _chips pushBack (_chipsSource param [_role, PGS_CFG_POKER_STARTING_CHIPS]);" \n "            _numbers pushBack 0;" \n "            _statuses pushBack ""BUSTED"";" \n "            _actions pushBack ""Waiting"";" \n "            _revealed pushBack [];" \n "            _booleans pushBack false;" \n "            _lastActed pushBack -1;" \n "            _choices pushBack -1;" \n "        };" \n "    };" \n "    [" \n "        ""IDLE"", 0, -1, -1, -1, -1," \n "        _chips, +_numbers, +_numbers, _statuses, _actions, [], 0, 0," \n "        PGS_CFG_POKER_BIG_BLIND, [], ""Waiting for Poker."", _revealed," \n "        +_booleans, +_booleans, _lastActed, [], false, _choices" \n "    ]" \n "};" \n "" \n "PGS_fnc_pokerPublishRevisionServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    _table setVariable [" \n "        ""PGS_PokerRevision""," \n "        (_table getVariable [""PGS_PokerRevision"", 0]) + 1," \n "        true" \n "    ];" \n "    _table setVariable [" \n "        ""PGS_TableRevision""," \n "        (_table getVariable [""PGS_TableRevision"", 0]) + 1," \n "        true" \n "    ];" \n "};" \n "" \n "PGS_fnc_pokerSetSnapshotServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]" \n "    ];" \n "    if (!isServer || {isNull _table} || {(typeName _snapshot) != ""ARRAY""}) exitWith {};" \n "    _table setVariable [""PGS_PokerSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_PokerSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_pokerPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_pokerSendPrivateHandServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_role"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {_role < 0}) exitWith {};" \n "    private _players = _table getVariable [""PGS_PokerPlayers"", []];" \n "    private _recipient = _players param [_role, objNull];" \n "    if (isNull _recipient) exitWith {};" \n "    private _snapshot = _table getVariable [""PGS_PokerSnapshotServer"", []];" \n "    private _handNumber = _snapshot param [1, 0];" \n "    private _hands = _table getVariable [""PGS_PokerHandsServer"", []];" \n "    private _cards = +(_hands param [_role, []]);" \n "    private _payload = [" \n "        _table getVariable [""PGS_PokerGameId"", """"]," \n "        _handNumber," \n "        _cards" \n "    ];" \n "    _recipient setVariable [""PGS_PokerPrivateHand"", _payload, owner _recipient];" \n "};" \n "" \n "PGS_fnc_pokerClearPrivateHandsServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    {" \n "        if (!isNull _x) then {" \n "            _x setVariable [""PGS_PokerPrivateHand"", [], owner _x];" \n "        };" \n "    } forEach (_table getVariable [""PGS_PokerPlayers"", []]);" \n "    _table setVariable [""PGS_PokerHandsServer"", []];" \n "    _table setVariable [""PGS_PokerDeckServer"", []];" \n "};" \n "" \n "PGS_fnc_pokerClearServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    [_table] call PGS_fnc_pokerClearPrivateHandsServer;" \n "    _table setVariable [""PGS_PokerActive"", false, true];" \n "    _table setVariable [""PGS_PokerFinished"", false, true];" \n "    _table setVariable [""PGS_PokerGameId"", """", true];" \n "    _table setVariable [""PGS_PokerPlayers"", [], true];" \n "    _table setVariable [""PGS_PokerPlayerNames"", [], true];" \n "    _table setVariable [""PGS_PokerSeatIndices"", [], true];" \n "    private _snapshot = [0, []] call PGS_fnc_pokerCreateEmptySnapshot;" \n "    _table setVariable [""PGS_PokerSnapshotServer"", _snapshot];" \n "    _table setVariable [""PGS_PokerSnapshot"", _snapshot, true];" \n "    [_table] call PGS_fnc_pokerPublishRevisionServer;" \n "};" \n "" \n "PGS_fnc_pokerCountSurvivorsServer = {" \n "    params [[""_snapshot"", []]];" \n "    private _chips = _snapshot param [6, []];" \n "    private _statuses = _snapshot param [9, []];" \n "    private _count = 0;" \n "    for ""_role"" from 0 to ((count _chips) - 1) do {" \n "        if ((_chips param [_role, 0]) > 0 && {(_statuses param [_role, ""LEFT""]) != ""LEFT""}) then {" \n "            _count = _count + 1;" \n "        };" \n "    };" \n "    _count" \n "};" \n "" \n "PGS_fnc_pokerCompleteHandServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _state = +_snapshot;" \n "    private _chips = +(_state param [6, []]);" \n "    private _statuses = +(_state param [9, []]);" \n "    private _count = count _chips;" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        if ((_statuses param [_role, ""LEFT""]) != ""LEFT"" && {(_chips param [_role, 0]) <= 0}) then {" \n "            _statuses set [_role, ""BUSTED""];" \n "        };" \n "    };" \n "    private _revealed = [];" \n "    private _ready = [];" \n "    private _pending = [];" \n "    private _choices = [];" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        _revealed pushBack [];" \n "        _ready pushBack false;" \n "        _pending pushBack false;" \n "        _choices pushBack -1;" \n "    };" \n "    _state set [9, _statuses];" \n "    _state set [17, _revealed];" \n "    _state set [18, _ready];" \n "    _state set [19, _pending];" \n "    _state set [23, _choices];" \n "    _state set [5, -1];" \n "    private _finished = ([_state] call PGS_fnc_pokerCountSurvivorsServer) <= 1;" \n "    _state set [0, if (_finished) then {""MATCH_END""} else {""HAND_END""}];" \n "    _table setVariable [""PGS_PokerFinished"", _finished, true];" \n "    _table setVariable [""PGS_TablePhase"", if (_finished) then {""FINISHED""} else {""PLAYING""}, true];" \n "    if (_finished) then {" \n "        private _survivor = -1;" \n "        for ""_role"" from 0 to (_count - 1) do {" \n "            if ((_chips param [_role, 0]) > 0 && {(_statuses param [_role, ""LEFT""]) != ""LEFT""}) then {" \n "                _survivor = _role;" \n "            };" \n "        };" \n "        if (_survivor >= 0) then {" \n "            private _names = _table getVariable [""PGS_PokerPlayerNames"", []];" \n "            _state set [16, format [" \n "                ""%1 wins the Poker table with %2 chips. Reveal cards or reset to the lobby.""," \n "                _names param [_survivor, ""Survivor""]," \n "                _chips param [_survivor, 0]" \n "            ]];" \n "        };" \n "    };" \n "    [_table, _state] call PGS_fnc_pokerSetSnapshotServer;" \n "};" \n "" \n "PGS_fnc_pokerAwardUncontestedServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]," \n "        [""_winner"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {_winner < 0}) exitWith {};" \n "    private _state = +_snapshot;" \n "    private _chips = +(_state param [6, []]);" \n "    private _pot = _state param [12, 0];" \n "    _chips set [_winner, (_chips param [_winner, 0]) + _pot];" \n "    private _names = _table getVariable [""PGS_PokerPlayerNames"", []];" \n "    private _winnerName = _names param [_winner, ""Winner""];" \n "    _state set [6, _chips];" \n "    _state set [15, [_winner]];" \n "    _state set [21, [[_winner, _pot, ""Uncontested pot"", 0]]];" \n "    _state set [16, format [" \n "        ""%1 wins %2 chips uncontested. Reveal the bluff, or stay mysterious and ready for the next hand.""," \n "        _winnerName," \n "        _pot" \n "    ]];" \n "    [_table, _state] call PGS_fnc_pokerCompleteHandServer;" \n "};" \n "" \n "PGS_fnc_pokerResolveShowdownServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _state = +_snapshot;" \n "    private _chips = +(_state param [6, []]);" \n "    private _contributions = +(_state param [8, []]);" \n "    private _statuses = +(_state param [9, []]);" \n "    private _community = +(_state param [11, []]);" \n "    private _dealer = _state param [2, -1];" \n "    private _hands = _table getVariable [""PGS_PokerHandsServer"", []];" \n "    private _names = _table getVariable [""PGS_PokerPlayerNames"", []];" \n "    private _count = count _chips;" \n "    private _scores = [];" \n "    private _labels = [];" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        if ((_statuses param [_role, ""LEFT""]) in [""FOLDED"", ""LEFT""]) then {" \n "            _scores pushBack [-1, 0, 0, 0, 0, 0];" \n "            _labels pushBack ""Folded"";" \n "        } else {" \n "            private _evaluation = [(_hands param [_role, []]) + _community] call PGS_fnc_pokerEvaluateBest;" \n "            _scores pushBack (_evaluation param [0, [-1, 0, 0, 0, 0, 0]]);" \n "            _labels pushBack (_evaluation param [2, ""No Hand""]);" \n "        };" \n "    };" \n "" \n "    private _awardTotals = [];" \n "    for ""_role"" from 0 to (_count - 1) do {_awardTotals pushBack 0;};" \n "    private _awards = [];" \n "    private _winners = [];" \n "    private _summaryParts = [];" \n "    private _pots = [_contributions, _statuses] call PGS_fnc_pokerBuildSidePots;" \n "    for ""_potIndex"" from 0 to ((count _pots) - 1) do {" \n "        private _potData = _pots param [_potIndex, [0, [], []]];" \n "        private _amount = _potData param [0, 0];" \n "        private _eligible = +(_potData param [1, []]);" \n "        private _contributors = +(_potData param [2, []]);" \n "        if ((count _eligible) <= 0) then {" \n "            for ""_role"" from 0 to (_count - 1) do {" \n "                if ((_statuses param [_role, ""LEFT""]) in [""ACTIVE"", ""ALL_IN""]) then {" \n "                    _eligible pushBack _role;" \n "                };" \n "            };" \n "            if ((count _eligible) <= 0 && {(count _contributors) == 1}) then {" \n "                _eligible = [_contributors param [0, -1]];" \n "            };" \n "        };" \n "        if ((count _eligible) > 0 && {_amount > 0}) then {" \n "            private _potWinners = [];" \n "            private _bestScore = [-1, 0, 0, 0, 0, 0];" \n "            {" \n "                private _score = _scores param [_x, [-1, 0, 0, 0, 0, 0]];" \n "                private _comparison = [_score, _bestScore] call PGS_fnc_pokerCompareScores;" \n "                if (_comparison > 0) then {" \n "                    _bestScore = _score;" \n "                    _potWinners = [_x];" \n "                } else {" \n "                    if (_comparison == 0) then {_potWinners pushBack _x;};" \n "                };" \n "            } forEach _eligible;" \n "            private _share = floor (_amount / (count _potWinners));" \n "            private _remainder = _amount mod (count _potWinners);" \n "            private _potAwardTotals = [];" \n "            for ""_role"" from 0 to (_count - 1) do {_potAwardTotals pushBack 0;};" \n "            {" \n "                _awardTotals set [_x, (_awardTotals param [_x, 0]) + _share];" \n "                _potAwardTotals set [_x, (_potAwardTotals param [_x, 0]) + _share];" \n "            } forEach _potWinners;" \n "            if (_remainder > 0) then {" \n "                private _winnerFlags = [];" \n "                for ""_role"" from 0 to (_count - 1) do {" \n "                    _winnerFlags pushBack (_role in _potWinners);" \n "                };" \n "                private _cursor = _dealer;" \n "                while {_remainder > 0} do {" \n "                    _cursor = [_cursor, _winnerFlags] call PGS_fnc_pokerGetNextIndex;" \n "                    if (_cursor < 0) then {" \n "                        _remainder = 0;" \n "                    } else {" \n "                        _awardTotals set [_cursor, (_awardTotals param [_cursor, 0]) + 1];" \n "                        _potAwardTotals set [_cursor, (_potAwardTotals param [_cursor, 0]) + 1];" \n "                        _remainder = _remainder - 1;" \n "                    };" \n "                };" \n "            };" \n "            private _label = [_bestScore] call PGS_fnc_pokerHandCategoryName;" \n "            {" \n "                _winners pushBackUnique _x;" \n "                _awards pushBack [_x, _potAwardTotals param [_x, 0], _label, _potIndex];" \n "            } forEach _potWinners;" \n "        };" \n "    };" \n "    for ""_role"" from 0 to (_count - 1) do {" \n "        private _amount = _awardTotals param [_role, 0];" \n "        if (_amount > 0) then {" \n "            _chips set [_role, (_chips param [_role, 0]) + _amount];" \n "            private _label = _labels param [_role, ""Poker hand""];" \n "            _summaryParts pushBack format [""%1 +%2 (%3)"", _names param [_role, ""Player""], _amount, _label];" \n "        };" \n "    };" \n "    _state set [6, _chips];" \n "    _state set [15, _winners];" \n "    _state set [21, _awards];" \n "    _state s