rue];" \n "    _table setVariable [""PGS_TableSelectedGame"", ""uno"", true];" \n "    _table setVariable [""PGS_TablePhase"", ""PLAYING"", true];" \n "    [_table] call PGS_fnc_unoPublishRevisionServer;" \n "    [_table, [0, 1, 2, 3]] call PGS_fnc_unoSendPrivateHandsServer;" \n "    true" \n "};" \n "" \n "PGS_fnc_unoFinishServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_snapshot"", []]," \n "        [""_winnerRole"", -1]," \n "        [""_status"", ""UNO finished.""]," \n "        [""_changedRoles"", []]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {};" \n "    private _state = +_snapshot;" \n "    private _statuses = +(_state param [8, []]);" \n "    if (_winnerRole >= 0 && {_winnerRole < (count _statuses)}) then {" \n "        _statuses set [_winnerRole, ""WINNER""];" \n "    };" \n "    _state set [0, ""FINISHED""];" \n "    _state set [2, -1];" \n "    _state set [8, _statuses];" \n "    _state set [9, -1];" \n "    _state set [10, 0];" \n "    _state set [11, -1];" \n "    _state set [13, -1];" \n "    _state set [14, _winnerRole];" \n "    _state set [15, _status];" \n "    _table setVariable [""PGS_UNOFinished"", true, true];" \n "    _table setVariable [""PGS_TablePhase"", ""FINISHED"", true];" \n "    [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "    [_table, _changedRoles] call PGS_fnc_unoSendPrivateHandsServer;" \n "};" \n "" \n "PGS_fnc_unoHandleDepartureServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_departing"", objNull]," \n "        [""_seatIndex"", -1]" \n "    ];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_UNOActive"", false])}) exitWith {};" \n "    private _players = _table getVariable [""PGS_UNOPlayers"", []];" \n "    private _seatIndices = _table getVariable [""PGS_UNOSeatIndices"", []];" \n "    private _role = if (isNull _departing) then {" \n "        _seatIndices find _seatIndex" \n "    } else {" \n "        _pl