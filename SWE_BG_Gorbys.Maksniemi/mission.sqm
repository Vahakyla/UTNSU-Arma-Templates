true] call PGS_fnc_exitSpectatorLocal;" \n "        } else {" \n "            _display closeDisplay 1;" \n "            [_table] spawn {" \n "                params [""_lobbyTable""];" \n "                uiSleep 0.1;" \n "                if (!isNull _lobbyTable && {(_lobbyTable == (player getVariable [""PGS_SeatedTable"", objNull]))}) then {" \n "                    [_lobbyTable] call PGS_fnc_openLobbyLocal;" \n "                };" \n "            };" \n "        };" \n "    };" \n "" \n "    private _side = [_table] call PGS_fnc_getCheckersPlayerSideLocal;" \n "    private _board = [(_table getVariable [""PGS_CheckersBoard"", []])] call PGS_fnc_checkersNormalizeBoard;" \n "    private _turn = _table getVariable [""PGS_CheckersTurn"", 1];" \n "    private _forcedFrom = _table getVariable [""PGS_CheckersForcedFrom"", -1];" \n "    private _winner = _table getVariable [""PGS_CheckersWinner"", 0];" \n "    private _revision = _table getVariable [""PGS_CheckersRevision"", 0];" \n "    private _lastRevision = _display getVariable [""PGS_CheckersLastRevision"", -1];" \n "    private _selected = _display getVariable [""PGS_CheckersSelectedFrom"", -1];" \n "    if (_revision != _lastRevision) then {" \n "        _display setVariable [""PGS_CheckersMovePending"", false];" \n "        if (_forcedFrom >= 0 && {_turn == _side}) then {" \n "            _selected = _forcedFrom;" \n "        } else {" \n "            if (_selected >= 0 && {([_board param [_selected, 0]] call PGS_fnc_checkersPieceSide) != _side}) then {" \n "                _selected = -1;" \n "            };" \n "        };" \n "        _display setVariable [""PGS_CheckersSelectedFrom"", _selected];" \n "        private _captureSources = [];" \n "        if (_winner == 0) then {" \n "            if (_forcedFrom >= 0) then {" \n "                if ((count ([_board, _forcedFrom] call PGS_fnc_checkersGetCaptureMoves)) > 0) then {" \n "                    _captureSources pushBack _forcedFrom;" \n "                };" \n "            } else {" \n "                for ""_index"" from 0 to 63 do {" \n "                    if (" \n "                        ([_board param [_index, 0]] call PGS_fnc_checkersPieceSide) == _turn" \n "                        && {(count ([_board, _index] call PGS_fnc_checkersGetCaptureMoves)) > 0}" \n "                    ) then {" \n "                        _captureSources pushBack _index;" \n "                    };" \n "                };" \n "            };" \n "        };" \n "        _display setVariable [""PGS_CheckersCaptureSources"", _captureSources];" \n "        _display setVariable [""PGS_CheckersLastRevision"", _revision];" \n "    };" \n "    private _legalMoves = if (_selected >= 0 && {_turn == _side} && {_winner == 0}) then {" \n "        [_board, _side, _selected, _forcedFrom] call PGS_fnc_checkersGetLegalMoves" \n "    } else {" \n "        []" \n "    };" \n "    private _legalDestinations = [];" \n "    {" \n "        _legalDestinations pushBack (_x param [0, -1]);" \n "    } forEach _legalMoves;" \n "    private _captureSources = _display getVariable [""PGS_CheckersCaptureSources"", []];" \n "    private _lastMove = _table getVariable [""PGS_CheckersLastMove"", []];" \n "    private _lastFrom = _lastMove param [0, -1];" \n "    private _lastTo = _lastMove param [1, -1];" \n "    private _controls = _display getVariable [""PGS_CheckersSquareControls"", []];" \n "    {" \n "        private _control = _x;" \n "        if (!isNull _control) then {" \n "            private _index = _control getVariable [""PGS_CheckersSquareIndex"", -1];" \n "            private _row = floor (_index / 8);" \n "            private _column = _index mod 8;" \n "            private _dark = ((_row + _column) mod 2) == 1;" \n "            private _background = if (_dark) then {" \n "                [0.075, 0.085, 0.105, 1]" \n "            } else {" \n "                [0.78, 0.79, 0.74, 1]" \n "            };" \n "            if (_index == _lastFrom || {_index == _lastTo}) then {" \n "                _background = [0.22, 0.32, 0.40, 1];" \n "            };" \n "            if (_index in _captureSources) then {" \n "                _background = [0.68, 0.34, 0.06, 1];" \n "            };" \n "            if (_index == _selected) then {" \n "                _background = [0.88, 0.63, 0.12, 1];" \n "            };" \n "            if (_index in _legalDestinations) then {" \n "                _background = [0.16, 0.58, 0.30, 1];" \n "            };" \n "            _control ctrlSetBackgroundColor _background;" \n "            private _piece = _board param [_index, 0];" \n "            private _pieceText = """";" \n "            if (_piece != 0) then {" \n "                _pieceText = if ((abs _piece) == 2) then {""O+""} else {""O""};" \n "            };" \n "            _control ctrlSetText _pieceText;" \n "            _control ctrlSetTextColor (if (_piece > 0) then {" \n "                [0.18, 0.58, 1, 1]" \n "            } else {" \n "                if (_piece < 0) then {[1, 0.20, 0.16, 1]} else {[1, 1, 1, 1]}" \n "            });" \n "            _control ctrlSetTooltip (if (_piece == 0) then {" \n "                if (_index in _legalDestinations) then {""Legal destination""} else {""Empty square""}" \n "            } else {" \n "                if (_index in _captureSources) then {" \n "                    ""Compulsory capture available - select this piece""" \n "                } else {" \n "                    format [" \n "                        ""%1 %2""," \n "                        [[_piece] call PGS_fnc_checkersPieceSide] call PGS_fnc_checkersSideName," \n "                        if ((abs _piece) == 2) then {""king (+)""} else {""piece""}" \n "                    ]" \n "                }" \n "            });" \n "            _control ctrlCommit 0;" \n "        };" \n "    } forEach _controls;" \n "" \n "    private _names = _table getVariable [""PGS_CheckersPlayerNames"", [""NATO Blue"", ""OPFOR Red""]];" \