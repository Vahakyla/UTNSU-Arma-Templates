"PGS_TableOccupancy"", _occupancy, true];" \n "    _table setVariable [""PGS_TableSelectedGame"", _selectedGame, true];" \n "    _table setVariable [""PGS_TableRequiredVotes"", _requiredVotes, true];" \n "    _table setVariable [""PGS_TablePhase"", _phase, true];" \n "    _table setVariable [" \n "        ""PGS_TableRevision""," \n "        (_table getVariable [""PGS_TableRevision"", 0]) + 1," \n "        true" \n "    ];" \n "};" \n "" \n "PGS_fnc_markTableServer = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_creatorName"", ""Composition""]," \n "        [""_creatorKey"", ""COMPOSITION""]" \n "    ];" \n "    if (!isServer || {isNull _table}) exitWith {objNull};" \n "" \n "    private _wasMarked = _table getVariable [""PGS_IsPartyTable"", false];" \n "    [_table] call PGS_fnc_enforceInvulnerableLocal;" \n "    _table setVariable [""PGS_IsPartyTable"", true, true];" \n "    if (!_wasMarked) then {" \n "        _table setVariable [" \n "            ""PGS_TableId""," \n "            format [""PGS_TABLE_%1_%2"", floor (serverTime * 10), floor (random 1000000)]," \n "            true" \n "        ];" \n "        _table setVariable [""PGS_TableCreatorName"", _creatorName, true];" \n "        _table setVariable [""PGS_TableCreatorKey"", _creatorKey, true];" \n "        _table setVariable [""PGS_TableSeats"", [objNull, objNull, objNull, objNull], true];" \n "        _table setVariable [""PGS_TableVotes"", ["""", """", """", """"], true];" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TableOccupancy"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TableSelectedGame"", """", true];" \n "        _table setVariable [""PGS_TableRequiredVotes"", 1, true];" \n "        _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "        _table setVariable [""PGS_TableRevision"", 0, true];" \n "        [_table] call PGS_fnc_battleshipClearS