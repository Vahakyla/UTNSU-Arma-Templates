  _state set [2, _turn];" \n "    };" \n "    _state set [8, _statuses];" \n "    _state set [12, _actions];" \n "    _state set [17, _armed];" \n "    if (!_matchWasFinished) then {" \n "        _state set [15, format [""%1 left the UNO table."", if (isNull _departing) then {""A player""} else {name _departing}]];" \n "    };" \n "    private _remaining = [_activeFlags] call PGS_fnc_unoCountActiveRoles;" \n "    if (_remaining <= 0) exitWith {" \n "        [_table] call PGS_fnc_unoClearServer;" \n "        _table setVariable [""PGS_TableReady"", [false, false, false, false], true];" \n "        _table setVariable [""PGS_TablePhase"", ""LOBBY"", true];" \n "    };" \n "    if (_remaining == 1 && {!_matchWasFinished}) exitWith {" \n "        private _winner = _activeFlags find true;" \n "        private _names = _table getVariable [""PGS_UNOPlayerNames"", []];" \n "        [_table, _state, _winner, format [""%1 wins UNO by forfeit."", _names param [_winner, ""Player""]], []] call PGS_fnc_unoFinishServer;" \n "    };" \n "    [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "};" \n "" \n "PGS_fnc_unoReconcilePlayersServer = {" \n "    params [[""_table"", objNull]];" \n "    if (!isServer || {isNull _table} || {!(_table getVariable [""PGS_UNOActive"", false])}) exitWith {};" \n "    private _players = +(_table getVariable [""PGS_UNOPlayers"", []]);" \n "    private _seatIndices = _table getVariable [""PGS_UNOSeatIndices"", []];" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    for ""_role"" from 0 to ((count _players) - 1) do {" \n "        private _unit = _players param [_role, objNull];" \n "        private _seat = _seatIndices param [_role, -1];" \n "        private _valid = !isNull _unit" \n "            && {_seat >= 0}" \n "            && {_seat < PGS_CFG_SEAT_COUNT}" \n "            && {(_seats param [_seat, objNull]) == _unit}" \n "            && {_unit in allPlayers}" \n "            && {aliv