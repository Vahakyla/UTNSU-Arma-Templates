fnc_unoGetNextActiveRole;" \n "                };" \n "            };" \n "        };" \n "    };" \n "    private _names = _table getVariable [""PGS_UNOPlayerNames"", []];" \n "    private _status = format [""%1 played %2.%3 %4 is next."", name _unit, _playedName, _unoText, _names param [_turn, ""Player""]];" \n "    if (_pendingAmount > 0) then {" \n "        _status = format [""%1 played %2. %3 must stack the same draw card or take +%4."", name _unit, _playedName, _names param [_turn, ""Player""], _pendingAmount];" \n "    };" \n "    _state set [2, _turn];" \n "    _state set [3, _direction];" \n "    _state set [9, _pendingKind];" \n "    _state set [10, _pendingAmount];" \n "    _state set [15, _status];" \n "    [_table, _state] call PGS_fnc_unoSetSnapshotServer;" \n "    [_table, [_role]] call PGS_fnc_unoSendPrivateHandsServer;" \n "    [_unit, _token, ""UNO play accepted.""] call PGS_fnc_resultServer;" \n "};" \n "" \n "PGS_fnc_processPriorityUNORequestsServer = {" \n "    params [[""_players"", []]];" \n "    if (!isServer) exitWith {}; " \n " " \n "    {" \n "        private _unit = _x;" \n "        private _request = _unit getVariable [""PGS_UNOActionRequest"", []];" \n "        if ((typeName _request) == ""ARRAY"" && {(count _request) >= 6} && {(_request param [4, """"]) == ""UNO""}) then {" \n "            private _tableNetId = _request param [1, """"];" \n "            if ((typeName _tableNetId) == ""STRING"") then {" \n "                private _table = objectFromNetId _tableNetId;" \n "                if (!isNull _table && {_table getVariable [""PGS_UNOActive"", false]}) then {" \n "                    private _role = (_table getVariable [""PGS_UNOPlayers"", []]) find _unit;" \n "                    private _state = _table getVariable [""PGS_UNOSnapshotServer"", []];" \n "                    private _hands = _table getVariable [""PGS_UNOHandsServer"", []];" \n "                    if (" \n "                        _role >= 0" \n "                        && {(_state param [13, -1]) == _role}" \n "                        && {(count (_hands param [_role, []])) == 1}" \n "                    ) then {" \n "                        [_unit, +_request] call PGS_fnc_processUNOActionRequestServer;" \n "                    };" \n "                };" \n "            };" \n "        };" \n "    } forEach _players;" \n "" \n "    {" \n "        private _unit = _x;" \n "        private _request = _unit getVariable [""PGS_UNOActionRequest"", []];" \n "        if ((typeName _request) == ""ARRAY"" && {(count _request) >= 6} && {(_request param [4, """"]) == ""CALLOUT""}) then {" \n "            [_unit, +_request] call PGS_fnc_processUNOActionRequestServer;" \n "        };" \n "    } forEach _players;" \n "};" \n "" \n "PGS_fnc_processPlayerRequestsServer = {" \n "    params [[""_unit"", objNull]];" \n "    if (!isServer || {isNull _unit}) exitWith {};" \n "    private _join = _unit getVariable [""PGS_JoinRequest"", []];" \n "    if ((typeName _join) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_JoinRequest"", [], true];" \n "        _join = [];" \n "    } else {" \n "        _join = +_join;" \n "    };" \n "    if ((count _join) > 0) then {" \n "        [_unit, _join] call PGS_fnc_processJoinRequestServer;" \n "    };" \n "    private _leave = _unit getVariable [""PGS_LeaveRequest"", []];" \n "    if ((typeName _leave) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_LeaveRequest"", [], true];" \n "        _leave = [];" \n "    } else {" \n "        _leave = +_leave;" \n "    };" \n "    if ((count _leave) > 0) then {" \n "        [_unit, _leave] call PGS_fnc_processLeaveRequestServer;" \n "    };" \n "    private _vote = _unit getVariable [""PGS_VoteRequest"", []];" \n "    if ((typeName _vote) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_VoteRequest"", [], true];" \n "        _vote = [];" \n "    } else {" \n "        _vote = +_vote;" \n "    };" \n "    if ((count _vote) > 0) then {" \n "        [_unit, _vote] call PGS_fnc_processVoteRequestServer;" \n "    };" \n "    private _ready = _unit getVariable [""PGS_ReadyRequest"", []];" \n "    if ((typeName _ready) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_ReadyRequest"", [], true];" \n "        _ready = [];" \n "    } else {" \n "        _ready = +_ready;" \n "    };" \n "    if ((count _ready) > 0) then {" \n "        [_unit, _ready] call PGS_fnc_processReadyRequestServer;" \n "    };" \n "    private _battleshipAction = _unit getVariable [""PGS_BattleshipActionRequest"", []];" \n "    if ((typeName _battleshipAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_BattleshipActionRequest"", [], true];" \n "        _battleshipAction = [];" \n "    } else {" \n "        _battleshipAction = +_battleshipAction;" \n "    };" \n "    if ((count _battleshipAction) > 0) then {" \n "        [_unit, _battleshipAction] call PGS_fnc_processBattleshipActionRequestServer;" \n "    };" \n "    private _whosWhoAction = _unit getVariable [""PGS_WhosWhoActionRequest"", []];" \n "    if ((typeName _whosWhoAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_WhosWhoActionRequest"", [], true];" \n "        _whosWhoAction = [];" \n "    } else {" \n "        _whosWhoAction = +_whosWhoAction;" \n "    };" \n "    if ((count _whosWhoAction) > 0) then {" \n "        [_unit, _whosWhoAction] call PGS_fnc_processWhosWhoActionRequestServer;" \n "    };" \n "    private _shotgunAction = _unit getVariable [""PGS_ShotgunActionRequest"", []];" \n "    if ((typeName _shotgunAction) != ""ARRAY"") then {" \n "        _unit setVariable [""PGS_ShotgunActionRequest"", [], true];" \n "        _shotgunAction = [];" \n "    } else {" \n "        _shotgunAction = +_shotgunAction;" \n "    };" \n "    if ((count _shotgunAction) > 0) then {" \n "        [_unit, _shotgunAction] call PGS_fnc_processShotgunActionRequestServer;" \n "    };" \n "    private _rpsAction = _unit getVariable [""PGS_RPSActionRequ