"    ]] call PGS_fnc_resultServer;" \n "};" \n "" \n "PGS_fnc_processReadyRequestServer = {" \n "    params [" \n "        [""_unit"", objNull]," \n "        [""_request"", []]" \n "    ];" \n "    if (!isServer || {isNull _unit}) exitWith {};" \n "    _unit setVariable [""PGS_ReadyRequest"", [], true];" \n "    if ((count _request) < 3) exitWith {};" \n "    private _token = _request param [0, """"];" \n "    if (!([_token] call PGS_fnc_rememberHandledTokenServer)) exitWith {};" \n "    if (!alive _unit) exitWith {" \n "        [_unit, _token, ""Only living players may ready at the table.""] call PGS_fnc_resultServer;" \n "    };" \n "    private _tableNetId = _request param [1, """"];" \n "    private _desired = _request param [2, false];" \n "    if ((typeName _tableNetId) != ""STRING"") exitWith {" \n "        [_unit, _token, ""Ready request rejected: malformed table data.""] call PGS_fnc_resultServer;" \n "    };" \n "    private _table = objectFromNetId _tableNetId;" \n "    if ((typeName _desired) != ""BOOL"") then {" \n "        if ((typeName _desired) == ""SCALAR"") then {" \n "            _desired = _desired > 0;" \n "        } else {" \n "            _desired = false;" \n "        };" \n "    };" \n "    if (isNull _table || {_table != (_unit getVariable [""PGS_SeatedTable"", objNull])}) exitWith {" \n "        [_unit, _token, ""Ready request rejected: you are no longer at that table.""] call PGS_fnc_resultServer;" \n "    };" \n "    if ([_table] call PGS_fnc_isTableGameActive) exitWith {" \n "        [_unit, _token, ""Ready state is locked while a table game is in progress.""] call PGS_fnc_resultServer;" \n "    };" \n "    private _seatIndex = [_table, _unit] call PGS_fnc_getSeatIndex;" \n "    if (_seatIndex < 0) exitWith {" \n "        [_unit, _token, ""Ready request rejected: your seat assignment is stale.""] call PGS_fnc_resultServer;" \n "    };" \n "    private _selectedGame = _table getVariable [""PGS_TableSelectedGame"", """"];" \n "    if (_de