 []];" \n "    };" \n "};" \n "" \n "PGS_fnc_startAuthorityLoop = {" \n "    if (!isServer) exitWith {};" \n "    if (missionNamespace getVariable [""PGS_AuthorityLoopStarted"", false]) exitWith {};" \n "    missionNamespace setVariable [""PGS_AuthorityLoopStarted"", true];" \n "    [] spawn {" \n "        private _nextMaintenance = 0;" \n "        while {true} do {" \n "            private _authorityPlayers = +allPlayers;" \n "            {" \n "                [_x] call PGS_fnc_initializePlayerServer;" \n "            } forEach _authorityPlayers;" \n "            call PGS_fnc_reconcileRegisteredTablesServer;" \n "            [_authorityPlayers] call PGS_fnc_processPriorityUNORequestsServer;" \n "            {" \n "                [_x] call PGS_fnc_processPlayerRequestsServer;" \n "            } forEach _authorityPlayers;" \n "            if (serverTime >= _nextMaintenance) then {" \n "                call PGS_fnc_reconcileRegistriesServer;" \n "                _nextMaintenance = serverTime + PGS_CFG_MAINTENANCE_TICK;" \n "            };" \n "            sleep PGS_CFG_AUTHORITY_TICK;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_submitJoinRequestLocal = {" \n "    params [[""_table"", objNull]];" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    if (isNull _table) exitWith {" \n "        hintSilent ""That party table is unavailable."";" \n "    };" \n "    if (!alive player) exitWith {" \n "        hintSilent ""You must be alive to sit at the table."";" \n "    };" \n "    private _token = [""JOIN""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_JoinRequest""," \n "        [_token, netId _table, getPosATL player]," \n "        true" \n "    ];" \n "    hintSilent ""Requesting a seat from the table host..."";" \n "};" \n "" \n "PGS_fnc_submitLeaveRequestLocal = {" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    private _table = player getVariable [""PGS_SeatedTable"", objNull];" \n "    private _token = [""LEAVE""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_LeaveRequest""," \n "        [_token, if (isNull _table) then {""""} else {netId _table}]," \n "        true" \n "    ];" \n "    hintSilent ""Leaving the party table..."";" \n "};" \n "" \n "PGS_fnc_submitVoteRequestLocal = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_gameId"", """"]" \n "    ];" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    if (isNull _table || {_gameId == """"}) exitWith {" \n "        hintSilent ""Select an available game before voting."";" \n "    };" \n "    private _token = [""VOTE""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_VoteRequest""," \n "        [_token, netId _table, _gameId]," \n "        true" \n "    ];" \n "    hintSilent ""Submitting your table vote..."";" \n "};" \n "" \n "PGS_fnc_submitReadyRequestLocal = {" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_desired"", true]" \n "    ];" \n "    if (!hasInterface || {isNull player} || {isNull _table}) exitWith {};" \n "    private _token = [""READY""] call PGS_fnc_makeToken;" \n "    player setVariable [" \n "        ""PGS_ReadyRequest""," \n "        [_token, netId _table, _desired]," \n "        true" \n "    ];" \n "    hintSilent ""Updating your ready state..."";" \n "};" \n "" \n "PGS_fnc_submitBattleshipActionRequestLocal = {" \n "    params [[""_table"", objNull], [""_action"", """"], [""_payload"", []]];" \n "    if (!hasInterface || {isNull player} || {isNull _table} || {_action == """"}) exitWith {false};" \n "    private _pending = missionNamespace getVariable [""PGS_BattleshipPendingRequestLocal"", []];" \n "    if ((count _pending) >= 2 && {(diag_tickTime - (_pending param [1, -10])) < 1.5}) exitWith {" \n "        hintSilent ""Waiting for the table host to answer your previous Battleship action..."";" \n "        false" \n "    };" \n "    private _token = [""BATTLESHI