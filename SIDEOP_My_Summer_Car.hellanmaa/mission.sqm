ndex," \n "                alive player && {(lifeState player) != ""INCAPACITATED""} && {(vehicle player) == player}" \n "            ] call PGS_fnc_releaseSeatPoseLocal;" \n "        };" \n "        _trackedTable = objNull;" \n "        _trackedIndex = -1;" \n "        _trackedToken = """";" \n "        call PGS_fnc_closeLobbyIfInvalidLocal;" \n "    } else {" \n "        private _newSeat = _trackedTable != _table" \n "            || {_trackedIndex != _seatIndex}" \n "            || {_trackedToken != _seatToken};" \n "        if (_newSeat && {!isNull _trackedTable}) then {" \n "            [player, _trackedTable, _trackedIndex, false] call PGS_fnc_releaseSeatPoseLocal;" \n "        };" \n "        _trackedTable = _table;" \n "        _trackedIndex = _seatIndex;" \n "        _trackedToken = _seatToken;" \n "        [player, _table, _seatIndex] call PGS_fnc_applySeatPoseLocal;" \n "        if (_newSeat) then {" \n "            [_table] call PGS_fnc_openCurrentTableScreenLocal;" \n "        };" \n "        call PGS_fnc_closeLobbyIfInvalidLocal;" \n "    };" \n "" \n "    missionNamespace setVariable [""PGS_SeatUnitLocal"", _trackedUnit];" \n "    missionNamespace setVariable [""PGS_SeatTableLocal"", _trackedTable];" \n "    missionNamespace setVariable [""PGS_SeatIndexLocal"", _trackedIndex];" \n "    missionNamespace setVariable [""PGS_SeatTokenLocal"", _trackedToken];" \n "}; " \n " " \n "PGS_fnc_refreshLobbyLocal = {" \n "    disableSerialization;" \n "    params [[""_display"", displayNull]];" \n "    if (isNull _display) exitWith {};" \n "    if (_display getVariable [""PGS_LobbyRefreshing"", false]) exitWith {};" \n "    _display setVariable [""PGS_LobbyRefreshing"", true];" \n "    private _table = _display getVariable [""PGS_LobbyTable"", objNull];" \n "    if (isNull _table || {isNull player} || {(player getVariable [""PGS_SeatedTable"", objNull]) != _table}) exitWith {" \n "        _display closeDisplay 1;" \n "    };" \n "" \n "    private _playerList = _display getVariable [""PGS_LobbyPlayerList"", controlNull];" \n "    private _gameList = _display getVariable [""PGS_LobbyGameList"", controlNull];" \n "    private _playerLabel = _display getVariable [""PGS_LobbyPlayerLabel"", controlNull];" \n "    private _gameName = _display getVariable [""PGS_LobbyGameName"", controlNull];" \n "    private _descriptionOne = _display getVariable [""PGS_LobbyDescriptionOne"", controlNull];" \n "    private _descriptionTwo = _display getVariable [""PGS_LobbyDescriptionTwo"", controlNull];" \n "    private _playersText = _display getVariable [""PGS_LobbyPlayersText"", controlNull];" \n "    private _votesTextOne = _display getVariable [""PGS_LobbyVotesTextOne"", controlNull];" \n "    private _votesTextTwo = _display getVariable [""PGS_LobbyVotesTextTwo"", controlNull];" \n "    private _availability = _display getVariable [""PGS_LobbyAvailability"", controlNull];" \n "    private _moduleNoteOne = _display getVariable [""PGS_LobbyModuleNoteOne"", controlNull];" \n "    private _moduleNoteTwo = _display getVariable [""PGS_LobbyModuleNoteTwo"", controlNull];" \n "    private _statusOne = _display getVariable [""PGS_LobbyStatusOne"", controlNull];" \n "    private _statusTwo = _display getVariable [""PGS_LobbyStatusTwo"", controlNull];" \n "    private _voteButton = _display getVariable [""PGS_LobbyVoteButton"", controlNull];" \n "    private _readyButton = _display getVariable [""PGS_LobbyReadyButton"", controlNull];" \n "" \n "    private _seats = [(_table getVariable [""PGS_TableSeats"", []])] call PGS_fnc_normalizeSeats;" \n "    private _votes = [(_table getVariable [""PGS_TableVotes"", []])] call PGS_fnc_normalizeVotes;" \n "    private _ready = [(_table getVariable [""PGS_TableReady"", []])] call PGS_fnc_normalizeReady;" \n "    private _occupants = [_table] call PGS_fnc_getTableOccupantCount;" \n "    private _revision = _table getVariable [""PGS_TableRevision"", 0];" \n "    private _lastRevision = _display getVariable [""PGS_LobbyLastRevision"", -1];" \n "" \n "    if (!isNull _playerLabel) then {" \n "        _playerLabel ctrlSetText format [""Players at Table  (%1/%2)"", _occupants, PGS_CFG_SEAT_COUNT];" \n "        _playerLabel ctrlCommit 0;" \n "    };" \n "" \n "    if (_revision != _lastRevision) then {" \n "        private _selectedGameId = _display getVariable [""PGS_LobbySelectedGameId"", """"];" \n "        if (!isNull _gameList) then {" \n "            private _oldSelection = lbCurSel _gameList;" \n "            if (_oldSelection >= 0) then {" \n "                _selectedGameId = _gameList lbData _oldSelection;" \n "            };" \n "        };" \n "" \n "        if (!isNull _playerList) then {" \n "            lbClear _playerList;" \n "            for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "                private _unit = _seats param [_index, objNull];" \n "                private _row = -1;" \n "                if (isNull _unit) then {" \n "                    _row = _playerList lbAdd format [""Seat %1  -  Open"", _index + 1];" \n "                    _playerList lbSetColor [_row, [0.55, 0.58, 0.62, 1]];" \n "                } else {" \n "                    private _voteId = _votes param [_index, """"];" \n "                    private _voteName = [_voteId] call PGS_fnc_getGameName;" \n "                    private _readyText = if (_ready param [_index, false]) then {""READY""} else {""NOT READY""};" \n "                    _row = _playerList lbAdd format [" \n "                        ""Seat %1  -  %2  [%3]""," \n "                        _index + 1," \n "                        name _unit," \n "                        _readyText" \n "                    ];" \n "                    _playerList lbSetTooltip [_row, format [" \n "                        ""%1 - Vote: %2 - %3""," \n "                        name _unit," \n "                        _voteName," \n "                        _readyText" \n "                    ]];" \n "                    if (_unit == player) then {" \n "                        _playerList lbSetColor [_row, [0.30, 0.90, 1, 1]];" \n "                    } else {" \n "                        if (_ready param [_index, false]) then {" \n "                            _playerList lbSetColor [_row, [0.38, 1, 0.48, 1]];" \n "                        };" \n "                    };" \n "                };" \n "            };" \n "        };" \n "" \n "        if (!isNull _gameList) then {" \n "            lbClear _gameList;" \n "            private _selectionIndex = -1;" \n "            {" \n "                private _gameId = _x param [0, """"];" \n "                private _eligible = [_table, _gameId] call PGS_fnc_isGameEligibleAtTable;" \n "                private _voteCount = [_table, _gameId] call PGS_fnc_getVoteCount;" \n "                private _lockText = if (_eligible) then {""OPEN""} else {""LOCKED""};" \n "                private _row = _gameList lbAdd format [" \n "                    ""%1  [%2]  (%3)""," \n "                    _x param [1, ""Game""]," \n "                    _lockText," \n "                    _voteCount" \n "                ];" \n "                _gameList lbSetData [_row, _gameId];" \n "                _gameList lbSetTooltip [_row, format [" \n "                    ""%1 - %2""," \n "                    [_x] call PGS_fnc_getPlayerRequirementText," \n "                    (_x param [2, [""""]]) param [0, """"]" \n "                ]];" \n "                if (!_eligible) then {" \n "                    _gameList lbSetColor [_row, [0.58, 0.58, 0.62, 1]];" \n "                };" \n "                if (_gameId == _selectedGameId) then {" \n "                    _selectionIndex = _row;" \n "                };" \n "            } forEach PGS_Games;" \n "            if (_selectionIndex < 0 && {(lbSize _gameList) > 0}) then {" \n "                _selectionIndex = 0;" \n "            };" \n "            if (_selectionIndex >= 0) then {" \n "                _gameList lbSetCurSel _selectionIndex;" \n "                _selectedGameId = _gameList lbData _selectionIndex;" \n "            };" \n "            _display setVariable [""PGS_LobbySelectedGameId"", _selectedGameId];" \n "        };" \n "        _display setVariable [""PGS_LobbyLastRevision"", _revision];" \n "    };" \n "" \n "    private _selectedListIndex = if (isNull _gameList) then {-1} else {lbCurSel _gameList};" \n "    private _selectedGameId = _display getVariable [""PGS_LobbySelectedGameId"", """"];" \n "    if (_selectedListIndex >= 0 && {!isNull _gameList}) then {" \n "        _selectedGameId = _gameList lbData _selectedListIndex;" \n "        _display setVariable [""PGS_LobbySelectedGameId"", _selectedGameId];" \n "    };" \n "    private _game = [_selectedGameId] call PGS_fnc_getGame;" \n "    private _eligible = [_table, _selectedGameId] call PGS_fnc_isGameEligibleAtTable;" \n "    private _voteCount = [_table, _selectedGameId] call PGS_fnc_getVoteCount;" \n "    private _requiredVotes = _table getVariable [" \n "        ""PGS_TableRequiredVotes""," \n "        floor (_occupants / 2) + 1" \n "    ];" \n "    private _consensusGame = _table getVariable [""PGS_TableSelectedGame"", """"];" \n "    private _phase = _table getVariable [""PGS_TablePhase"", ""LOBBY""];" \n "    private _seatIndex = _seats find player;" \n "    private _localReady = _seatIndex >= 0 && {_ready param [_seatIndex, false]};" \n "" \n "    if (!isNull _gameName) then {" \n "        _gameName ctrlSetText (_game param [1, ""Select a game""]);" \n "        _gameName ctrlCommit 0;" \n "    };" \n "    private _descriptionLines = _game param [" \n "        2," \n "        [""Select a game from the list to inspect it."", """"]" \n "    ];" \n "    if ((typeName _descriptionLines) != ""ARRAY"") then {" \n "        _descriptionLines = [_descriptionLines, """"];" \n "    };" \n "    if (!isNull _descriptionOne) then {" \n "        _descriptionOne ctrlSetText (_descriptionLines param [0, """"]);" \n "        _descriptionOne ctrlCommit 0;" \n "    };" \n "    if (!isNull _descriptionTwo) then {" \n "        _descriptionTwo ctrlSetText (_descriptionLines param [1, """"]);" \n "        _descriptionTwo ctrlCommit 0;" \n "    };" \n "    if (!isNull _playersText) then {" \n "        _playersText ctrlSetText format [" \n "            ""Player requirement: %1""," \n "            [_game] call PGS_fnc_getPlayerRequirementText" \n "        ];" \n "        _playersText ctrlCommit 0;" \n "    };" \n "    if (!isNull _votesTextOne) then {" \n "        _votesTextOne ctrlSetText format [""Current votes: %1"", _voteCount];" \n "        _votesTextOne ctrlCommit 0;" \n "    };" \n "    if (!isNull _votesTextTwo) then {" \n "        _votesTextTwo ctrlSetText format [" \n "            ""Consensus needs %1 matching vote(s)""," \n "            _requiredVotes" \n "        ];" \n "        _votesTextTwo ctrlCommit 0;" \n "    };" \n "    if (!isNull _availability) then {" \n "        _availability ctrlSetText (if (_eligible) then {" \n "            ""AVAILABLE for the current table size""" \n "        } else {" \n "            ""LOCKED for the current table size""" \n "        });" \n "        _availability ctrlSetTextColor (if (_eligible) then {" \n "            [0.38, 1, 0.48, 1]" \n "        } else {" \n "            [1, 0.43, 0.32, 1]" \n "        });" \n "        _availability ctrlCommit 0;" \n "    };" \n "    private _moduleLines = _game param [" \n "        5," \n "        [""Game implementation is not available yet."", """"]" \n "    ];" \n "    if ((typeName _moduleLines) != ""ARRAY"") then {" \n "        _moduleLines = [_moduleLines, """"];" \n "    };" \n "    if (!isNull _moduleNoteOne) then {" \n "        _moduleNoteOne ctrlSetText (_moduleLines param [0, """"]);" \n "        _moduleNoteOne ctrlCommit 0;" \n "    };" \n "    if (!isNull _moduleNoteTwo) then {" \n "        _moduleNoteTwo ctrlSetText (_moduleLines param [1, """"]);" \n "        _moduleNoteTwo ctrlCommit 0;" \n "    };" \n "" \n "    private _readyCount = 0;" \n "    for ""_index"" from 0 to (PGS_CFG_SEAT_COUNT - 1) do {" \n "        if (!isNull (_seats param [_index, objNull]) && {_ready param [_index, false]}) then {" \n "            _readyCount = _readyCount + 1;" \n "        };" \n "    };" \n "    private _statusLineOne = ""Waiting for a player."";" \n "    private _statusLineTwo = ""Blackjack supports a solo table."";" \n "    if (_occupants >= 1) then {" \n "        if (_consensusGame == """") then {" \n "            _statusLineOne = if (_occupants == 1) then {""Solo table: Blackjack is available.""} else {format [""No consensus: %1 matching vote(s) required."", _requiredVotes]};" \n "            _statusLineTwo = if (_occupants == 1) then {""Vote for Blackjack, or invite another player.""} else {""Choose the same supported game.""};" \n "        } else {" \n "            if (_phase == ""READY"") then {" \n "                _statusLineOne = format [" \n "                    ""EVERYONE READY: %1""," \n "                    [_consensusGame] call PGS_fnc_getGameName" \n "                ];" \n "                _statusLineTwo = if (_consensusGame == ""checkers"") then {" \n "                    ""Launching the authoritative Checkers board...""" \n "                } else {" \n "                    if (_consensusGame == ""rps"") then {" \n "                        ""Preparing the hidden-choice reveal...""" \n "                    } else {" \n "                        if (_consensusGame == ""blackjack"") then {" \n "                            ""Opening the authoritative Blackjack table...""" \n "                        } else {" \n "                            if (_consensusGame == ""chess"") then {" \n "                                ""Launching the authoritative Chess board...""" \n "                            } else {" \n "                                if (_consensusGame == ""poker"") then {" \n "                                    ""Shuffling the authoritative Poker deck...""" \n "                                } else {" \n "                                    if (_consensusGame == ""uno"") then {" \n "                                        ""Dealing the authoritative UNO hands...""" \n "                                    } else {" \n "                                        if (_consensusGame == ""battleship"") then {" \n "                                            ""Opening two private fleet deployment grids...""" \n "                                        } else {" \n "                                            ""The game module is preparing.""" \n "                                        }" \n "                                    }" \n "                                }" \n "                            }" \n "                        }" \n "                    }" \n "                };" \n "            } else {" \n "                _statusLineOne = format [" \n "                    ""Consensus: %1""," \n "                    [_consensusGame] call PGS_fnc_getGameName" \n "                ];" \n "                _statusLineTwo = format [""Ready: %1/%2"", _readyCount, _occupants];" \n "            };" \n "        };" \n "    };" \n "    if (!isNull _statusOne) then {" \n "        _statusOne ctrlSetText _statusLineOne;" \n "        _statusOne ctrlCommit 0;" \n "    };" \n "    if (!isNull _statusTwo) then {" \n "        _statusTwo ctrlSetText _statusLineTwo;" \n "        _statusTwo ctrlCommit 0;" \n "    };" \n "    if (!isNull _voteButton) then {" \n "        _voteButton ctrlSetText format [""Vote: %1"", _game param [1, ""Game""]];" \n "        _voteButton ctrlEnable (_seatIndex >= 0 && {_eligible});" \n "        _voteButton ctrlCommit 0;" \n "    };" \n "    if (!isNull _readyButton) then {" \n "        _readyButton ctrlSetText (if (_localReady) then {""Cancel Ready""} else {""Set Ready""});" \n "        _readyButton ctrlEnable (_seatIndex >= 0 && {_localReady || {_consensusGame != """"}});" \n "        _readyButton ctr