rams [""_activeDisplay""];" \n "        while {!isNull _activeDisplay} do {" \n "            [_activeDisplay] call PGS_fnc_refreshCheckersLocal;" \n "            uiSleep PGS_CFG_CHECKERS_UI_TICK;" \n "        };" \n "    };" \n "}; " \n " " \n "PGS_fnc_getChessPlayerSideLocal = {" \n "    params [[""_table"", objNull]];" \n "    if (isNull _table || {isNull player}) exitWith {0};" \n "    private _players = _table getVariable [""PGS_ChessPlayers"", [objNull, objNull]];" \n "    private _roleIndex = _players find player;" \n "    if (_roleIndex == 0) exitWith {1};" \n "    if (_roleIndex == 1) exitWith {-1};" \n "    0" \n "};" \n "" \n "PGS_fnc_chessGetSquareName = {" \n "    params [[""_index"", -1]];" \n "    if (_index < 0 || {_index > 63}) exitWith {""?""};" \n "    private _files = [""a"", ""b"", ""c"", ""d"", ""e"", ""f"", ""g"", ""h""];" \n "    private _row = floor (_index / 8);" \n "    private _column = _index mod 8;" \n "    format [""%1%2"", _files param [_column, ""?""], 8 - _row]" \n "};" \n "" \n "PGS_fnc_chessGetMarkerTextureLocal = {" \n "    params [[""_piece"", 0]];" \n "    private _markerClass = [_piece] call PGS_fnc_chessGetMarkerClass;" \n "    if (_markerClass == """") exitWith {""""};" \n "    private _config = configFile >> ""CfgMarkers"" >> _markerClass;" \n "    private _texture = getText (_config >> ""icon"");" \n "    if (_texture == """") then {" \n "        _texture = getText (_config >> ""texture"");" \n "    };" \n "    _texture" \n "};" \n "" \n "PGS_fnc_selectChessPromotionLocal = {" \n "    disableSerialization;" \n "    params [[""_control"", controlNull]];" \n "    if (isNull _control) exitWith {};" \n "    private _display = ctrlParent _control;" \n "    if (isNull _display) exitWith {};" \n "    private _focusSink = _display getVariable [""PGS_ChessFocusSink"", controlNull];" \n "    if (!isNull _focusSink) then {" \n "        ctrlSetFocus _focusSink;" \n "    };" \n "    private _table = _display getVariable [""PGS_ChessTable"", objNull];" \n "    private _pending = _display getVariable [""PGS_ChessPromotionPending"", []];" \n "    private _promotionType = _control getVariable [""PGS_ChessPromotionType"", 0];" \n "    if (isNull _table || {(count _pending) < 3} || {!(_promotionType in [2, 3, 4, 5])}) exitWith {};" \n "    private _from = _pending param [0, -1];" \n "    private _to = _pending param [1, -1];" \n "    private _revision = _pending param [2, -1];" \n "    _display setVariable [""PGS_ChessPromotionPending"", []];" \n "    _display setVariable [""PGS_ChessMovePending"", true];" \n "    _display setVariable [""PGS_ChessSelectedFrom"", -1];" \n "    [_table, _from, _to, _promotionType, _revision] call PGS_fnc_submitChessMoveRequestLocal;" \n "    [_display] call PGS_fnc_refreshChessLocal;" \n "};" \n "" \n "PGS_fnc_handleChessSquareClickLocal = {" \n "    disableSerialization;" \n "    params [[""_control"", controlNull]];" \n "    if (isNull _control) exitWith {};" \n "    private _display = ctrlParent _control;" \n "    if (isNull _display) exitWith {};" \n "    private _focusSink = _display getVariable [""PGS_ChessFocusSink"", controlNull];" \n "    if (!isNull _focusSink) then {" \n "        ctrlSetFocus _focusSink;" \n "    };" \n "    private _table = _display getVariable [""PGS_ChessTable"", objNull];" \n "    private _index = _control getVariable [""PGS_ChessSquareIndex"", -1];" \n "    if (isNull _table || {_index < 0} || {_index > 63}) exitWith {};" \n "    if (([_table] call PGS_fnc_getTableActiveGameId) != ""chess"") exitWith {" \n "        hintSilent ""That Chess match is no longer active."";" \n "    };" \n "    if (_table getVariable [""PGS_ChessFinished"", false]) exitWith {" \n "        hintSilent ""The match is finished. Reset it to return to the lobby."";" \n "    };" \n "    private _side = [_table] call PGS_fnc_getChessPlayerSideLocal;" \n "    if (_side == 0) exitWith {" \n "        hintSilent ""Only the two assigned players may move these pieces."";" \n "    };" \n "    if ((_table getVariable [""PGS_ChessTurn"", 1]) != _side) exitWith {" \n "        hintSilent ""It is the other player's turn."";" \n "    };" \n "    if (_display getVariable [""PGS_ChessMovePending"", false]) exitWith {" \n "        hintSilent ""Waiting for the table host to confirm your move..."";" \n "    };" \n "    if ((count (_display getVariable [""PGS_ChessPromotionPending"", []])) > 0) then {" \n "        _display setVariable [""PGS_ChessPromotionPending"", []];" \n "    };" \n "    private _revision = _table getVariable [""PGS_ChessRevision"", 0];" \n "    private _board = [(_table getVariable [""PGS_ChessBoard"", []])] call PGS_fnc_chessNormalizeBoard;" \n "    private _rights = [(_table getVariable [""PGS_ChessCastlingRights"", []])] call PGS_fnc_chessNormalizeCastlingRights;" \n "    private _enPassant = _table getVariable [""PGS_ChessEnPassant"", -1];" \n "    private _selected = _display getVariable [""PGS_ChessSelectedFrom"", -1];" \n "    private _pieceSide = [_board param [_index, 0]] call PGS_fnc_chessPieceSide;" \n "    if (_pieceSide == _side) exitWith {" \n "        private _moves = [_board, _side, _index, _rights, _enPassant] call PGS_fnc_chessGetLegalMoves;" \n "        if ((count _moves) <= 0) then {" \n "            hintSilent ""That piece has no legal move in the current position."";" \n "        } else {" \n "            _display setVariable [""PGS_ChessSelectedFrom"", _index];" \n "            [_display] call PGS_fnc_refreshChessLocal;" \n "        };" \n "    };" \n "    if (_selected < 0) exitWith {" \n "        hintSilent ""Select one of your pieces first."";" \n "    };" \n "    private _legalMoves = [_board, _side, _selected, _rights, _enPassant] call PGS_fnc_chessGetLegalMoves;" \n "    private _special = ""INVALID"";" \n "    {" \n "        if ((_x param [0, -1]) == _index) exitWith {" \n "            _special = _x param [1, """"];" \n "        };" \n "    } forEach _legalMoves;" \n "    if (_special == ""INVALID"") exitWith {" \n "        hintSilent ""Choose one of the highlighted legal destinations."";" \n "    };" \n "    if (_special == ""PROMOTION"") exitWith {" \n "        _display setVariable [""PGS_ChessPromotionPending"", [_selected, _index, _revision]];" \n "        [_display] call PGS_fnc_refreshChessLocal;" \n "        hintSilent ""Choose the unit type for this pawn's promotion."";" \n "    };" \n "    _display setVariable [""PGS_ChessMovePending"", true];" \n "    _display setVariable [""PGS_ChessSelectedFrom"", -1];" \n "    [_table, _selected, _index, 0, _revision] call PGS_fnc_submitChessMoveRequestLocal;" \n "};" \n "" \n "PGS_fnc_handleChessResignLocal = {" \n "    disableSerialization;" \n "    params [[""_control"", controlNull]];" \n "    if (isNull _control) exitWith {};" \n "    private _display = ctrlParent _control;" \n "    if (isNull _display) exitWith {};" \n "    private _table = _display getVariable [""PGS_ChessTable"", objNull];" \n "    if (isNull _table) exitWith {};" \n "    private _armedUntil = _display getVariable [""PGS_ChessResignArmedUntil"", -1];" \n "    if (diag_tickTime <= _armedUntil) then {" \n "        _display setVariable [""PGS_ChessResignArmedUntil"", -1];" \n "        [_table, ""RESIGN""] call PGS_fnc_submitChessActionRequestLocal;" \n "    } else {" \n "        _display setVariable [""PGS_ChessResignArmedUntil"", diag_tickTime + 3];" \n "        hintSilent ""Press Resign again within three seconds to confirm."";" \n "    };" \n "};" \n "" \n "PGS_fnc_refreshChessLocal = {" \n "    disableSerialization;" \n "    params [[""_display"", displayNull]];" \n "    if (isNull _display) exitWith {};" \n "    if (_display getVariable [""PGS_ChessRefreshing"", false]) exitWith {};" \n "    _display setVariable [""PGS_ChessRefreshing"", true];" \n "    private _table = _display getVariable [""PGS_ChessTable"", objNull];" \n "    private _spectating = _display getVariable [""PGS_SpectatorMode"", false];" \n "    if (!([_table, _spectating] call PGS_fnc_isValidGameViewerLocal)) exitWith {" \n "        _display closeDisplay 1;" \n "    };" \n "    if (([_table] call PGS_fnc_getTableActiveGameId) != ""chess"") exitWith {" \n "        if (_spectating) then {" \n "            [true] call PGS_fnc_exitSpectatorLocal;" \n "        } else {" \n "            _display closeDisplay 1;" \n "            [_table] spawn {" \n "                params [""_lobbyTable""];" \n "                uiSleep 0.1;" \n "                if (!isNull _lobbyTable && {_lobbyTable == (player getVariable [""PGS_SeatedTable"", objNull])}) then {" \n "                    [_lobbyTable] call PGS_fnc_openLobbyLocal;" \n "                };" \n "            };" \n "        };" \n "    };" \n "" \n "    private _side = [_table] call PGS_fnc_getChessPlayerSideLocal;" \n "    private _board = [(_table getVariable [""PGS_ChessBoard"", []])] call PGS_fnc_chessNormalizeBoard;" \n "    private _turn = _table getVariable [""PGS_ChessTurn"", 1];" \n "    private _rights = [(_table getVariable [""PGS_ChessCastlingRights"", []])] call PGS_fnc_chessNormalizeCastlingRights;" \n "    private _enPassant = _table getVariable [""PGS_ChessEnPassant"", -1];" \n "    private _finished = _table getVariable [""PGS_ChessFinished"", false];" \n "    private _winner = _table getVariable [""PGS_ChessWinner"", 0];" \n "    private _revision = _table getVariable [""PGS_ChessRevision"", 0];" \n "    private _lastRevision = _display getVariable [""PGS_ChessLastRevision"", -1];" \n "    private _selected = _display getVariable [""PGS_ChessSelectedFrom"", -1];" \n "    if (_revision != _lastRevision) then {" \n "        _display setVariable [""PGS_ChessMovePending"", false];" \n "        _display setVariable [""PGS_ChessPromotionPending"", []];" \n "        if (_selected >= 0 && {([_board param [_selected, 0]] call PGS_fnc_chessPieceSide) != _side}) then {" \n "            _selected = -1;" \n "        };" \n "        _display setVariable [""PGS_ChessSelectedFrom"", _selected];" \n "        private _checkedKing = -1;" \n "        if (!_finished && {[_board, _turn] call PGS_fnc_chessIsKingInCheck}) then {" \n "            _checkedKing = [_board, _turn] call PGS_fnc_chessFindKing;" \n "        };" \n "        _display setVariable [""PGS_ChessCheckedKing"", _checkedKing];" \n "        _display setVariable [""PGS_ChessLegalCacheRevision"", -1];" \n "        _display setVariable [""PGS_ChessLastRevision"", _revision];" \n "    };" \n "    private _legalMoves = [];" \n "    if (_selected >= 0 && {_turn == _side} && {!_finished}) then {" \n "        private _cacheRevision = _display getVariable [""PGS_ChessLegalCacheRevision"", -1];" \n "        private _cacheSelected = _display getVariable [""PGS_ChessLegalCacheSelected"", -1];" \n "        if (_cacheRevision != _revision || {_cacheSelected != _selected}) then {" \n "            _legalMoves = [_board, _side, _selected, _rights, _enPassant] call PGS_fnc_chessGetLegalMoves;" \n "            _display setVariable [""PGS_ChessLegalCache"", _legalMoves];" \n "            _display setVariable [""PGS_ChessLegalCacheRevision"", _revision];" \n "            _display setVariable [""PGS_ChessLegalCacheSelected"", _selected];" \n "        } else {" \n "            _legalMoves = _display getVariable [""PGS_ChessLegalCache"", []];" \n "        };" \n "    } else {" \n "        _display setVariable [""PGS_ChessLegalCache"", []];" \n "        _display setVariable [""PGS_ChessLegalCacheSelected"", -1];" \n "    };" \n "    private _legalDestinations = [];" \n "    {" \n "        _legalDestinations pushBack (_x param [0, -1]);" \n "    } forEach _legalMoves;" \n "    private _lastMove = _table getVariable [""PGS_ChessLastMove"", []];" \n "    private _lastFrom = _lastMove param [0, -1];" \n "    private _lastTo = _lastMove param [1, -1];" \n "    private _checkedKing = _display getVariable [""PGS_ChessCheckedKing"", -1];" \n "    private _squareControls = _display getVariable [""PGS_ChessSquareControls"", []];" \n "    private _pieceControls = _display getVariable [""PGS_ChessPieceControls"", []];" \n "    private _selectionPulse = 0.5 + (0.5 * sin (diag_tickTime * 120));" \n "    for ""_controlIndex"" from 0 to ((count _squareControls) - 1) do {" \n "        private _control = _squareControls param [_controlIndex, controlNull];" \n "        private _picture = _pieceControls param [_controlIndex, controlNull];" \n "        if (!isNull _control) then {" \n "            private _index = _control getVariable [""PGS_ChessSquareIndex"", -1];" \n "            private _row = floor (_index / 8);" \n "            private _column = _index mod 8;" \n "            private _dark = ((_row + _column) mod 2) == 1;" \n "            private _background = if (_dark) then {[0.13, 0.17, 0.20, 1]} else {[0.76, 0.75, 0.67, 1]};" \n "            if (_index == _lastFrom || {_index == _lastTo}) then {" \n "                _background = [0.22, 0.34, 0.43, 1];" \n "            };" \n "            if (_index == _checkedKing) then {" \n "                _background = [0.72, 0.08, 0.08, 1];" \n "            };" \n "            if (_index == _selected) then {" \n "                _background = [" \n "                    0.78 + (0.06 * _selectionPulse)," \n "                    0.55 + (0.05 * _selectionPulse)," \n "                    0.12 + (0.02 * _selectionPulse)," \n "                    1" \n "                ];" \n "            };" \n "            if (_index in _legalDestinations) then {" \n "                _background = if ((_board param [_index, 0]) == 0) then {" \n "                    [0.16, 0.55, 0.28, 1]" \n "                } else {" \n "                    [0.64, 0.20, 0.16, 1]" \n "                };" \n "            };" \n "            _control ctrlSetBackgroundColor _background;" \n "            private _piece = _board param [_index, 0];" \n "            private _squareName = [_index] call PGS_fnc_chessGetSquareName;" \n "            private _specialText = """";" \n "            {" \n "                if ((_x param [0, -1]) == _index) exitWith {" \n "                    private _special = _x param [1, """"];" \n "                    _specialText = switch (_special) do {" \n "                        case ""CASTLE_K"": {"" - castle king-side""};" \n "                        case ""CASTLE_Q"": {"" - castle queen-side""};" \n "                        case ""EN_PASSANT"": {"" - en passant""};" \n "                        case ""PROMOTION"": {"" - promotion""};" \n "                        default {"" - legal destination""};" \n "                    };" \n "                };" \n "            } forEach _legalMoves;" \n "            _control ctrlSetTooltip (if (_piece == 0) then {" \n "                format [""%1%2"", _squareName, _specialText]" \n "            } else {" \n "                format [" \n "                    ""%1: %2 %3%4""," \n "                    _squareName," \n "                    [[_piece] call PGS_fnc_chessPieceSide] call PGS_fnc_chessSideName," \n "                    [_piece] call PGS_fnc_chessPieceName," \n "                    _specialText" \n "                ]" \n "            });" \n "            _control ctrlCommit 0;" \n "            if (!isNull _picture) then {" \n "                private _renderedPiece = _picture getVariable [""PGS_ChessRenderedPiece"", 99];" \n "                if (_renderedPiece != _piece) then {" \n "                    if (_piece == 0) then {" \n "                        _picture ctrlShow false;" \n "                    } else {" \n "                        _picture ctrlSetText ([_piece] call PGS_fnc_chessGetMarkerTextureLocal);" \n "                        _picture ctrlSetTextColor (if (_piece > 0) then {" \n "                            [0.18, 0.62, 1, 1]" \n "                        } else {" \n "                            [1, 0.18, 0.14, 1]" \n "                        });" \n "                        _picture ctrlShow true;" \n "                    };" \n "                    _picture setVariable [""PGS_ChessRenderedPiece"", _piece];" \n "                    _picture ctrlCommit 0;" \n "                };" \n "            };" \n "        };" \n "    };" \n "" \n "    private _names = _table getVariable [""PGS_ChessPlayerNames"", [""NATO White"", ""CSAT Black""]];" \n "    private _whiteName = _names param [0, ""NATO White""];" \n "    private _blackName = _names param [1, ""CSAT Black""];" \n "    private _whiteLabel = _display getVariable [""PGS_ChessWhiteLabel"", controlNull];" \n "    private _blackLabel = _display getVariable [""PGS_ChessBlackLabel"", controlNull];" \n "    private _turnLabel = _display getVariable [""PGS_ChessTurnLabel"", controlNull];" \n "    private _statusOne = _display getVariable [""PGS_ChessStatusOne"", controlNull];" \n "    private _statusTwo = _display getVariable [""PGS_ChessStatusTwo"", controlNull];" \n "    private _drawButton = _display getVariable [""PGS_ChessDrawButton"", controlNull];" \n "    private _claimButton = _display getVariable [""PGS_ChessClaimButton"", controlNull];" \n "    private _resignButton = _display getVariable [""PGS_ChessResignButton"", controlNull];" \n "    if (!isNull _whiteLabel) then {" \n "        _whiteLabel ctrlSetText format [""NATO WHITE  %1"", _whiteName];" \n "        _whiteLabel ctrlCommit 0;" \n "    };" \n "    if (!isNull _blackLabel) then {" \n "        _blackLabel ctrlSetText format [""CSAT BLACK  %1"", _blackName];" \n "        _blackLabel ctrlCommit 0;" \n "    };" \n "    if (!isNull _turnLabel) then {" \n "        _turnLabel ctrlSetText (if (_finished) then {" \n "            if (_winner == 0) then {""RESULT: DRAW""} else {format [""WINNER: %1"", [_winner] call PGS_fnc_chessSideName]}" \n "        } else {" \n "            format [""TURN: %1"", [_turn] call PGS_fnc_chessSideName]" \n "        });" \n "        _turnLabel ctrlSetTextColor (if (_finished) then {" \n "            [0.98, 0.80, 0.22, 1]" \n "        } else {" \n "            if (_turn > 0) then {[0.22, 0.66, 1, 1]} else {[1, 0.28, 0.22, 1]}" \n "        });" \n "        _turnLabel ctrlCommit 0;" \n "    };" \n "    if (!isNull _statusOne) then {" \n "        _statusOne ctrlSetText (_table getVariable [""PGS_ChessStatus"", ""Chess in progress.""]);" \n "        _statusOne ctrlCommit 0;" \n "    };" \n "    if (!isNull _statusTwo) then {" \n "        private _yourRole = if (_side == 0) then {""Observer""} else {[_side] call PGS_fnc_chessSideName};" \n "        private _claimText = if ((_table getVariable [""PGS_ChessCanClaimThreefold"", false]) || {_table getVariable [""PGS_ChessCanClaimFifty"", false]}) then {" \n "            ""  DRAW CLAIM AVAILABLE""" \n "        } else {" \n "            """"" \n "        };" \n "        _statusTwo ctrlSetText format [" \n "            ""You: %1   Full move %2   Halfmove clock %3%4""," \n "            _yourRole," \n "            _table getVariable [""PGS_ChessFullmoveNumber"", 1]," \n "            _table getVariable [""PGS_ChessHalfmoveClock"", 0]," \n "            _claimText" \n "        ];" \n "        _statusTwo ctrlCommit 0;" \n "    };" \n "    private _offerSide = _table getVariable [""PGS_ChessDrawOfferSide"", 0];" \n "    if (!isNull _drawButton) then {" \n "        _drawButton ctrlShow !_spectating;" \n "        if (_finished) then {" \n "            _drawButton ctrlSetText ""Reset to Lobby"";" \n "            _drawButton ctrlEnable !_spectating;" \n "        } else {" \n "            _drawButton ctrlSetText (if (_offerSide == 0) then {" \n "                ""Offer Draw""" \n "            } else {" \n "                if (_offerSide == _side) then {""Withdraw Draw""} else {""Accept Draw""}" \n "            });" \n "            _drawButton ctrlEnable (_side != 0);" \n "        };" \n "        _drawButton ctrlCommit 0;" \n "    };" \n "    if (!isNull _claimButton) then {" \n "        private _canClaim = !_finished" \n "            && {!_spectating}" \n "            && {_side == _turn}" \n "            && {(_table getVariable [""PGS_ChessCanClaimThreefold"", false]) || {_table getVariable [""PGS_ChessCanClaimFifty"", false]}};" \n "        _claimButton ctrlSetText (if (_canClaim) then {""Claim Draw""} else {""No Draw Claim""});" \n "        _claimButton ctrlEnable _canClaim;" \n "        _claimButton ctrlShow (!_spectating && {!_finished});" \n "        _claimButton ctrlCommit 0;" \n "    };" \n "    if (!isNull _resignButton) then {" \n "        private _armed = diag_tickTime <= (_display getVariable [""PGS_ChessResignArmedUntil"", -1]);" \n "        _resignButton ctrlSetText (if (_armed) then {""Confirm Resign""} else {""Resign""});" \n "        _resignButton ctrlEnable (!_spectating && {!_finished} && {_side != 0});" \n "        _resignButton ctrlShow (!_spectating && {!_finished});" \n "        _resignButton ctrlCommit 0;" \n "    };" \n "    private _promotionPending = _display getVariable [""PGS_ChessPromotionPending"", []];" \n "    private _promotionControls = _display getVariable [""PGS_ChessPromotionControls"", []];" \n "    private _showPromotion = !_spectating && {(count _promotionPending) >= 3} && {!_finished};" \n "    {" \n "        if (!isNull _x) then {" \n "            _x ctrlShow _showPromotion;" \n "        };" \n "    } forEach _promotionControls;" \n "    _display setVariable [""PGS_ChessRefreshing"", false];" \n "};" \n "" \n "PGS_fnc_openChessLocal = {" \n "    disableSerialization;" \n "    params [" \n "        [""_table"", objNull]," \n "        [""_spectating"", false]" \n "    ];" \n "    if (!hasInterface || {isNull player}) exitWith {};" \n "    if (" \n "        isNull _table" \n "        || {!([_table, _spectating] call PGS_fnc_isValidGameViewerLocal)}" \n "        || {([_table] call PGS_fnc_getTableActiveGameId) != ""chess""}" \n "    ) exitWith {" \n "        hintSilent ""No active Chess match is available to this viewer."";" \n "    };" \n "    private _parent = findDisplay 46;" \n "    if (isNull _parent) exitWith {" \n "        hintSilent ""The Chess display is unavailable."";" \n "    };" \n "    private _lobby = uiNamespace getVariable [""PGS_LobbyDisplay"", displayNull];" \n "    if (!isNull _lobby) then {_lobby closeDisplay 1;};" \n "    private _checkers = uiNamespace getVariable [""PGS_CheckersDisplay"", displayNull];" \n "    if (!isNull _checkers) then {_checkers closeDisplay 1;};" \n "    private _battleship = uiNamespace getVariable [""PGS_BattleshipDisplay"", displayNull];" \n "    if (!isNull _battleship) then {_battleship closeDisplay 1;};" \n "    private _whosWho = uiNamespace getVariable [""PGS_WhosWhoDisplay"", displayNull];" \n "    if (!isNull _whosWho) then {_whosWho closeDisplay 1;};" \n "    private _shotgun = uiNamespace getVariable [""PGS_ShotgunDisplay"", displayNull];" \n "    if (!isNull _shotgun) then {_shotgun closeDisplay 1;};" \n "    private _rps = uiNamespace getVariable [""PGS_RPSDisplay"", displayNull];" \n "    if (!isNull _rps) then {_rps closeDisplay 1;};" \n "    private _blackjack = uiNamespace getVariable [""PGS_BlackjackDisplay"", displayNull];" \n "    if (!isNull _blackjack) then {_blackjack closeDisplay 1;};" \n "    private _existing = uiNamespace getVariable [""PGS_ChessDisplay"", displayNull];" \n "    if (!isNull _existing) then {_existing closeDisplay 1;};" \n "    private _poker = uiNamespace getVariable [""PGS_PokerDisplay"", displayNull];" \n "    if (!isNull _poker) then {_poker closeDisplay 1;};" \n "    private _uno = uiNamespace getVariable [""PGS_UNODisplay"", displayNull];" \n "    if (!isNull _uno) then {_uno closeDisplay 1;};" \n "    private _display = _parent createDisplay ""RscDisplayEmpty"";" \n "    if (isNull _display) exitWith {};" \n "    uiNamespace setVariable [""PGS_ChessDisplay"", _display];" \n "    _display setVariable [""PGS_ChessTable"", _table];" \n "    _display setVariable [""PGS_SpectatorMode"", _spectating];" \n "    _display setVariable [""PGS_ChessLastRevision"", -1];" \n "    _display setVariable [""PGS_ChessSelectedFrom"", -1];" \n "    _display setVariable [""PGS_ChessMovePending"", false];" \n "    _display setVariable [""PGS_ChessPromotionPending"", []];" \n "    _display setVariable [""PGS_ChessResignArmedUntil"", -1];" \n "    [_display] call PGS_fnc_installEscapeGuardLocal; " \n " " \n "    private _focusSink = _display ctrlCreate [""RscButton"", -1];" \n "    _focusSink ctrlSetPosition [-10, -10, 0.001, 0.001];" \n "    _focusSink ctrlSetText """";" \n "    _focusSink ctrlCommit 0;" \n "    _display setVariable [""PGS_ChessFocusSink"", _focusSink];" \n "    ctrlSetFocus _focusSink;" \n "" \n "    private _background = _display ctrlCreate [""RscText"", -1];" \n "    _background ctrlSetPosition [0.005, 0.015, 1.17, 1.055];" \n "    _background ctrlSetBackgroundColor [0.010, 0.014, 0.022, 0.98];" \n "    _background ctrlCommit 0;" \n "    private _topBar = _display ctrlCreate [""RscText"", -1];" \n "    _topBar ctrlSetPosition [0.005, 0.015, 1.17, 0.075];" \n "    _topBar ctrlSetBackgroundColor [0.10, 0.18, 0.27, 1];" \n "    _topBar ctrlCommit 0;" \n "    private _title = _display ctrlCreate [""RscText"", -1];" \n "    _title ctrlSetPosition [0.035, 0.026, 0.55, 0.052];" \n "    _title ctrlSetText ""PARTYGAMES  /  CHESS"";" \n "    _title ctrlSetTextColor [0.84, 0.94, 1, 1];" \n "    _title ctrlSetFontHeight 0.038;" \n "    _title ctrlCommit 0;" \n "    private _subtitle = _display ctrlCreate [""RscText"", -1];" \n "    _subtitle ctrlSetPosition [0.55, 0.035, 0.58, 0.038];" \n "    _subtitle ctrlSetText (if (_spectating) then {""SPECTATOR VIEW  /  NATO White moves first""} else {""NATO White moves first  /  marker-icon command board""});" \n "    _subtitle ctrlSetTextColor [0.70, 0.84, 0.94, 1];" \n "    _subtitle ctrlSetFontHeight 0.021;" \n "    _subtitle ctrlCommit 0;" \n "" \n "    private _boardFrame = _display ctrlCreate [""RscText"", -1];" \n "    _boardFrame ctrlSetPosition [0.030, 0.115, 0.836, 0.836];" \n "    _boardFrame ctrlSetBackgroundColor [0.26, 0.28, 0.31, 1];" \n "    _boardFrame ctrlCommit 0;" \n "    private _side = [_table] call PGS_fnc_getChessPlayerSideLocal;" \n "    private _squareControls = [];" \n "    private _pieceControls = [];" \n "    for ""_visualRow"" from 0 to 7 do {" \n "        for ""_visualColumn"" from 0 to 7 do {" \n "            private _logicalRow = if (_side < 0) then {7 - _visualRow} else {_visualRow};" \n "            private _logicalColumn = if (_side < 0) then {7 - _visualColumn} else {_visualColumn};" \n "            private _index = (_logicalRow * 8) + _logicalColumn;" \n "            private _squareX = 0.034 + (_visualColumn * 0.1035);" \n "            private _squareY = 0.119 + (_visualRow * 0.1035);" \n "            private _square = _display ctrlCreate [""RscButton"", -1];" \n "            _square ctrlSetPosition [_squareX, _squareY, 0.1015, 0.1015];" \n "            _square ctrlSetText """";" \n "            _square setVariable [""PGS_ChessSquareIndex"", _index];" \n "            _square ctrlAddEventHandler [" \n "                ""ButtonClick""," \n "                {" \n "                    params [""_control""];" \n "                    [_control] call PGS_fnc_handleChessSquareClickLocal;" \n "                }" \n "            ];" \n "            _square ctrlCommit 0;" \n "            _squareControls pushBack _square;" \n "            private _picture = _display ctrlCreate [""RscPictureKeepAspect"", -1];" \n "            _picture ctrlSetPosition [_squareX + 0.010, _squareY + 0.010, 0.0815, 0.0815];" \n "            _picture ctrlEnable false;" \n "            _picture ctrlShow false;" \n "            _picture ctrlCommit 0;" \n "            _pieceControls pushBack _picture;" \n "        };" \n "    };" \n "    _display setVariable [""PGS_ChessSquareControls"", _squareControls];" \n "    _display setVariable [""PGS_ChessPieceControls"", _pieceControls];" \n "" \n "    private _panel = _display ctrlCreate [""RscText"", -1];" \n "    _panel ctrlSetPosition [0.895, 0.115, 0.245, 0.836];" \n "    _panel ctrlSetBackgroundColor [0.025, 0.040, 0.060, 0.98];" \n "    _panel ctrlCommit 0;" \n "    private _whiteLabel = _display ctrlCreate [""RscText"", -1];" \n "    _whiteLabel ctrlSetPosition [0.915, 0.140, 0.205, 0.052];" \n "    _whiteLabel ctrlSetTextColor [0.20, 0.62, 1, 1];" \n "    _whiteLabel ctrlSetFontHeight 0.022;" \n "    _whiteLabel ctrlCommit 0;" \n "    private _versus = _display ctrlCreate [""RscText"", -1];" \n "    _versus ctrlSetPosition [0.915, 0.195, 0.205, 0.030];" \n "    _versus ctrlSetText ""VERSUS"";" \n "    _versus ctrlSetTextColor [0.62, 0.68, 0.74, 1];" \n "    _versus ctrlSetFontHeight 0.017;" \n "    _versus ctrlCommit 0;" \n "    private _blackLabel = _display ctrlCreate [""RscText"", -1];" \n "    _blackLabel ctrlSetPosition [0.915, 0.230, 0.205, 0.052];" \n "    _blackLabel ctrlSetTextColor [1, 0.28, 0.22, 1];" \n "    _blackLabel ctrlSetFontHeight 0.022;" \n "    _blackLabel ctrlCommit 0;" \n "    private _turnLabel = _display ctrlCreate [""RscText"", -1];" \n "    _turnLabel ctrlSetPosition [0.915, 0.305, 0.205, 0.055];" \n "    _turnLabel ctrlSetFontHeight 0.025;" \n "    _turnLabel ctrlCommit 0;" \n "    private _legendTitle = _display ctrlCreate [""RscText"", -1];" \n "    _legendTitle ctrlSetPosition [0.915, 0.385, 0.205, 0.035];" \n "    _legendTitle ctrlSetText ""COMMAND SYMBOLS"";" \n "    _legendTitle ctrlSetTextColor [0.80, 0.84, 0.88, 1];" \n "    _legendTitle ctrlSetFontHeight 0.019;" \n "    _legendTitle ctrlCommit 0;" \n "    private _legendOne = _display ctrlCreate [""RscText"", -1];" \n "    _legendOne ctrlSetPosition [0.915, 0.430, 0.205, 0.032];" \n "    _legendOne ctrlSetText ""INF Pawn   /   ARMOR Rook"";" \n "    _legendOne ctrlSetTextColor [0.68, 0.74, 0.80, 1];" \n "    _legendOne ctrlSetFontHeight 0.016;" \n "    _legendOne ctrlCommit 0;" \n "    private _legendTwo = _display ctrlCreate [""RscText"", -1];" \n "    _legendTwo ctrlSetPosition [0.915, 0.468, 0.205, 0.032];" \n "    _legendTwo ctrlSet