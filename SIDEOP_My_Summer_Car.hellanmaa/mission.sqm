\n "    }" \n "};" \n "" \n "PGS_fnc_pokerEvaluateBest = {" \n "    params [[""_cardsSource"", []]];" \n "    if ((typeName _cardsSource) != ""ARRAY"" || {(count _cardsSource) < 5}) exitWith {" \n "        [[-1, 0, 0, 0, 0, 0], [], ""No Hand""]" \n "    };" \n "    private _cards = +_cardsSource;" \n "    private _count = count _cards;" \n "    private _bestScore = [-1, 0, 0, 0, 0, 0];" \n "    private _bestFive = [];" \n "    for ""_a"" from 0 to (_count - 5) do {" \n "        for ""_b"" from (_a + 1) to (_count - 4) do {" \n "            for ""_c"" from (_b + 1) to (_count - 3) do {" \n "                for ""_d"" from (_c + 1) to (_count - 2) do {" \n "                    for ""_e"" from (_d + 1) to (_count - 1) do {" \n "                        private _five = [" \n "                            _cards param [_a, -1]," \n "                            _cards param [_b, -1]," \n "                            _cards param [_c, -1]," \n "                            _cards param [_d, -1]," \n "                            _cards param [_e, -1]" \n "                        ];" \n "                        private _score = [_five] call PGS_fnc_pokerEvaluateFive;" \n "                        if (([_score, _bestScore] call PGS_fnc_pokerCompareScores) > 0) then {" \n "                            _bestScore = _score;" \n "                            _bestFive = _five;" \n "                        };" \n "                    };" \n "                };" \n "            };" \n "        };" \n "    };" \n "    [_bestScore, _bestFive, [_bestScore] call PGS_fnc_pokerHandCategoryName]" \n "};" \n "" \n "PGS_fnc_pokerGetNextIndex = {" \n "    params [" \n "        [""_start"", -1]," \n "        [""_eligible"", []]" \n "    ];" \n "    private _count = count _eligible;" \n "    if (_count <= 0) exitWith {-1};" \n "    private _result = -1;" \n "    for ""_offset"" from 1 to _count do {" \n "        private _candidate = (_start + _offset) mod _count;" \n "        if (_result < 0 && {_eligible param [_candidate, false]}) then {" \n "            _result = _candidate;" \n "        };" \n "    };" \n "    _result" \n "};" \n "" \n "PGS_fnc_pokerBuildSidePots = {" \n "    params [" \n "        [""_contributions"", []]," \n "        [""_statuses"", []]" \n "    ];" \n "    private _levels = [];" \n "    {" \n "        if ((typeName _x) == ""SCALAR"" && {_x > 0}) then {" \n "            _levels pushBackUnique (floor _x);" \n "        };" \n "    } forEach _contributions;" \n "    _levels sort true;" \n "    private _pots = [];" \n "    private _previous = 0;" \n "    {" \n "        private _level = _x;" \n "        private _contributors = [];" \n "        private _eligible = [];" \n "        for ""_role"" from 0 to ((count _contributions) - 1) do {" \n "            if ((_contributions param [_role, 0]) >= _level) then {" \n "                _contributors pushBack _role;" \n "                if (!((_statuses param [_role, ""LEFT""]) in [""FOLDED"", ""LEFT""])) then {" \n "                    _eligible pushBack _role;" \n "                };" \n "            };" \n "        };" \n "        private _amount = (_level - _previous) * (count _contributors);" \n "        if (_amount > 0) then {" \n "            _pots pushBack [_amount, _eligible, _contributors];" \n "        };" \n "        _previous = _level;" \n "    } forEach _levels;" \n "    _pots" \n "}; " \n " " \n "PGS_fnc_unoIsCard = {" \n "    params [[""_card"", []]];" \n "    if ((typeName _card) != ""ARRAY"" || {(count _card) < 3}) exitWith {false};" \n "    private _id = _card param [0, -1];" \n "    private _colour = _card param [1, -1];" \n "    private _kind = _card param [2, -1];" \n "    (typeName _id) == ""SCALAR""" \n "        && {(typeName _colour) == ""SCALAR""}" \n "        && {(typeName _kind) == ""SCALAR""}" \n "        && {_id == floor _id}" \n "        && {_id >= 0}" \n "        && {_colour == floor _colour}" \n "        && {_colour >= 0}" \n "        && {_colour <= 4}" \n "        &&